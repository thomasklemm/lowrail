From 3be0ea49aeffec6706bac956b69a752d2f865300 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Fri, 6 Nov 2026 21:01:14 +0000
Subject: [PATCH 1/2] Engine: Trim a statement line after an ERB comment line
 in a block

Inside a block, a `<%# comment %>` line followed by a statement line
left the statement's indentation and newline in the output, unlike
Erubi:

    <% if a %>
      <%# a comment %>
      <% b = 1 %>
      hi
    <% end %>

rendered "  \n  hi\n" instead of "  hi\n".

Trimming the comment empties the indentation token before it, so
`at_line_start?` no longer saw a newline before the statement's
indentation. It now also accepts a newline that the previous trim
consumed, as `leading_space_follows_newline?` already does.
---
 lib/herb/engine/compiler.rb                                  | 2 +-
 test/engine/engine_erubi_compat_test.rb                      | 4 ++++
 ...ement_inside_a_block_4f69dc4a81a006d8375cca0e3e17c496.txt | 5 +++++
 3 files changed, 10 insertions(+), 1 deletion(-)
 create mode 100644 test/snapshots/engine/engine_erubi_compat_test/test_0057_trims_an_erb_comment_line_followed_by_a_statement_inside_a_block_4f69dc4a81a006d8375cca0e3e17c496.txt

diff --git a/lib/herb/engine/compiler.rb b/lib/herb/engine/compiler.rb
index 75240e64..831bc8da 100644
--- a/lib/herb/engine/compiler.rb
+++ b/lib/herb/engine/compiler.rb
@@ -752,7 +752,7 @@ module Herb
         last_value = @tokens.last[1]
 
         if last_type == :text
-          last_value.empty? || last_value.end_with?("\n") || (whitespace_only?(last_value) && preceding_token_ends_with_newline?) || trailing_indentation?(last_value)
+          last_value.empty? || last_value.end_with?("\n") || (whitespace_only?(last_value) && (preceding_token_ends_with_newline? || @last_trim_consumed_newline)) || trailing_indentation?(last_value)
         elsif EXPRESSION_TOKEN_TYPES.include?(last_type)
           @last_trim_consumed_newline
         else
diff --git a/test/engine/engine_erubi_compat_test.rb b/test/engine/engine_erubi_compat_test.rb
index 54e02c44..d765e25e 100644
--- a/test/engine/engine_erubi_compat_test.rb
+++ b/test/engine/engine_erubi_compat_test.rb
@@ -468,5 +468,9 @@ module Engine
       assert_compiled_snapshot(template)
       assert_evaluated_snapshot(template, { a: true }, enforce_erubi_equality: true)
     end
+
+    test "trims an erb comment line followed by a statement inside a block" do
+      assert_evaluated_snapshot("<% if a %>\n  <%# a comment %>\n  <% b = 1 %>\n  hi\n<% end %>\n", { a: true }, enforce_erubi_equality: true)
+    end
   end
 end

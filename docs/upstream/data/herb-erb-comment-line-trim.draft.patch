+++ b/test/snapshots/engine/engine_erubi_compat_test/test_0057_trims_an_erb_comment_line_followed_by_a_statement_inside_a_block_4f69dc4a81a006d8375cca0e3e17c496.txt
@@ -0,0 +1,5 @@

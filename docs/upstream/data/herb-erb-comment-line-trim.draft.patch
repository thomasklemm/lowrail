From b0bc44dabf93470d2fda9b9ed6ce5021022c26cf Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Fri, 6 Nov 2026 21:02:54 +0000
Subject: [PATCH 2/2] Engine: Trim a line that only holds a Ruby comment like
 Erubi

Erubi treats `<% # comment %>` as a statement and, with trim, drops a
line that only holds it. Herb skipped the tag entirely, so its line's
indentation and newline stayed in the output:

    <p>
      <% # a comment %>
      hi
    </p>

rendered "<p>\n  \n  hi\n</p>\n" instead of "<p>\n  hi\n</p>\n".

Such a tag that ends its line now goes through the `<%#` comment path,
which trims the line and keeps the line count. A Ruby comment that is
followed by more on its line, or that follows a statement on the same
line, still emits nothing, so line numbers stay where they were. Erubi
can't compile those cases, because the comment hides the rest of the
line.
---
 lib/herb/engine/compiler.rb                   | 25 ++++++++++++++++---
 sig/herb/engine/compiler.rbs                  |  7 +++++-
 test/engine/engine_erubi_compat_test.rb       |  4 +++
 ...mment_944d46086deefbf0c508ed508ce06786.txt |  7 ++++++
 ...ntent_fe61d9bee5fc47e3ae2a25deab93660c.txt |  1 -
 ...ation_2b3c4e3c244db77468813a7472298e82.txt |  4 +--
 6 files changed, 41 insertions(+), 7 deletions(-)
 create mode 100644 test/snapshots/engine/engine_erubi_compat_test/test_0058_trims_a_line_that_only_holds_a_ruby_comment_944d46086deefbf0c508ed508ce06786.txt

diff --git a/lib/herb/engine/compiler.rb b/lib/herb/engine/compiler.rb
index 831bc8da..ca7f447d 100644
--- a/lib/herb/engine/compiler.rb
+++ b/lib/herb/engine/compiler.rb
@@ -228,8 +228,19 @@ module Herb
         add_text(node.tag_closing.value)
       end
 
+      def visit_all(nodes)
+        nodes.each_with_index do |node, index|
+          @next_sibling = [node, nodes[index + 1]]
+          node&.accept(self)
+        end
+      end
+
       def visit_erb_content_node(node)
-        return if inline_ruby_comment?(node)
+        if inline_ruby_comment?(node)
+          process_erb_tag(node, omitted: true) if comment_line?(node)
+
+          return
+        end
 
         process_erb_tag(node)
       end
@@ -476,12 +487,12 @@ module Herb
         @current_element_source = previous_element_source
       end
 
-      def process_erb_tag(node, skip_comment_check: false)
+      def process_erb_tag(node, skip_comment_check: false, omitted: false)
         opening = node.tag_opening.value
 
         return add_escaped_erb_tag(node) if erb_escaped?(opening)
 
-        if !skip_comment_check && erb_omitted?(opening)
+        if omitted || (!skip_comment_check && erb_omitted?(opening))
           unless @trim
             keep_span_line_count(node)
 
@@ -771,6 +782,14 @@ module Herb
         preceding[1].end_with?("\n")
       end
 
+      # A `<% # comment %>` that ends its line trims like `<%#`, as in Erubi; elsewhere it still emits nothing.
+      def comment_line?(node)
+        return false if erb_output?(node.tag_opening.value) || follows_trimmed_statement_tag?(node)
+
+        current, following = @next_sibling
+        current.equal?(node) && following.is_a?(Herb::AST::HTMLTextNode) && following.content.match?(/\A[ \t]*\r?\n/)
+      end
+
       def left_trim?(node)
         node.tag_opening&.value == "<%-"
       end
diff --git a/sig/herb/engine/compiler.rbs b/sig/herb/engine/compiler.rbs
index 5e54e9db..b93d20a5 100644
--- a/sig/herb/engine/compiler.rbs
+++ b/sig/herb/engine/compiler.rbs
@@ -61,6 +61,8 @@ module Herb
 
       def visit_cdata_node: (untyped node) -> untyped
 
+      def visit_all: (untyped nodes) -> untyped
+
       def visit_erb_content_node: (untyped node) -> untyped
 
       def visit_erb_comment_node: (untyped node) -> untyped
@@ -126,7 +128,7 @@ module Herb
       # : (untyped node) { (String?) -> untyped } -> untyped
       def with_element_context: (untyped node) { (String?) -> untyped } -> untyped
 
-      def process_erb_tag: (untyped node, ?skip_comment_check: untyped) -> untyped
+      def process_erb_tag: (untyped node, ?skip_comment_check: untyped, ?omitted: untyped) -> untyped
 
       # : (untyped, ?extra: Integer) -> void
       def keep_span_line_count: (untyped, ?extra: Integer) -> void
@@ -176,6 +178,9 @@ module Herb
 
       def preceding_token_ends_with_newline?: () -> untyped
 
+      # A `<% # comment %>` that ends its line trims like `<%#`, as in Erubi; elsewhere it still emits nothing.
+      def comment_line?: (untyped node) -> untyped
+
       def left_trim?: (untyped node) -> untyped
 
       def right_trim?: (untyped node) -> untyped

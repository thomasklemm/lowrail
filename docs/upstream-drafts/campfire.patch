diff --git a/test/integration/content_security_policy_test.rb b/test/integration/content_security_policy_test.rb
index 7a3aaf6..22673e0 100644
--- a/test/integration/content_security_policy_test.rb
+++ b/test/integration/content_security_policy_test.rb
@@ -5,6 +5,42 @@ class ContentSecurityPolicyTest < ActionDispatch::IntegrationTest
 
   setup { sign_in :david }
 
+  test "warm pages reuse resolved CSP locations" do
+    get root_url
+    follow_redirect! while response.redirect?
+    path, policy = request.path, response.headers["Content-Security-Policy"]
+    joins = 0
+    trace = TracePoint.new(:call) do |event|
+      joins += 1 if event.defined_class == URI.singleton_class && event.method_id == :join
+    end
+
+    trace.enable { get path }
+
+    assert_response :success
+    assert_equal policy, response.headers["Content-Security-Policy"]
+    assert_equal 0, joins, "a warm page must not parse every import URL again"
+  end
+
+  test "a same-length importmap change updates CSP locations" do
+    cookies.delete(:session_token)
+    map = Rails.application.importmap
+    begin
+      map.pin "csp-cache-control", to: "https://one.example.test/probe.js"
+      get new_session_url
+      assert_response :success
+      assert_includes response.headers["Content-Security-Policy"], "https://one.example.test/probe.js"
+
+      map.pin "csp-cache-control", to: "https://two.example.test/probe.js"
+      get new_session_url
+      assert_response :success
+      assert_includes response.headers["Content-Security-Policy"], "https://two.example.test/probe.js"
+      assert_not_includes response.headers["Content-Security-Policy"], "https://one.example.test/probe.js"
+    ensure
+      map.packages.delete("csp-cache-control")
+      map.send(:clear_cache)
+    end
+  end
+
   test "enforcing policy allows exactly the inline scripts the page carries" do
     get root_url
     follow_redirect! while response.redirect?

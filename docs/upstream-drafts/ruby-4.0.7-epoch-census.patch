diff -ruN a/epoch_census.inc b/epoch_census.inc
--- a/epoch_census.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/epoch_census.inc	2026-10-21 11:20:29.521044600 +0000
@@ -0,0 +1,80 @@
+/* Diagnostic build only: one pinned stack per VM seam and holder kind.
+ * Capture frames without allocation or invoking application callbacks.
+ * Single-main-Ractor census, not a public API or performance build. */
+#include "ruby/debug.h"
+static bool epoch_census_active;
+static unsigned long epoch_non_singleton;
+static struct {
+    const char *source;
+    bool singleton;
+    unsigned long count;
+    int depth;
+    VALUE frames[12];
+    int lines[12];
+} epoch_samples[64];
+
+void
+rb_vm_mutation_epoch_bump_at(const char *source, VALUE holder)
+{
+    rb_vm_mutation_epoch_bump();
+    bool singleton = !NIL_P(holder) && RCLASS_SINGLETON_P(holder);
+    if (!singleton) epoch_non_singleton++;
+    if (!epoch_census_active) return;
+    for (int i = 0; i < 64; i++) {
+        if (!epoch_samples[i].source) {
+            epoch_samples[i].source = source;
+            epoch_samples[i].singleton = singleton;
+        }
+        if (epoch_samples[i].source == source && epoch_samples[i].singleton == singleton) {
+            if (!epoch_samples[i].count++) {
+                epoch_samples[i].depth = rb_profile_frames(0, 12, epoch_samples[i].frames, epoch_samples[i].lines);
+            }
+            return;
+        }
+    }
+    rb_bug("epoch census table full");
+}
+
+static VALUE
+vm_epoch_census_start(VALUE self)
+{
+    epoch_census_active = false;
+    memset(epoch_samples, 0, sizeof(epoch_samples));
+    epoch_census_active = true;
+    return Qnil;
+}
+
+static VALUE
+vm_epoch_census_stop(VALUE self)
+{
+    epoch_census_active = false;
+    VALUE result = rb_ary_new();
+    for (int i = 0; i < 64 && epoch_samples[i].source; i++) {
+        VALUE stack = rb_ary_new();
+        for (int j = 0; j < epoch_samples[i].depth; j++) {
+            VALUE frame = epoch_samples[i].frames[j];
+            rb_ary_push(stack, rb_ary_new_from_args(3, rb_profile_frame_absolute_path(frame),
+                INT2NUM(epoch_samples[i].lines[j]), rb_profile_frame_full_label(frame)));
+        }
+        rb_ary_push(result, rb_ary_new_from_args(4, rb_str_new_cstr(epoch_samples[i].source),
+            RBOOL(epoch_samples[i].singleton), ULONG2NUM(epoch_samples[i].count), stack));
+    }
+    return result;
+}
+
+static VALUE
+vm_epoch_non_singleton(VALUE self)
+{
+    return ULONG2NUM(epoch_non_singleton);
+}
+
+static void
+Init_epoch_census(void)
+{
+    for (int i = 0; i < 64; i++) {
+        for (int j = 0; j < 12; j++) rb_global_variable(&epoch_samples[i].frames[j]);
+    }
+    rb_define_singleton_method(rb_cRubyVM, "epoch_census_start", vm_epoch_census_start, 0);
+    rb_define_singleton_method(rb_cRubyVM, "epoch_census_stop", vm_epoch_census_stop, 0);
+    rb_define_singleton_method(rb_cRubyVM, "non_singleton_epoch", vm_epoch_non_singleton, 0);
+}

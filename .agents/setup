#!/usr/bin/env bash
# Tooling only: corpus downloads and disposable services remain opt-in.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
packages=(build-essential libclang-dev libyaml-dev libssl-dev libreadline-dev
  zlib1g-dev libffi-dev libsqlite3-dev libpq-dev postgresql libvips-dev valgrind)
missing=()
for package in "${packages[@]}"; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || missing+=("$package")
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi
if [ ! -x "$HOME/.local/bin/mise" ]; then
  curl -fsSL https://mise.run | sh
fi
"$HOME/.local/bin/mise" install ruby@4.0.7
# Cache the fork only on explicit opt-in; stock Ruby stays the default PATH.
if [[ ${LOWRAIL_TOKEN_RUBY:-0} == 1 ]]; then "$root/script/token-ruby"; fi
ruby_bin="$("$HOME/.local/bin/mise" where ruby@4.0.7)/bin"
export PATH="$ruby_bin:$HOME/.cargo/bin:$PATH"
if [ ! -x "$HOME/.cargo/bin/cargo" ]; then
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal
fi
if ! gem list --installed --exact stackprof --version 0.2.28 >/dev/null; then
  gem install stackprof --version 0.2.28 --no-document
fi
ruby -rrubygems/dependency_installer - "$root/gem/lowrail.gemspec" <<'RUBY'
Gem::Specification.load(ARGV.fetch(0)).development_dependencies.each do |dependency|
  next if Gem::Specification.find_all_by_name(dependency.name, dependency.requirement).any?
  Gem::DependencyInstaller.new(document: []).install(dependency.name, dependency.requirement)
end
RUBY
cargo fetch --locked --manifest-path "$root/Cargo.toml"
# Amp and services start in new login shells, not this setup process.
marker='# Lowrail orb toolchain'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\ncase "$PWD" in\n  %q|%q/*) export PATH=%q:"$HOME/.cargo/bin:$PATH" ;;\nesac\n' \
    "$marker" "$root" "$root" "$ruby_bin" >> "$HOME/.bash_profile"
fi
echo 'Lowrail tools ready; use script/corpus APP for app dependencies.'

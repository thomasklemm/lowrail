 class RecurringTransactionRule < ApplicationRecord
+  # Lowrail census compat: Rails main 7249a66350 calls owner.method(:read_attr) on every
+  # association read, which this model's `method` attribute shadows.
+  def method(*args) = args.empty? ? super() : Kernel.instance_method(:method).bind_call(self, *args)
+

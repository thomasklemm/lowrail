diff --git a/config/initializers/census_blind_index.rb b/config/initializers/census_blind_index.rb
new file mode 100644
index 0000000..4f8108e
--- /dev/null
+++ b/config/initializers/census_blind_index.rb
@@ -0,0 +1,6 @@
+# census: Rails main's PredicateBuilder makes its TableMetadata Ractor-shareable,
+# so it is frozen (3ba8970f4a), and blind_index 2.8.1 memoizes this answer in an
+# instance variable on it. Answer it without memoizing.
+ActiveSupport.on_load(:active_record) do
+  ActiveRecord::TableMetadata.prepend(Module.new { def has_blind_indexes? = klass.respond_to?(:blind_indexes) })
+end

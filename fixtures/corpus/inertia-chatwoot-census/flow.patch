+# census: Rails main (ac98c112f4) freezes ActionDispatch::Request.parameter_parsers,
+# and scimitar 2.15 adds its SCIM parser in place while its engine loads. Load it
+# against an unfrozen copy, then assign through the setter, which freezes again.
+ActionDispatch::Request.instance_variable_set(:@parameter_parsers, ActionDispatch::Request.parameter_parsers.dup)
+require "scimitar"
+ActionDispatch::Request.parameter_parsers = ActionDispatch::Request.parameter_parsers
 

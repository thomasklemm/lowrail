{
  "format": 1,
  "scope": "Fizzy authenticated buckets GET /, disposable public fixtures, production YJIT. Declared from fresh-process A/A before patch screening. Only the permanent session_token cookie's expiry timestamp is exempted; no page timestamps, SQL or other HTML/header exemptions. SKIP_TELEMETRY=1 symmetrically disables the app's external error reporting.",
  "body": [
    {
      "name": "one Rails CSRF meta token value",
      "pattern": "(<meta name=\"csrf-token\" content=\")[A-Za-z0-9_-]{86}(\" />)",
      "replacement": "\\1<csrf-token>\\2",
      "count": 1
    },
    {
      "name": "two Rails form authenticity token values",
      "pattern": "(<input type=\"hidden\" name=\"authenticity_token\" value=\")[A-Za-z0-9_-]{86}(\" autocomplete=\"off\" />)",
      "replacement": "\\1<csrf-token>\\2",
      "count": 2
    }
  ],
  "headers": {
    "x-request-id": {
      "name": "ActionDispatch generated request UUID",
      "pattern": "\\A[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\z",
      "replacement": "<request-id>",
      "count": 1
    },
    "x-runtime": {
      "name": "Rack request runtime",
      "pattern": "\\A[0-9]+\\.[0-9]{6}\\z",
      "replacement": "<runtime>",
      "count": 1
    },
    "etag": {
      "name": "Rack weak response ETag (controlled body still compared)",
      "pattern": "\\AW/\"[0-9a-f]{32}\"\\z",
      "replacement": "<etag>",
      "count": 1
    },
    "set-cookie": [
      {
        "name": "signed session_token value only",
        "pattern": "(\\Asession_token=)[^;\\r\\n]+",
        "replacement": "\\1<session>",
        "count": 1
      },
      {
        "name": "encrypted _fizzy_session value only",
        "pattern": "(\\A_fizzy_session=)[^;\\r\\n]+",
        "replacement": "\\1<session>",
        "count": 1
      },
      {
        "name": "permanent session_token expiry (all other attributes retained)",
        "pattern": "(\\Asession_token=<session>; path=/; expires=)[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT",
        "replacement": "\\1<expiry>",
        "count": 1
      }
    ]
  }
}

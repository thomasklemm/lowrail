#!/usr/bin/env bash
# Fetch a pinned corpus app into .corpus/<name> (not checked in) and install
# its bundle. Usage: script/corpus APP [DIRNAME]
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
name=${1:?app name}
dest="$root/.corpus/${2:-$name}"
mkdir -p "$root/.corpus"
ruby_version=4.0.7
mise=$(command -v mise || true)
mise=${mise:-$HOME/.local/bin/mise}
"$mise" install "ruby@$ruby_version"
export PATH="$("$mise" where "ruby@$ruby_version")/bin:$PATH"
case "$name" in
  real-blog)
    # rubys/roundhouse fixtures/real-blog, Rails 8.1.4
    rev=bb90df2514f80817f98d89848dd0a6baa8df20a9  # generated by scripts/create-blog
    repo=https://github.com/rubys/roundhouse
    sub=fixtures/real-blog ;;
  campfire)
    # main on 2026-10-19; its lockfile pins Rails 8.2.0.alpha.
    rev=af4dd9fd599c65e0e0fc1f614ee469f70156ddf5
    repo=https://github.com/basecamp/once-campfire
    sub=. ;;
  pingcrm)
    # Public Inertia apps, main/HEAD on 2026-10-20. See docs/m0/inertia.md.
    rev=22464f822dcf59c4425993dd623780ad44497fda
    repo=https://github.com/ledermann/pingcrm
    sub=. ;;
  redprints-cfp)
    rev=6080fc24fbf0015f7e5a5ae932e903731502c65a
    repo=https://github.com/evilmartians/redprints-cfp
    sub=. ;;
  react-starter-kit)
    rev=f8081935e9bda68f8ef1ec53dc7eed19c819ee68
    repo=https://github.com/inertia-rails/react-starter-kit
    sub=. ;;
  casa)
    # Rails 8.1.4 dependency-only overlays; see docs/compat.md.
    rev=b584d2e6e6ebffe382f34c2ec202d20384d035ca
    repo=https://github.com/rubyforgood/casa
    sub=. ;;
  writebook)
    rev=be1f8fcf1b0fc8064011c2d29d75133885b182e2
    repo=https://github.com/basecamp/writebook
    sub=. ;;
  fizzy)
    # Last selected public historical pin; newer snapshots need private gems.
    rev=6f1d200316ec3bae91d32c557d88647300807ee9
    repo=https://github.com/basecamp/fizzy
    sub=. ;;
  codetriage)
    # Use a fresh schema-only database; development seeds break test fixtures.
    rev=d1868f8634e97a111a7fca49d58cc776d206007e
    repo=https://github.com/codetriage/codetriage
    sub=. ;;
  *) echo "unknown corpus app: $name" >&2; exit 2 ;;
esac
if [ ! -d "$dest" ]; then
  tmp=$(mktemp -d)
  git -C "$tmp" init -q
  git -C "$tmp" fetch -q --depth 1 "$repo" "$rev"
  git -C "$tmp" -c advice.detachedHead=false checkout -q FETCH_HEAD
  if [ "$name" = real-blog ]; then
    # real-blog is generated, not checked in: Roundhouse's create-blog runs
    # `rails new` plus scaffolds against the pinned Rails version.
    RAILS_NEW_VERSION=8.1.4 "$tmp/scripts/create-blog" "$dest" >/dev/null
    (cd "$dest" && bin/rails db:prepare >/dev/null)
  else
    cp -r "$tmp/$sub" "$dest"
  fi
  rm -rf "$tmp"
  echo "$repo@$rev:$sub" > "$dest/.lowrail-corpus-source"
fi
if [ "$name" != real-blog ]; then
  [ "$(git -C "$dest" rev-parse HEAD)" = "$rev" ] || {
    echo "$name checkout is not the pinned revision; use a new DIRNAME" >&2
    exit 1
  }
  (
    cd "$dest"
    patch="$root/fixtures/corpus/$name.patch"
    if [ -f "$patch" ]; then
      if git apply --check "$patch" 2>/dev/null; then
        git apply "$patch"
      elif ! git apply --reverse --check "$patch" 2>/dev/null; then
        echo "$name dependency metadata differs; use a new DIRNAME" >&2
        exit 1
      fi
    fi
    BUNDLE_FROZEN=true bundle install --quiet
    case "$name" in
      casa)
        node_version=24.22.0
        "$mise" install "node@$node_version"
        export PATH="$("$mise" where "node@$node_version")/bin:$PATH"
        npm ci --no-audit --no-fund
        npm run build
        npm run build:css ;;
      codetriage)
        [ -f config/database.yml ] || cp config/database.ci.yml config/database.yml ;;
    esac
    case "$name" in
      casa|codetriage|writebook|fizzy)
        # Upstream CI loads the schema, not development seeds (which send
        # mail/geocode). Only load it on a new disposable test database.
        RAILS_ENV=test bundle exec rails db:create db:test:prepare
        RAILS_ENV=test bundle exec rails assets:precompile
        exit 0 ;;
    esac
    RAILS_ENV=test bundle exec rails db:prepare
    case "$name" in
      pingcrm|redprints-cfp) bun install --frozen-lockfile ;;
      react-starter-kit) npm ci --no-audit --no-fund ;;
    esac
    RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bundle exec rails db:prepare assets:precompile
    if [ "$name" = react-starter-kit ]; then
      RAILS_ENV=production npx vite build --ssr
    fi
  )
else
  (cd "$dest" && bundle install --quiet)
fi
echo "$dest"

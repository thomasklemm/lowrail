#!/usr/bin/env bash
# Fetch a pinned corpus app into .corpus/<name> (not checked in) and install
# its bundle. Usage: script/corpus APP [DIRNAME] [--source-only|--casa-production-boot-fixture]
# --source-only fetches the exact source and dependency overlay, without
# installing its bundle, preparing databases or building assets. --no-overlay
# skips fixtures/corpus/APP.patch (script/census applies its own). The generated
# blog must already exist: its ordinary generator itself prepares a database.
# --casa-production-boot-fixture uses external throwaway credentials and loads
# only the schema into an explicitly supplied empty local disposable database.
# This is a boot fixture, not the app's credentials. See docs/helper-discovery.md.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
name=${1:?app name}
shift
dirname=$name
source_only=false
casa_boot_fixture=false
overlay=true
for arg in "$@"; do
  case "$arg" in
    --source-only) source_only=true ;;
    --casa-production-boot-fixture) casa_boot_fixture=true ;;
    --no-overlay) overlay=false ;;
    --*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) dirname=$arg ;;
  esac
done
if "$casa_boot_fixture"; then
  if [ "$name" != casa ] || "$source_only"; then
    echo "--casa-production-boot-fixture requires casa and cannot combine with --source-only" >&2
    exit 2
  fi
  : "${LOWRAIL_CORPUS_DATABASE_URL:?supply an empty local lowrail_corpus_casa_* database; see docs/helper-discovery.md}"
fi
dest="$root/.corpus/$dirname"
mkdir -p "$root/.corpus"
# Census pin; script/gate passes the lowering prototype's 4.0.7.
ruby_version=${LOWRAIL_CORPUS_RUBY:-4.0.9}
mise=$(command -v mise || true)
mise=${mise:-$HOME/.local/bin/mise}
"$mise" install "ruby@$ruby_version"
export PATH="$("$mise" where "ruby@$ruby_version")/bin:$PATH"
case "$name" in
  real-blog-r4)
    # The entropy certificate names retained bytes, not a new rails generator
    # run (migration timestamps and the app name alone change its source pin).
    archive="$root/fixtures/corpus/real-blog-r4-retained.tgz"
    echo "b1dd980b6689bf2b3912691e527d74e0b7699fb32cb53169791c24879f0c0a99  $archive" | sha256sum --check --status
    if [ ! -d "$dest" ]; then
      mkdir -p "$dest"
      tar -xzf "$archive" -C "$dest" --strip-components=1 real-blog-r4
    fi
    ruby -r"$root/fixtures/corpus/blog_entropy" - "$dest" <<'RUBY'
app = ARGV.fetch(0)
policy = JSON.parse(File.read(BlogProduction::Entropy::POLICY))
unless BlogProduction::Entropy.source_pin(app) == policy.fetch("app_source_sha256") &&
    Digest::SHA256.file(File.join(app, "Gemfile.lock")).hexdigest == policy.fetch("lock_sha256")
  abort "retained blog source/lock mismatch; preserve this directory and use a new DIRNAME"
end
RUBY
    if ! "$source_only"; then
      (
        cd "$dest"
        BUNDLE_FROZEN=true bundle install --quiet
        RAILS_ENV=test BUNDLE_FROZEN=true bin/rails db:prepare
        BUNDLE_FROZEN=true bundle exec ruby -r"$root/fixtures/corpus/blog_entropy" -e '
          control = BlogProduction::Entropy.validate(Dir.pwd)
          abort control.fetch("reason") unless control.fetch("active")
        '
      )
    fi
    echo "$dest"
    exit 0 ;;
  real-blog)
    # rubys/roundhouse fixtures/real-blog, Rails 8.1.4
    rev=bb90df2514f80817f98d89848dd0a6baa8df20a9  # generated by scripts/create-blog
    repo=https://github.com/rubys/roundhouse
    sub=fixtures/real-blog ;;
  campfire)
    # main on 2026-10-19; its lockfile pins Rails 8.2.0.alpha.
    rev=af4dd9fd599c65e0e0fc1f614ee469f70156ddf5
    repo=https://github.com/basecamp/once-campfire
    sub=. ;;
  campfire-r81)
    # Newest pre-8.2-defaults source; separate fixture, never patch app config.
    # Dependency-only Ruby 4.0.7 / Rails 8.1.4 overlay: docs/campfire-bench.md.
    rev=02023b0f0cafc4d66e06e43be072cf4d6ca328fa
    repo=https://github.com/basecamp/once-campfire
    sub=. ;;
  campfire-r82)
    # Separate alpha track: common exact Rails main pin, docs/rails-8.2.md.
    rev=af4dd9fd599c65e0e0fc1f614ee469f70156ddf5
    repo=https://github.com/basecamp/once-campfire
    sub=. ;;
  fizzy-r82)
    # Public OSS main on 2026-10-21 already locks Rails 8.2 alpha.
    rev=77eada1c8ead75c39f7fda5c80f322bcf5a9adb5
    repo=https://github.com/basecamp/fizzy
    sub=. ;;
  writebook-r82)
    # Public main on 2026-10-21 already locks Rails 8.2 alpha.
    rev=7478e2c7b109e688a6fa4745bac123e72b5cef84
    repo=https://github.com/basecamp/writebook
    sub=. ;;
  pingcrm)
    # Public Inertia apps, main/HEAD on 2026-10-20. See docs/m0/inertia.md.
    rev=22464f822dcf59c4425993dd623780ad44497fda
    repo=https://github.com/ledermann/pingcrm
    sub=. ;;
  redprints-cfp)
    rev=6080fc24fbf0015f7e5a5ae932e903731502c65a
    repo=https://github.com/evilmartians/redprints-cfp
    sub=. ;;
  react-starter-kit)
    rev=f8081935e9bda68f8ef1ec53dc7eed19c819ee68
    repo=https://github.com/inertia-rails/react-starter-kit
    sub=. ;;
  casa)
    # Rails 8.1.4 dependency-only overlays; see docs/compat.md.
    rev=b584d2e6e6ebffe382f34c2ec202d20384d035ca
    repo=https://github.com/rubyforgood/casa
    sub=. ;;
  writebook)
    rev=be1f8fcf1b0fc8064011c2d29d75133885b182e2
    repo=https://github.com/basecamp/writebook
    sub=. ;;
  fizzy)
    # Last selected public historical pin; newer snapshots need private gems.
    rev=6f1d200316ec3bae91d32c557d88647300807ee9
    repo=https://github.com/basecamp/fizzy
    sub=. ;;
  codetriage)
    # Use a fresh schema-only database; development seeds break test fixtures.
    rev=d1868f8634e97a111a7fca49d58cc776d206007e
    repo=https://github.com/codetriage/codetriage
    sub=. ;;
  lobsters)
    # main on 2026-11-01 (census 4); script/census copies database.yml.sample.
    rev=366e21167521eccd4c10a125cff45142c237275d
    repo=https://github.com/lobsters/lobsters
    sub=. ;;
  # PostgreSQL census apps (docs/upstream/pg-census.md), main/master on
  # 2026-11-02. script/census applies fixtures/corpus/pg-census/APP.patch.
  docuseal)
    rev=6c416dd76e10a44a6440a77d144819199687a06b
    repo=https://github.com/docusealco/docuseal
    sub=. ;;
  mastodon)
    rev=5ccbf0e488801f9b7ee5fbe9d915f861081fa3ca
    repo=https://github.com/mastodon/mastodon
    sub=. ;;
  lago)
    rev=b0007bfe75ec5718ac86479c7c3b4fd61e05599e
    repo=https://github.com/getlago/lago-api
    sub=. ;;
  discourse)
    rev=0f52471898e650ab05805b6913edccab114f72b2
    repo=https://github.com/discourse/discourse
    sub=. ;;
  loomio)
    rev=407d4a8a214f7eddf605c182ea880cbbc4448cd1
    repo=https://github.com/loomio/loomio
    sub=. ;;
  sure)
    # The maintained fork of maybe-finance/maybe (archived 2025-07).
    rev=8d0d84de9377e7e9deb64a6ffd145be9a91462b4
    repo=https://github.com/we-promise/sure
    sub=. ;;
  # Chatwoot and Inertia census apps (docs/upstream/inertia-chatwoot-census.md),
  # default branches on 2026-11-03. script/census applies
  # fixtures/corpus/inertia-chatwoot-census/APP.patch.
  chatwoot)
    rev=ae66c979835f7e49e1cf9ecb64eb89628e8f3f70  # develop
    repo=https://github.com/chatwoot/chatwoot
    sub=. ;;
  hackatime)
    rev=74deec42b2556f96ee25116e161fc1581bd72f27
    repo=https://github.com/hackclub/hackatime
    sub=. ;;
  flow)
    rev=6a8b5fda6100010688b6a8edfa79133dc6c359c4  # develop
    repo=https://github.com/AixleHQ/flow
    sub=. ;;
  thinkroom)
    rev=f7865d012245e8efd7b75206e06488c05d598744
    repo=https://github.com/kieranklaassen/thinkroom
    sub=. ;;
  wikino)
    # Rails app lives in rails/; dependency-only wrapper in fixtures/corpus.
    rev=25255d2d6c808df6672e293661ea797a76c6d2a9
    repo=https://github.com/wikinoapp/wikino
    sub=. ;;
  *) echo "unknown corpus app: $name" >&2; exit 2 ;;
esac
if "$source_only" && [ "$name" = real-blog ] && [ ! -d "$dest" ]; then
  echo "generated_blog_requires_prepared_source: run script/corpus real-blog $dirname without --source-only first" >&2
  exit 2
fi
if [ ! -d "$dest" ]; then
  tmp=$(mktemp -d)
  git -C "$tmp" init -q
  git -C "$tmp" fetch -q --depth 1 "$repo" "$rev"
  git -C "$tmp" -c advice.detachedHead=false checkout -q FETCH_HEAD
  if [ "$name" = real-blog ]; then
    # real-blog is generated, not checked in: Roundhouse's create-blog runs
    # `rails new` plus scaffolds against the pinned Rails version.
    RAILS_NEW_VERSION=8.1.4 "$tmp/scripts/create-blog" "$dest" >/dev/null
    if ! "$source_only"; then
      (cd "$dest" && bin/rails db:prepare >/dev/null)
    fi
  else
    cp -r "$tmp/$sub" "$dest"
  fi
  rm -rf "$tmp"
  echo "$repo@$rev:$sub" > "$dest/.lowrail-corpus-source"
fi
if [ "$name" != real-blog ]; then
  [ "$(git -C "$dest" rev-parse HEAD)" = "$rev" ] || {
    echo "$name checkout is not the pinned revision; use a new DIRNAME" >&2
    exit 1
  }
  if [ "$name" = chatwoot ] && [ ! -f "$dest/vendor/commonmarker/lib/commonmarker/commonmarker.so" ]; then
    # commonmarker 0.23.12 (Chatwoot's markdown API) declares ruby < 4.0. The
    # census overlay uses its v0.23.12 tag as a path gem with only that cap
    # lifted; Bundler does not compile path gems, so build the extension here.
    cm="$dest/vendor/commonmarker"
    rm -rf "$cm"
    git -c advice.detachedHead=false clone -q --depth 1 -b v0.23.12 https://github.com/gjtorikian/commonmarker "$cm"
    [ "$(git -C "$cm" rev-parse HEAD)" = cd435f7bb1a2c53e9ca3bb95b389c7d777083921 ] || { echo "commonmarker tag moved" >&2; exit 1; }
    rm -rf "$cm/.git"
    sed -i 's/s.required_ruby_version = \[">= 2.6", "< 4.0"\]/s.required_ruby_version = ">= 2.6"/' "$cm/commonmarker.gemspec"
    (cd "$cm/ext/commonmarker" && ruby extconf.rb >/dev/null && make -s -j"$(nproc)" >/dev/null && cp commonmarker.so ../../lib/commonmarker/)
  fi
  (
    cd "$dest"
    patch="$root/fixtures/corpus/$name.patch"
    if "$overlay" && [ -f "$patch" ]; then
      if git apply --check "$patch" 2>/dev/null; then
        git apply "$patch"
      elif ! git apply --reverse --check "$patch" 2>/dev/null; then
        echo "$name dependency metadata differs; use a new DIRNAME" >&2
        exit 1
      fi
    fi
    if "$source_only"; then
      exit 0
    fi
    if [ "$name" = wikino ]; then
      [ "$dirname" = wikino ] || { echo "Wikino's frozen wrapper requires the default dirname" >&2; exit 2; }
      export BUNDLE_GEMFILE="$root/fixtures/corpus/wikino.Gemfile"
      cd rails
    fi
    BUNDLE_FROZEN=true bundle install --quiet
    if "$casa_boot_fixture"; then
      env -u RUBYOPT -u RAILS_MASTER_KEY LOWRAIL=0 BUNDLE_FROZEN=true \
        RAILS_ENV=production RACK_ENV=production RUBY_YJIT_ENABLE=1 SECRET_KEY_BASE_DUMMY=1 \
        bundle exec ruby "$root/fixtures/corpus/casa_production_boot.rb"
      exit 0
    fi
    case "$name" in
      casa)
        node_version=24.22.0
        "$mise" install "node@$node_version"
        export PATH="$("$mise" where "node@$node_version")/bin:$PATH"
        npm ci --no-audit --no-fund
        npm run build
        npm run build:css ;;
      codetriage)
        [ -f config/database.yml ] || cp config/database.ci.yml config/database.yml ;;
    esac
    case "$name" in
      casa|codetriage|writebook|fizzy|campfire-r82|writebook-r82|fizzy-r82)
        # Upstream CI loads the schema, not development seeds (which send
        # mail/geocode). Only load it on a new disposable test database.
        RAILS_ENV=test bundle exec rails db:create db:test:prepare
        RAILS_ENV=test bundle exec rails assets:precompile
        exit 0 ;;
    esac
    RAILS_ENV=test bundle exec rails db:prepare
    case "$name" in
      pingcrm|redprints-cfp) bun install --frozen-lockfile ;;
      react-starter-kit) npm ci --no-audit --no-fund ;;
    esac
    RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bundle exec rails db:prepare assets:precompile
    if [ "$name" = react-starter-kit ]; then
      RAILS_ENV=production npx vite build --ssr
    fi
  )
elif ! "$source_only"; then
  (cd "$dest" && bundle install --quiet)
fi
echo "$dest"

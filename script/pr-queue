#!/usr/bin/env ruby
# frozen_string_literal: true

# Upstream PR queue: one Markdown file per PR in bench/upstream/pr-queue/items, format and states in
# bench/upstream/pr-queue/README.md. Rules: docs/DECISIONS.md, "Submission queue" and "Review gates".
#
#   script/pr-queue status         every item by state and rank, with fork head, passes, mergeability and base drift
#   script/pr-queue next           the highest-ranked reviewed item whose repo has room
#   script/pr-queue open ID [--draft]
#   script/pr-queue ready ID       mark a draft ready for review (rails/rails: at most 15 non-draft)
#   script/pr-queue sync           pull draft/ready/merged/closed states from GitHub
#   script/pr-queue rebase ID [--push]  rebuild a branch with only CHANGELOG conflicts on its base; --push force-pushes

require "date"
require "json"
require "open3"
require "tempfile"
require "yaml"

module PrQueue
  ROOT = File.expand_path("..", __dir__)
  ITEMS = File.join(ROOT, "bench/upstream/pr-queue/items")
  CACHE = File.join(ROOT, ".lowrail/pr-queue")
  AUTHOR = "thomasklemm"
  STATES = %w[built in-review reviewed draft ready merged closed held superseded].freeze
  KINDS = %w[fix perf docs restore feature].freeze
  REVIEWERS = %w[skeptic claude-code sol astra thermos thermos-sol thermos-opus thermos-fable opus fable].freeze
  STAND_INS = { "sol" => %w[opus fable], "astra" => %w[opus fable] }.freeze # temporary, DECISIONS 2026-11-14
  # guard_review: true, a review of our own safety guards, which Sol's and Astra's cyber-safety checks stop
  # (DECISIONS 2026-11-25, "Reviews of our own safety guards go to Anthropic models").
  GUARD_STAND_INS = %w[thermos-opus thermos-fable].freeze
  # Thermos on Sol (or Opus for crash fixes) is the default review and a thermos review (DECISIONS 2026-11-18).
  # A Fable thermos pass counts where an Opus one does (DECISIONS 2026-11-25).
  THERMOS_REVIEWS = %w[thermos-sol thermos-opus thermos-fable].freeze
  ACCEPTS = { "claude-code" => %w[claude-code] + THERMOS_REVIEWS, "thermos" => %w[thermos] + THERMOS_REVIEWS }.freeze
  VERDICTS = %w[approve nits changes].freeze # approve and nits (no must-fix) count; changes doesn't
  THERMOS_LINES = 200
  # Our open PRs per repo (DECISIONS, Submission queue). ruby/ruby: none open for now. Other repos: at most
  # GEM_CAP open PRs without a maintainer response; ruby/ruby-bench is exempt. ruby/ruby opens only items Thomas names (DECISIONS).
  CAPS = { "rails/rails" => { open: 15, ready: 15 }, "ruby/ruby" => { open: 10 }, "ruby/ruby-bench" => {} }.freeze
  GEM_CAP = 2
  # script/ownership's check must be this recent to open (DECISIONS 2026-11-25, after TA1 duplicated an open PR).
  OWNERSHIP_DAYS = 3
  # /opt/git adds an Amp-Thread-ID trailer to commits and breaks `cat-file commit`.
  GIT = File.executable?("/usr/bin/git") ? "/usr/bin/git" : "git"
  THOMAS = { "NAME" => "Thomas Klemm", "EMAIL" => "github@tklemm.eu" }.freeze
  CHANGELOGS = ":(glob)**/CHANGELOG*"
  NOT_CHANGELOGS = ":(exclude,glob)**/CHANGELOG*"
  LEDGER = File.join(ROOT, "docs/upstream/contributions.md")
  # A measured number in a body: a unit, a percentage, a factor or a thousands-separated count. Links, SHAs and
  # #N are removed first. Such a body needs an evidence: path with the raw data to replay it (DECISIONS 2026-11-25).
  MEASURED = /\d(?:[\d,.]*\d)?(?:\s*%|\s*(?:×|ms|µs|us|ns|i\/s|Ir|instructions|objects|allocations|bytes|[KMG]i?B)\b|x\b|\s+times\b)|\b\d{1,3}(?:,\d{3})+\b/
  EVIDENCE_STATES = %w[reviewed draft ready merged closed].freeze

  Item = Struct.new(:path, :meta, :title, :body) do
    def id = meta["id"]
    def [](key) = meta[key]
    def fork = meta["fork"] || "#{AUTHOR}/#{meta['repo'].split('/').last}"
  end

  module_function

  def parse(path, text = File.read(path))
    _, front, rest = text.split(/^---\n/, 3)
    meta = YAML.safe_load(front, permitted_classes: [Date])
    rest = rest.to_s.sub(/\A\n+/, "")
    title, body = rest.split("\n", 2)
    body = body.to_s.sub(/\n*^## For Thomas$.*\z/m, "\n")
    Item.new(path, meta, title.to_s.delete_prefix("# "), body.sub(/\A\n/, "").chomp)
  end

  def items = Dir[File.join(ITEMS, "*.md")].map { parse(_1) }

  def sha?(value) = value.is_a?(String) && value.match?(/\A\h{7,40}\z/)

  def same_sha?(a, b) = sha?(a) && sha?(b) && (a.start_with?(b) || b.start_with?(a))

  def problems(item)
    m = item.meta
    list = []
    list << "id #{m['id'].inspect} doesn't match the file name" unless File.basename(item.path, ".md") == m["id"]
    list << "unknown state #{m['state'].inspect}" unless STATES.include?(m["state"])
    list << "unknown kind #{m['kind'].inspect}" unless KINDS.include?(m["kind"])
    list << "head must be a quoted SHA" unless m["head"].nil? || sha?(m["head"])
    list << "pr must be a number" unless m["pr"].nil? || m["pr"].is_a?(Integer)
    list << "introduced_by must be a PR number or a quoted SHA" unless m["introduced_by"].nil? || m["introduced_by"].is_a?(Integer) || sha?(m["introduced_by"])
    list << "guard_review must be true or false" unless [nil, true, false].include?(m["guard_review"])
    list << "#{m['state']} needs pr" if %w[draft ready merged].include?(m["state"]) && !m["pr"]
    list << "no title" if item.title.empty?
    Array(m["passes"]).each do |pass|
      list << "pass reviewer #{pass['reviewer'].inspect}" unless REVIEWERS.include?(pass["reviewer"])
      list << "pass verdict #{pass['verdict'].inspect}" unless VERDICTS.include?(pass["verdict"])
      list << "pass head must be a quoted SHA or unrecorded" unless sha?(pass["head"]) || pass["head"] == "unrecorded"
      list << "#{pass['reviewer']} pass needs orb" if %w[opus fable].include?(pass["reviewer"]) && pass["orb"].to_s.empty?
    end
    found, gone = Array(m["evidence"]).partition { _1.is_a?(String) && !_1.empty? && File.exist?(File.join(ROOT, _1)) }
    gone.each { list << "evidence #{_1.inspect} doesn't exist" }
    if EVIDENCE_STATES.include?(m["state"]) && found.empty? &&
       (number = item.body.gsub(%r{https?://\S+|\b(?=\h*[a-f])\h{7,40}\b|#\d+}, "")[MEASURED])
      list << "body has numbers (#{number}) but no evidence: path"
    end
    Array(m["waived"]).each do |waiver|
      list << "only thermos can be waived" unless waiver["reviewer"] == "thermos"
      list << "waiver head must be a quoted SHA" unless sha?(waiver["head"])
      list << "waiver needs by and reason" if waiver["by"].to_s.empty? || waiver["reason"].to_s.empty?
    end
    list
  end

  # Unknown diff size (nil) requires thermos, so an unchecked item never looks reviewed.
  # The final review is a separate Claude Code orb's (DECISIONS 4b6ec99); orbs' own skeptic passes stay as records.
  def required(meta, lines)
    list = %w[claude-code] # one detailed review, DECISIONS 2026-11-17
    list << "astra" if meta["risky"]
    list << "thermos" if lines.nil? || lines > THERMOS_LINES
    list
  end

  # Reviewers whose latest pass on the current head is missing or doesn't approve, unless waived on that head.
  # Passes are listed oldest first. A stand-in fills one slot, from an orb other than the claude-code pass's and
  # the other stand-ins'. With guard_review, a thermos-opus or thermos-fable pass stands in for Sol and Astra.
  def missing(meta, lines)
    passes = Array(meta["passes"]).select { same_sha?(_1["head"], meta["head"]) }.reverse
    waived = Array(meta["waived"]).select { _1["reviewer"] == "thermos" && same_sha?(_1["head"], meta["head"]) && !_1["reason"].to_s.empty? }
    approves = ->(pass) { VERDICTS.first(2).include?(pass&.fetch("verdict", nil)) }
    latest_per_orb = passes.uniq { [_1["reviewer"], _1["orb"]] }
    guard = meta["guard_review"] ? GUARD_STAND_INS : []
    reviews = passes.select { ACCEPTS["claude-code"].include?(_1["reviewer"]) }
    claude_orb = (reviews.find { !guard.include?(_1["reviewer"]) } || reviews.first)&.[]("orb").to_s
    used = ["", claude_orb]
    required(meta, lines).reject do |who|
      next true if waived.any? { _1["reviewer"] == who }
      next true if approves.(passes.find { ACCEPTS.fetch(who, [who]).include?(_1["reviewer"]) })
      next false if claude_orb.empty?
      stand_ins = STAND_INS.key?(who) ? STAND_INS[who] + guard : []
      stand_in = latest_per_orb.find do
        stand_ins.include?(_1["reviewer"]) && approves.(_1) && !used.include?(_1["orb"].to_s)
      end
      next false unless stand_in
      used << stand_in["orb"].to_s
    end
  end

  def set(item, key, value)
    text = File.read(item.path)
    raise "#{item.id}: no #{key}: line" unless text.match?(/^#{key}:/)
    File.write(item.path, text.sub(/^#{key}:.*$/) { "#{key}: #{value}" })
    item.meta[key] = value
  end

  def run(*cmd)
    out, err, status = Open3.capture3(*cmd)
    [out, status.success? ? nil : err.strip]
  end

  def gh(*args)
    out, err = run("gh", "api", *args)
    raise "gh api #{args.first}: #{err}" if err
    JSON.parse(out)
  end

  def our_open_prs(repo)
    query = <<~GRAPHQL
      query($q: String!) { search(query: $q, type: ISSUE, first: 100) { nodes { ... on PullRequest {
        number isDraft mergeable
        comments(first: 50) { nodes { author { login } } }
        reviews(first: 50) { nodes { author { login } } } } } } }
    GRAPHQL
    nodes = gh("graphql", "-f", "query=#{query}", "-f", "q=repo:#{repo} author:#{AUTHOR} is:pr is:open")
            .dig("data", "search", "nodes")
    nodes.map do |pr|
      others = (pr["comments"]["nodes"] + pr["reviews"]["nodes"]).map { _1.dig("author", "login") }
      { number: pr["number"], draft: pr["isDraft"], mergeable: pr["mergeable"],
        answered: others.any? { _1 && _1 != AUTHOR && !_1.end_with?("[bot]") } }
    end
  end

  # Nil when the repo has room for another PR (ready: for marking one more draft ready), else the reason.
  # Drafts count toward the open cap.
  def room(repo, prs, ready: false)
    cap = CAPS.fetch(repo, { unanswered: GEM_CAP })
    if ready
      n = prs.count { !_1[:draft] }
      "#{n}/#{cap[:ready]} non-draft" if cap[:ready] && n >= cap[:ready]
    elsif cap[:open] && prs.size >= cap[:open] then "#{prs.size}/#{cap[:open]} open"
    elsif cap[:unanswered] && (n = prs.count { !_1[:answered] }) >= cap[:unanswered]
      "#{n}/#{cap[:unanswered]} without a maintainer response"
    end
  end

  # Live facts per item from a blobless bare clone of the upstream repo under .lowrail/pr-queue:
  # fork head and the diff_facts against the current base.
  def facts(list)
    list.select { _1["branch"] }.group_by { _1["repo"] }.flat_map do |repo, group|
      dir = cache(repo)
      unless Dir.exist?(dir)
        _, err = run("git", "clone", "--quiet", "--bare", "--filter=blob:none", "https://github.com/#{repo}", dir)
        next group.map { [_1.id, { error: "clone: #{err}" }] } if err
      end
      git = ->(*args) { run("git", "-C", dir, *args) }
      bases = group.map { _1["base"] || "main" }.uniq
      _, err = git.(*%w[fetch --quiet origin], *bases.map { "+refs/heads/#{_1}:refs/heads/#{_1}" })
      next group.map { [_1.id, { error: "fetch: #{err}" }] } if err
      group.group_by(&:fork).flat_map do |fork, items|
        heads = git.("ls-remote", "--heads", "https://github.com/#{fork}").first.lines.to_h { _1.split.reverse }
        present = items.select { heads["refs/heads/#{_1['branch']}"] }
        unless present.empty?
          git.("fetch", "--quiet", "https://github.com/#{fork}",
               *present.map { "+refs/heads/#{_1['branch']}:refs/queue/#{_1.id}" })
        end
        items.map do |item|
          fork_head = heads["refs/heads/#{item['branch']}"]
          next [item.id, { fork_head: nil }] unless fork_head
          [item.id, { fork_head:, **diff_facts(git, "refs/heads/#{item['base'] || 'main'}", fork_head, item["built_on"]) }]
        end
      end
    end.to_h
  end

  # Diff size, the files that conflict with the base, and the base commits since built_on (else the merge base)
  # that touch the PR's files: an early warning that upstream moved under it, not a conflict.
  def diff_facts(git, base, head, built_on)
    stat, = git.("diff", "--shortstat", "#{base}...#{head}")
    lines = stat.scan(/(\d+) (?:insertion|deletion)/).flatten.sum(&:to_i)
    out, conflict = git.("merge-tree", "--write-tree", "--name-only", "--no-messages", base, head)
    files = git.("diff", "--name-only", "#{base}...#{head}").first.split("\n")
    since = built_on.to_s.empty? ? head : built_on
    count, err = files.empty? ? ["0", nil] : git.("rev-list", "--count", base, "^#{since}", "--", *files)
    touched = files.empty? || err ? [] : git.("diff", "--name-only", since, base, "--", *files).first.split("\n")
    log, = git.("log", "--format=%h%x1f%(trailers:key=Amp-Thread-ID,key=Co-authored-by,separator=%x1f)", "#{base}..#{head}")
    trailers = log.to_s.lines.filter_map do |line|
      sha, *found = line.chomp.split("\x1f")
      # Thomas as co-author credits him on someone else's commit (ZS1).
      found.reject! { _1.end_with?("<#{THOMAS['EMAIL']}>") }
      "#{sha} #{found.map { _1[/\A[^:]+/] }.uniq.join(', ')}" if found.any?
    end
    { lines:, clean: conflict.nil?, conflicts: conflict ? out.lines.drop(1).map(&:chomp).reject(&:empty?) : [],
      base_commits: err ? nil : count.to_i, base_files: touched,
      trailers: }
  end

  def cache(repo) = File.join(CACHE, "#{repo.tr('/', '-')}.git")

  def changelog_only?(fact) = fact[:conflicts].any? && fact[:conflicts].all? { File.basename(_1).start_with?("CHANGELOG") }

  def merge_label(fact, mergeable)
    if fact&.key?(:clean) then fact[:clean] ? "clean" : (changelog_only?(fact) ? "CHANGELOG-only" : "CONFLICT")
    else { "MERGEABLE" => "clean(gh)", "CONFLICTING" => "CONFLICT(gh)" }.fetch(mergeable, "")
    end
  end

  def ownership_blocker(meta, today = Date.today)
    date = meta["ownership"]["date"] if meta["ownership"].is_a?(Hash)
    return "no ownership check; run script/ownership #{meta['id']}" unless date.is_a?(Date)
    "ownership check of #{date} is older than #{OWNERSHIP_DAYS} days; run script/ownership #{meta['id']}" if today - date > OWNERSHIP_DAYS
  end

  def deps_problem(item, by_id)
    Array(item["depends_on"]).each do |dep|
      return "depends on #{dep}, not merged" unless by_id[dep]&.[]("state") == "merged"
    end
    if (parent = item["stacked_on"]) && !by_id[parent]&.[]("pr")
      return "stacked on #{parent}, not opened"
    end
    nil
  end

  # Why this item can't open now, or nil.
  def open_blocker(item, fact, by_id)
    return "state is #{item['state']}, not reviewed" unless item["state"] == "reviewed"
    return "no fork branch #{item.fork}:#{item['branch']}" unless fact&.[](:fork_head)
    return "fork head #{fact[:fork_head][0, 10]} isn't head #{item['head']}" unless same_sha?(fact[:fork_head], item["head"])
    gaps = missing(item.meta, fact[:lines])
    return "no approving pass on this head from #{gaps.join(', ')}" unless gaps.empty?
    return "conflicts with #{item['base'] || 'main'}" unless fact[:clean]
    return "no body" if item.body.empty?
    ownership_blocker(item.meta) || deps_problem(item, by_id)
  end

  def next_step(item, fact, by_id)
    lines = fact&.[](:lines)
    gaps = item["head"] ? missing(item.meta, lines) : []
    moved = fact&.[](:fork_head) && item["head"] && !same_sha?(fact[:fork_head], item["head"])
    conflict = if fact && fact[:clean] == false
                 changelog_only?(fact) ? "script/pr-queue rebase #{item.id}: only CHANGELOG conflicts" : "rebase by hand: conflicts with #{item['base'] || 'main'}"
               end
    case item["state"]
    when "merged", "closed", "superseded" then "-"
    when "held" then "held: #{item['note']}"
    when "ready" then conflict || "awaiting maintainers"
    else
      return "fork moved to #{fact[:fork_head][0, 10]}: update head, review again" if moved
      return conflict if conflict
      return "review: #{gaps.join(', ')} on this head" unless gaps.empty?
      return "push the branch to #{item.fork}" if fact && !fact[:fork_head]
      { "built" => "review", "in-review" => "set state: reviewed", "reviewed" => deps_problem(item, by_id) || ownership_blocker(item.meta) || "open",
        "draft" => "ready when a slot frees" }.fetch(item["state"])
    end
  end

  def status
    list = items
    list.each { |item| (p = problems(item)).empty? || warn("#{item.id}: #{p.join('; ')}") }
    by_id = list.to_h { [_1.id, _1] }
    live = facts(list.reject { %w[merged closed superseded].include?(_1["state"]) })
    mergeable = {}
    open_prs = {}
    list.map { _1["repo"] }.uniq.sort.each do |repo|
      prs = our_open_prs(repo)
      prs.each { mergeable[[repo, _1[:number]]] = _1[:mergeable] }
      prs.each { open_prs[[repo, _1[:number]]] = _1 }
      puts "#{repo}: #{prs.size} open, #{prs.count { !_1[:draft] }} non-draft; " \
           "room: #{room(repo, prs) || 'yes'}#{", ready: #{room(repo, prs, ready: true) || 'yes'}" if repo == 'rails/rails'}"
    end
    puts
    stale = github_drift(list, open_prs)
    rows = list.sort_by { [STATES.index(_1["state"]) || 99, _1["repo"], _1["rank"] || 999, _1.id] }.map do |item|
      fact = live[item.id]
      head = item["head"].to_s[0, 10]
      fork = if !fact || !item["branch"] then "" elsif fact[:error] then "?" elsif !fact[:fork_head] then "missing"
             elsif same_sha?(fact[:fork_head], item["head"]) then "=" else fact[:fork_head][0, 10] end
      on_head = Array(item["passes"]).select { same_sha?(_1["head"], item["head"]) }
      passes = on_head.map { "#{_1['reviewer']}:#{_1['verdict']}" }.uniq.join(" ")
      moved = fact&.key?(:base_commits) ? (fact[:base_commits]&.to_s || "?") : ""
      [item["state"], item["rank"].to_s, item.id, item["repo"], item["pr"].to_s, head, fork,
       fact&.[](:lines).to_s, merge_label(fact, mergeable[[item["repo"], item["pr"]]]), moved, passes,
       stale[item.id] || next_step(item, fact, by_id)]
    end
    header = %w[STATE RANK ID REPO PR HEAD FORK LINES MERGE BASE-MOVED PASSES-ON-HEAD NEXT]
    widths = header.each_index.map { |i| ([header] + rows).map { _1[i].size }.max }
    ([header] + rows).each { |row| puts row.each_with_index.map { |cell, i| cell.ljust(widths[i]) }.join("  ").rstrip }
    drift = live.select { |_, fact| fact[:base_commits].to_i.positive? }
    puts "\nBase commits since built_on on the PR's files:" unless drift.empty?
    drift.sort.each { |id, fact| puts "  #{id}: #{fact[:base_commits]} on #{fact[:base_files].join(', ')}" }
    trailered = live.select { |_, fact| fact[:trailers]&.any? }
    puts "\nAmp trailers on PR commits (rebuild with /usr/bin/git):" unless trailered.empty?
    trailered.sort.each { |id, fact| puts "  #{id}: #{fact[:trailers].size} commits (#{fact[:trailers].map { _1.split.first }.join(', ')})" }
    puts "\nOut of date with GitHub or the ledger:" unless stale.empty?
    stale.each { |id, problem| puts "  #{id}: #{problem}" }
  end

  # Items whose state disagrees with our open PRs on GitHub (fixed by sync), and merged items missing from the
  # Merged section of the contributions ledger, which is kept by hand.
  def github_drift(list, open_prs)
    merged_section = File.read(LEDGER)[/^## Merged\n.*?(?=^## )/m].to_s.downcase
    list.select { _1["pr"] }.sort_by(&:id).filter_map do |item|
      pr = open_prs[[item["repo"], item["pr"]]]
      problem = case item["state"]
                when "draft", "ready"
                  if !pr then "sync: #{item['state']} here, ##{item['pr']} no longer open on GitHub"
                  elsif pr[:draft] != (item["state"] == "draft")
                    "sync: #{item['state']} here, ##{item['pr']} #{pr[:draft] ? 'draft' : 'ready'} on GitHub"
                  end
                when "merged", "closed"
                  if pr then "#{item['state']} here, ##{item['pr']} open on GitHub"
                  elsif item["state"] == "merged" && !merged_section.include?("github.com/#{item['repo'].downcase}/pull/#{item['pr']})")
                    "ledger: ##{item['pr']} merged, not under Merged in docs/upstream/contributions.md"
                  end
                end
      [item.id, problem] if problem
    end.to_h
  end

  def candidates
    list = items
    by_id = list.to_h { [_1.id, _1] }
    reviewed = list.select { _1["state"] == "reviewed" }
    live = facts(reviewed)
    [reviewed.sort_by { [_1["rank"] || 999, _1.id] }, live, by_id]
  end

  def next_item
    list, live, by_id = candidates
    rooms = Hash.new { |h, repo| h[repo] = room(repo, our_open_prs(repo)) }
    list.each do |item|
      blocker = open_blocker(item, live[item.id], by_id) || rooms[item["repo"]]
      next puts("skip #{item.id}: #{blocker}") if blocker
      draft = item["repo"] == "rails/rails" ? " --draft" : ""
      return puts("#{item.id} (rank #{item['rank']}): #{item.title}\n  script/pr-queue open #{item.id}#{draft}")
    end
    puts "nothing to open"
  end

  def find(id) = items.find { _1.id == id } || abort("no item #{id}")

  def open_pr(id, draft:)
    _, live, by_id = candidates
    item = find(id)
    abort "#{id}: rails/rails opens ready, not as draft (DECISIONS 2026-11-27)" if item["repo"] == "rails/rails" && draft
    # Checked before the PR exists, so a missing line can't leave an opened PR unrecorded.
    abort "#{id}: item needs pr: and state: lines" unless %w[pr state].all? { File.read(item.path).match?(/^#{_1}:/) }
    if (blocker = open_blocker(item, live[id], by_id) || room(item["repo"], our_open_prs(item["repo"])))
      abort "#{id}: #{blocker}"
    end
    Tempfile.create("pr-body") do |f|
      f.write(item.body)
      f.close
      pr = gh("repos/#{item['repo']}/pulls", "-f", "title=#{item.title}", "-f", "head=#{item.fork.split('/').first}:#{item['branch']}",
              "-f", "base=#{item['base'] || 'main'}", "-F", "body=@#{f.path}", "-F", "draft=#{draft}",
              "-F", "maintainer_can_modify=true")
      set(item, "pr", pr["number"])
      set(item, "state", pr["draft"] ? "draft" : "ready")
      puts "opened #{item['repo']}##{pr['number']} at #{pr.dig('head', 'sha')[0, 10]} (#{item['state']}); commit #{item.path}"
    end
  end

  def mark_ready(id)
    item = find(id)
    abort "#{id}: state is #{item['state']}, not draft" unless item["state"] == "draft"
    pr = gh("repos/#{item['repo']}/pulls/#{item['pr']}")
    abort "#{id}: ##{item['pr']} is not an open draft" unless pr["state"] == "open" && pr["draft"]
    head = pr.dig("head", "sha")
    abort "#{id}: PR head #{head[0, 10]} isn't head #{item['head']}" unless same_sha?(head, item["head"])
    lines = pr["additions"] + pr["deletions"]
    gaps = missing(item.meta, lines)
    abort "#{id}: no approving pass on this head from #{gaps.join(', ')}" unless gaps.empty?
    if (full = room(item["repo"], our_open_prs(item["repo"]), ready: true))
      abort "#{id}: no room, #{full}"
    end
    mutation = "mutation($id: ID!) { markPullRequestReadyForReview(input: {pullRequestId: $id}) { pullRequest { isDraft } } }"
    gh("graphql", "-f", "query=#{mutation}", "-f", "id=#{pr['node_id']}")
    set(item, "state", "ready")
    puts "#{item['repo']}##{item['pr']} is ready for review; commit #{item.path}"
  end

  def sync
    items.select { _1["pr"] && !%w[merged closed superseded].include?(_1["state"]) }.each do |item|
      pr = gh("repos/#{item['repo']}/pulls/#{item['pr']}")
      state = if pr["merged"] then "merged" elsif pr["state"] == "closed" then "closed" elsif pr["draft"] then "draft"
              else "ready" end
      moved = same_sha?(pr.dig("head", "sha"), item["head"]) ? "" : " (PR head #{pr.dig('head', 'sha')[0, 10]} isn't head)"
      next puts("#{item.id} ##{item['pr']}: #{state}#{moved}") if state == item["state"]
      puts "#{item.id} ##{item['pr']}: #{item['state']} -> #{state}#{moved}"
      set(item, "state", state)
    end
  end

  # git options that sign with script/signing-key's SSH key when $GIT_SIGNING_KEY_SEED is set, as script/commit does.
  def signing
    return [] if ENV["GIT_SIGNING_KEY_SEED"].to_s.empty?
    @signing ||= begin
      key = Tempfile.new("signing-key", ENV.fetch("XDG_RUNTIME_DIR", "/dev/shm")).tap(&:close)
      at_exit { key.unlink }
      system(File.join(__dir__, "signing-key"), "private", key.path, exception: true)
      ["-c", "gpg.format=ssh", "-c", "user.signingkey=#{key.path}"]
    end
  end

  def git_in(dir)
    lambda do |*args, env: {}, input: nil|
      out, err, st = Open3.capture3(env, GIT, "-C", dir, *args, stdin_data: input.to_s, binmode: true)
      raise "git #{args.first(2).join(' ')}: #{err.strip}" unless st.success?
      out
    end
  end

  # The block that `after` inserts into `before`, placed into `current` the same way: below the heading it was
  # under (e.g. "## [Unreleased]") and its blank lines, or at the top of the file. Nil when the change isn't one
  # inserted block there, or `current` lacks the heading.
  def place_entry(before, after, current)
    b, a, c = [before, after, current].map(&:lines)
    blank = ->(line) { line.nil? || line.strip.empty? }
    heading = ->(line) { line.nil? || line.start_with?("#") }
    pre = 0
    pre += 1 while pre < b.size && b[pre] == a[pre]
    suf = 0
    suf += 1 while suf < b.size - pre && b[-1 - suf] == a[-1 - suf]
    return if pre + suf != b.size || a.size == b.size
    entry = a[pre...(a.size - suf)]
    blanks = entry.reverse.take_while(&blank)
    entry = entry[0, entry.size - blanks.size]
    under = b[0...pre].reverse.find { !blank.(_1) }
    at = 0
    if under
      return unless heading.(under) && (at = c.index(under))
      at += 1
      at += 1 while c[at] && blank.(c[at])
    end
    # Blank lines that separated the entry from the next section don't go between it and an entry, and back.
    gap = if heading.(c[at]) then blanks.empty? ? ["\n"] : blanks
          elsif heading.(a[a.size - suf]) then []
          else blanks end
    (c[0...at] + entry + gap + c[at..]).join
  end

  # Replays mb..old_head onto base: each commit's diff outside CHANGELOG files, and its CHANGELOG entries on top of
  # the base's. Keeps each message byte for byte and its author and author date; Thomas commits. A temporary
  # index in the bare cache, so no checkout is touched.
  def rebuild(dir, base, old_head)
    git = git_in(dir)
    prev = git.("rev-parse", "#{base}^{commit}").strip
    mb = git.("merge-base", prev, old_head).strip
    commits = git.("rev-list", "--reverse", "--parents", "#{mb}..#{old_head}").lines.map(&:split)
    raise "merge commit #{commits.find { _1.size > 2 }[0][0, 10]} in the branch; rebase by hand" if commits.any? { _1.size > 2 }
    Tempfile.create("pr-queue-index") do |index|
      env = { "GIT_INDEX_FILE" => index.path }
      pairs = commits.map do |commit, parent|
        git.("read-tree", prev, env:)
        code = git.("diff", "--binary", "--full-index", parent, commit, "--", ".", NOT_CHANGELOGS)
        begin
          git.("apply", "--cached", "--binary", env:, input: code) unless code.empty?
        rescue RuntimeError => e
          raise "#{commit[0, 10]} doesn't apply on #{base}: rebase by hand (#{e.message})"
        end
        git.("diff", "--name-only", parent, commit, "--", CHANGELOGS).split("\n").each do |path|
          show = ->(rev) { git.("cat-file", "-p", "#{rev}:#{path}") rescue nil }
          before, after, current = show.(parent), show.(commit), show.(prev)
          text = before && after && current && place_entry(before, after, current)
          raise "#{commit[0, 10]}: the #{path} change isn't one entry on top; rebase by hand" unless text
          blob = git.("hash-object", "-w", "--stdin", input: text).strip
          mode = git.("ls-tree", commit, "--", path).split.first
          git.("update-index", "--add", "--cacheinfo", "#{mode},#{blob},#{path}", env:)
        end
        tree = git.("write-tree", env:).strip
        header, message = git.("cat-file", "commit", commit).split("\n\n", 2)
        name, email, date = header[/^author (.*)$/, 1].match(/\A(.*) <(.*)> (\d+ [+-]\d{4})\z/).captures
        ident = { "GIT_AUTHOR_NAME" => name, "GIT_AUTHOR_EMAIL" => email, "GIT_AUTHOR_DATE" => "@#{date}",
                  "GIT_COMMITTER_NAME" => THOMAS["NAME"], "GIT_COMMITTER_EMAIL" => THOMAS["EMAIL"], "GIT_COMMITTER_DATE" => nil }
        prev = git.(*signing, "commit-tree", *(signing.empty? ? [] : ["-S"]), tree, "-p", prev, env: ident, input: message).strip
        [commit, prev]
      end
      [mb, pairs]
    end
  end

  # [ok, line] per check of the rebuilt commits against the old ones.
  def rebase_checks(dir, pairs)
    git = git_in(dir)
    changes = lambda do |commit, *paths|
      git.("diff", "#{commit}^", commit, "--", *paths).lines.grep(/^(diff --git|[+-])/).reject { _1.start_with?("+++", "---") }
    end
    raw = ->(commit) { git.("cat-file", "commit", commit).split("\n\n", 2) }
    pairs.flat_map do |old, new|
      (old_header, old_message), (new_header, new_message) = raw.(old), raw.(new)
      committer = new_header[/^committer (.*) <(.*)> /, 0].to_s
      added = changes.(new, CHANGELOGS)
      [[changes.(old, ".", NOT_CHANGELOGS) == changes.(new, ".", NOT_CHANGELOGS), "code diff identical (added and removed lines)"],
       [changes.(old, CHANGELOGS).grep(/^\+./) == added.grep(/^\+./) && added.none? { _1.start_with?("-") },
        "CHANGELOG: same entry added, nothing removed"],
       [old_message == new_message, "message byte-identical"],
       [old_header[/^author .*$/] == new_header[/^author .*$/], "author and author date kept"],
       [committer == "committer #{THOMAS['NAME']} <#{THOMAS['EMAIL']}> ", "committer #{THOMAS['NAME']}"],
       [git.("log", "-1", "--format=%(trailers:only)", new).strip.empty?, "no trailers"],
       [signing.empty? || new_header.include?("\ngpgsig -----BEGIN SSH SIGNATURE"), "signed"]]
        .map { |ok, what| [ok, "#{new[0, 10]} (was #{old[0, 10]}): #{what}"] }
    end
  end

  def rebase(id, push:)
    item = find(id)
    base = item["base"] || "main"
    fact = facts([item])[id] || abort("#{id}: no branch")
    abort "#{id}: #{fact[:error]}" if fact[:error]
    abort "#{id}: no fork branch #{item.fork}:#{item['branch']}" unless (old = fact[:fork_head])
    abort "#{id}: fork head #{old[0, 10]} isn't head #{item['head']}; update the item first" unless same_sha?(old, item["head"])
    abort "#{id}: merges cleanly with #{base}; nothing to rebase (DECISIONS: no force-push without a conflict)" if fact[:clean]
    abort "#{id}: conflicts outside CHANGELOG files (#{fact[:conflicts].join(', ')}); rebase by hand" unless changelog_only?(fact)
    dir = cache(item["repo"])
    git = git_in(dir)
    onto = git.("rev-parse", "refs/heads/#{base}").strip
    mb, pairs = begin
      rebuild(dir, onto, old)
    rescue RuntimeError => e
      abort "#{id}: #{e.message}"
    end
    new = pairs.last.last
    git.("update-ref", "refs/rebase/#{id}", new)
    puts "#{id}: #{pairs.size} commit(s) from #{old[0, 10]} rebuilt on #{base} #{onto[0, 10]}: #{new} (#{dir} refs/rebase/#{id})"
    puts "\n#{git.('range-diff', '--no-color', "#{mb}..#{old}", "#{onto}..#{new}")}"
    checks = rebase_checks(dir, pairs)
    checks.each { |ok, line| puts "#{ok ? 'ok  ' : 'FAIL'} #{line}" }
    abort "#{id}: checks failed; not pushed" unless checks.all?(&:first)
    return puts("\nNot pushed, item unchanged. Pushing an open PR needs Thomas's OK (DECISIONS); then rerun with --push.") unless push

    _, err = run(GIT, "-C", dir, "-c", "credential.helper=", "-c", "credential.helper=!gh auth git-credential", "push", "--quiet",
                 "--force-with-lease=refs/heads/#{item['branch']}:#{old}", "https://github.com/#{item.fork}",
                 "#{new}:refs/heads/#{item['branch']}")
    abort "#{id}: push failed: #{err}" if err
    note = "#{Date.today} (CHANGELOG rebase): rebuilt on #{base} #{onto[0, 10]} from #{old[0, 10]} with script/pr-queue " \
           "rebase; code diff identical, CHANGELOG entry on top of the base's; messages, authors and author dates kept, " \
           "committer Thomas, no trailers. Force-pushed with a lease on #{old[0, 10]}."
    set(item, "head", %("#{new}"))
    set(item, "built_on", %("#{onto}"))
    set(item, "note", [note, item["note"]].compact.join(" ").to_json)
    puts "pushed #{new[0, 10]} to #{item.fork}:#{item['branch']}; updated head, built_on and note; commit #{item.path}"
  end
end

if $PROGRAM_NAME == __FILE__
  command, id, *rest = ARGV
  case command
  when "status" then PrQueue.status
  when "next" then PrQueue.next_item
  when "open" then PrQueue.open_pr(id || abort("open ID [--draft]"), draft: rest == ["--draft"])
  when "ready" then PrQueue.mark_ready(id || abort("ready ID"))
  when "sync" then PrQueue.sync
  when "rebase" then PrQueue.rebase(id || abort("rebase ID [--push]"), push: rest == ["--push"])
  else abort File.read(__FILE__)[/^#   script.*?(?=\n\n)/m].gsub(/^# ?/, "")
  end
end

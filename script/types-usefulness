#!/usr/bin/env python3
"""Replay a fixed, independently grounded question set against the real MCP.

Input: {"apps": [{"name": "public-label", "app": "/external/alias",
"questions": [{"id": "q01", "question": "...", "tool": "type_of",
"arguments": {"target": "Example#value"}, "select": "/fact/name",
"expected": ["String?"], "evidence": ["boot/source receipt path and hash"]}]}]}.
Each app must have exactly 20 questions (10 for a held-out run). JSON-pointer selectors support * for
array/object children. Expected and returned facts are sets; a wrong fact
counts as both a false positive and a missed fact. Unknown/unavailable answers
are abstentions, not successes. Full responses and wrong answers are retained.
Keep private question sets and output outside Git. This tool does not invent
ground truth, boot an app, run Ruby, write app files, or suppress MCP errors.
"""
import argparse
from collections import Counter
import hashlib
import json
from pathlib import Path
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("questions", type=Path)
parser.add_argument("--lowrail", type=Path, default=Path("target/debug/lowrail"))
parser.add_argument("--questions-per-app", type=int, choices=(10, 20), default=20)
options = parser.parse_args()


def select(value, path):
    values = [value]
    assert path.startswith("/"), "select must be a JSON pointer"
    for part in path[1:].split("/"):
        part = part.replace("~1", "/").replace("~0", "~")
        children = []
        for item in values:
            if part == "*":
                children.extend(item.values() if isinstance(item, dict) else item if isinstance(item, list) else [])
            elif isinstance(item, dict) and part in item:
                children.append(item[part])
            elif isinstance(item, list) and part.isdigit() and int(part) < len(item):
                children.append(item[int(part)])
        values = children
    return values


def facts(values):
    return {json.dumps(v, sort_keys=True) for v in values if v is not None and v != "untyped"}


def metrics(counts):
    tp, fp, fn = (counts[k] for k in ("tp", "fp", "fn"))
    return dict(counts, precision=tp / (tp + fp) if tp + fp else None,
                recall=tp / (tp + fn) if tp + fn else None)


report = {"format": 1, "questions_sha256": hashlib.sha256(options.questions.read_bytes()).hexdigest(),
          "binary_sha256": hashlib.sha256(options.lowrail.read_bytes()).hexdigest(), "apps": []}
total = Counter()
for app in json.loads(options.questions.read_bytes())["apps"]:
    assert len(app["questions"]) == options.questions_per_app, "freeze the question count before comparing"
    assert len({q["id"] for q in app["questions"]}) == options.questions_per_app, "duplicate question IDs"
    process = subprocess.Popen([str(options.lowrail.resolve()), "mcp", app["app"]],
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    serial = 0

    def exchange(method, params):
        global serial
        serial += 1
        process.stdin.write(json.dumps({"jsonrpc": "2.0", "id": serial, "method": method, "params": params}) + "\n")
        process.stdin.flush()
        response = json.loads(process.stdout.readline())
        assert response["id"] == serial, response
        return response

    rows = []
    counts = Counter(tp=0, fp=0, fn=0, correct=0, wrong=0, abstained=0)
    try:
        initialized = exchange("initialize", {"protocolVersion": "2025-06-18"})
        assert "result" in initialized, initialized
        process.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        for question in app["questions"]:
            assert question["evidence"] and question["expected"], "independent nonempty ground truth required"
            response = exchange("tools/call", {"name": question["tool"], "arguments": question["arguments"]})
            result = response.get("result", {})
            answer = result.get("structuredContent", {}) if not result.get("isError") else {}
            actual = facts(select(answer, question["select"])) if answer.get("available") is not False else set()
            expected = facts(question["expected"])
            tp, fp, fn = actual & expected, actual - expected, expected - actual
            outcome = "correct" if not fp and not fn else "wrong" if actual else "abstained"
            counts.update(tp=len(tp), fp=len(fp), fn=len(fn))
            counts[outcome] += 1
            rows.append(dict(question, outcome=outcome, returned=sorted(actual),
                             false_positives=sorted(fp), missed=sorted(fn), response=response))
    finally:
        process.stdin.close()
        assert process.wait(timeout=60) == 0
    total.update(counts)
    report["apps"].append({"name": app["name"], "metrics": metrics(counts), "questions": rows})
report["total"] = metrics(total)
print(json.dumps(report, indent=2))

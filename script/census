    apps.merge(
      "mastodon-nops" => apps["mastodon"].merge(copy: "mastodon", env: apps["mastodon"][:env].merge(
        "PREPARED_STATEMENTS" => "false", "CENSUS_PREPARED_STATEMENTS" => "false")),
      "lago-nops" => apps["lago"].merge(copy: "lago", env: apps["lago"][:env].merge(
        "DATABASE_PREPARED_STATEMENTS" => "false", "CENSUS_PREPARED_STATEMENTS" => "false")),
    )

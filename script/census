  SERVICES = { "redis" => 6379, "memcached" => 11211, "mysql" => 3307 }.freeze

  module_function

  def sh(env, *cmd, chdir: ROOT, log: nil)
    puts "+ #{cmd.join(" ")}#{" (in #{chdir.delete_prefix(ROOT + "/")})" if chdir != ROOT}"
    opts = { chdir: chdir, exception: true }
    opts.merge!(out: log, err: %i[child out]) if log
    system(env, *cmd, **opts)
  end

  def capture(*cmd, **opts)
    out, status = Open3.capture2(*cmd, **opts)
    raise "#{cmd.join(" ")} failed" unless status.success?
    out.strip
  end

  def mise = ENV.fetch("MISE", File.executable?(File.expand_path("~/.local/bin/mise")) ? File.expand_path("~/.local/bin/mise") : "mise")

  # Ruby: a bin directory, a ruby executable, or a mise version (installed on demand).
  def ruby_bin(spec)
    return spec if File.executable?(File.join(spec, "ruby"))
    return File.join(spec, "bin") if File.executable?(File.join(spec, "bin/ruby"))
    return File.dirname(File.expand_path(spec)) if File.file?(spec) && File.executable?(spec)
    system(mise, "install", "ruby@#{spec}", exception: true)
    File.join(capture(mise, "where", "ruby@#{spec}"), "bin")
  end

  def ruby_description(bin) = capture(File.join(bin, "ruby"), "-e", "print RUBY_DESCRIPTION")

  # [OWNER/REPO@|/path@]REF -> source, ref and commit.
  def resolve_rails(spec, default_repo = "rails/rails")
    repo, ref = spec.include?("@") ? spec.split("@", 2) : [default_repo, spec]
    if repo.start_with?("/")
      sha = capture("git", "-C", repo, "rev-parse", "--verify", "#{ref}^{commit}")
      return { "spec" => spec, "source" => %(git: "#{repo}"), "ref" => ref, "sha" => sha }
    end
    sha = ref if ref.match?(/\A\h{40}\z/)
    sha ||= capture("git", "ls-remote", "https://github.com/#{repo}.git", "refs/heads/#{ref}", "refs/tags/#{ref}", ref)
      .lines.first&.split&.first
    raise "cannot resolve #{spec}" unless sha
    { "spec" => spec, "source" => %(github: "#{repo}"), "ref" => ref, "sha" => sha }
  end

  def app_dir(corpus, app) = File.join(ROOT, ".corpus", "#{corpus}-#{APPS.fetch(app).fetch(:copy, app)}")

  def state(corpus, app)
    path = File.join(app_dir(corpus, app), ".census.json")
    raise "#{app}: no census copy; run script/census setup first" unless File.exist?(path)
    JSON.parse(File.read(path))
  end

  def env_for(app, bin, rails, gemfile, frozen: true)
    raise "unset database overrides before using disposable copies" if ENV.keys.any? { _1.end_with?("DATABASE_URL") }
    { "PATH" => "#{bin}:#{ENV.fetch("PATH")}", "BUNDLE_GEMFILE" => gemfile, "BUNDLE_FROZEN" => frozen.to_s,
      "RAILS_ENV" => "production", "RACK_ENV" => "production", "SECRET_KEY_BASE_DUMMY" => "1",
      "RAILS_LOG_LEVEL" => "fatal", "SKIP_TELEMETRY" => "1", "APP_VERSION" => "census", "APP_HOST" => "localhost",
      "RUBYOPT" => nil, "RUBY_YJIT_ENABLE" => "0", "RUBY_ZJIT_ENABLE" => "0", "GEM_HOME" => nil, "GEM_PATH" => nil,
      "CENSUS_RAILS_SHA" => rails.fetch("sha"), "DISABLE_DATABASE_ENVIRONMENT_CHECK" => "1" }
      .merge(APPS.fetch(app).fetch(:env, {}))
  end

  # The app's census Gemfile with Rails at this commit (and no ruby pin, so the
  # Ruby is a parameter), bundled for this Ruby. Identical commits share one.
  # Gem pins (--gem) apply only to apps whose Gemfile lists the gem.
  def gem_pins(corpus, app, gems)
    gemfile = File.read(File.join(app_dir(corpus, app), "Gemfile"))
    gems.select { |name, _| gemfile.match?(/^\s*gem ["']#{Regexp.escape(name)}["']/) }
  end

  def variant(corpus, app, rails, bin, gems = {})
    dir = app_dir(corpus, app)
    gems = gem_pins(corpus, app, gems)
    suffix = gems.map { |name, g| "-#{name}-#{g.fetch("sha")[0, 12]}" }.join
    gemfile = File.join(dir, "Gemfile.census-#{rails.fetch("sha")[0, 12]}#{suffix}")
    unless File.exist?(gemfile)
      lines = File.readlines(File.join(dir, "Gemfile"))
      pins = lines.each_index.filter_map { |i| [i, $1] if lines[i] =~ /\A\s*gem ["'](#{RAILS_GEMS.join("|")})["'],/ }
      raise "#{app}: expected a gem \"rails\" line (or its components), found none" if pins.empty?
      pins.each { |i, gem| lines[i] = %(gem "#{gem}", #{rails.fetch("source")}, ref: "#{rails.fetch("sha")}"\n) }
      gems.each do |name, g|
        i = lines.index { _1.match?(/\A\s*gem ["']#{Regexp.escape(name)}["']/) }
        lines[i] = %(gem "#{name}", #{g.fetch("source")}, ref: "#{g.fetch("sha")}"\n)
      end
      File.write(gemfile, lines.grep_v(/\Aruby\b/).join)
      # The variant drops the ruby pin, so its lock drops RUBY VERSION too
      # (frozen Bundler otherwise refuses to unlock it).
      File.write(gemfile + ".lock", File.read(File.join(dir, "Gemfile.lock")).sub(/^RUBY VERSION\n.*?\n\n/m, ""))
    end
    env = env_for(app, bin, rails, gemfile, frozen: false)
    system(env, "bundle", "check", chdir: dir, out: File::NULL, err: File::NULL) ||
      sh(env, "bundle", "install", "--quiet", chdir: dir)
    gemfile
  end

  # Dependency control: a variant's lock may differ from the base lock only in
  # the Rails source block and the Ruby version.
  def lock_outside_rails(path, gems = [])
    names = Regexp.union(%w[rails railties] + gems)
    pinned = Regexp.union(gems)
    blocks = File.read(path).split(/\n{2,}/).reject { _1.start_with?("RUBY VERSION") || (_1.start_with?("GIT") && _1.match?(/^    #{names} \(/)) }
    return blocks if gems.empty?
    # A pinned gem's own spec (and its dependency lines) and its DEPENDENCIES entry move with the pin.
    blocks.map { _1.gsub(/^    #{pinned} \(.*\n(?:      .*\n?)*/, "").gsub(/^  #{pinned}(?:!| \(.*)?$\n?/, "") }
  end

  def check_services(apps)
    apps.flat_map { APPS.fetch(_1).fetch(:services, []) }.uniq.each do |service|
      ok = if service == "postgresql"
        system("pg_isready", "-q")
      else
        begin
          Socket.tcp("127.0.0.1", SERVICES.fetch(service), connect_timeout: 1).close
          true
        rescue SystemCallError, IOError
          false
        end
      end
      raise "#{service} is not reachable; start a disposable local #{service} (see docs/upstream/census.md)" unless ok
    end
  end

  def apps_option(value) = value == "all" ? APPS.keys : value.split(",").each { |app| APPS.fetch(app) { raise "unknown app #{app}" } }

  def setup(opts)
    rails = resolve_rails(opts.fetch(:rails))
    bin = ruby_bin(opts[:ruby])
    check_services(opts[:apps])
    opts[:apps].each do |app|
      conf = APPS.fetch(app)
      next puts("#{app}: runs #{conf[:copy]}'s copy") if conf[:copy]
      dir = app_dir(opts[:corpus], app)
      raise "fresh copy required: #{dir}" if File.exist?(dir)
      sh({}, File.join(ROOT, "script/corpus"), conf.fetch(:source), File.basename(dir), "--source-only",
        *("--no-overlay" if conf[:bare]))
      overlay = conf.fetch(:overlay, app)
      overlay = File.join(opts[:overlays], "#{overlay}.patch") unless overlay.include?("/")
      sh({}, "patch", "-p1", "--forward", "--silent", "-i", overlay, chdir: dir)
      FileUtils.cp(File.join(dir, conf[:database_yml]), File.join(dir, "config/database.yml")) if conf[:database_yml] && !File.exist?(File.join(dir, "config/database.yml"))
      # Git does not keep empty directories; Lobsters' production log opens log/rails.log at boot.
      FileUtils.mkdir_p(%w[log tmp storage].map { File.join(dir, _1) })
      File.write(File.join(dir, ".census.json"), JSON.pretty_generate("app" => app, "base" => rails,
        "overlay" => overlay.delete_prefix(ROOT + "/"), "created" => Time.now.utc.iso8601) + "\n")
      gemfile = variant(opts[:corpus], app, rails, bin)
      env = env_for(app, bin, rails, gemfile)
      conf.fetch(:pre_db, []).each { sh(env, *_1, chdir: dir) }
      db_tasks = conf.fetch(:db, %w[db:create db:schema:load])
      # Server databases are named by the app's own config, not by the copy, so
      # another copy of the same app (another --corpus, an earlier round) uses
      # the same ones. Refuse instead of loading the schema over its data.
      if conf.fetch(:services, []).intersect?(%w[postgresql mysql]) && db_tasks.first == "db:create"
        puts "+ bundle exec rails db:create (in #{dir.delete_prefix(ROOT + "/")})"
        out, status = Open3.capture2e(env, "bundle", "exec", "rails", "db:create", chdir: dir)
        print out
        raise "#{app}: db:create failed" unless status.success?
        if (existing = out.scan(/^Database '([^']+)' already exists/).flatten).any?
          raise "#{app}: #{existing.join(", ")} already exist on the shared server, so another copy may use them. " \
            "Drop them first if they are disposable."
        end
        sh(env, "bundle", "exec", "rails", *db_tasks.drop(1), chdir: dir)
      else
        sh(env, "bundle", "exec", "rails", *db_tasks, chdir: dir)
      end
      conf.fetch(:build, []).each { sh(env, *_1, chdir: dir) }
      sh(env, "bundle", "exec", "rails", "assets:precompile", chdir: dir) unless conf[:assets] == false
      conf.fetch(:after_assets, []).each { sh(env, *_1, chdir: dir) }
      sh(env.merge("CENSUS_MODE" => "interpreter"), "bundle", "exec", "ruby", HARNESS, "prepare", app, chdir: dir)
      sh(env.merge("CENSUS_MODE" => "interpreter"), "bundle", "exec", "ruby", HARNESS, "list", app, chdir: dir)
    end
  end

  def list(opts)
    bin = ruby_bin(opts[:ruby])
    check_services(opts[:apps])
    opts[:apps].each do |app|
      rails = state(opts[:corpus], app).fetch("base")
      gemfile = variant(opts[:corpus], app, rails, bin)
      sh(env_for(app, bin, rails, gemfile).merge("CENSUS_MODE" => "interpreter"), "bundle", "exec", "ruby", HARNESS,
        "list", app, chdir: app_dir(opts[:corpus], app))
    end
  end

  def run(opts)
    labels = opts[:aa] ? [opts.fetch(:label), "#{opts[:label]}2"] : [opts.fetch(:label)]
    bin = ruby_bin(opts[:ruby])
    ruby = ruby_description(bin)
    check_services(opts[:apps])
    bases = opts[:apps].map { state(opts[:corpus], _1).fetch("base") }.uniq { _1.fetch("sha") }
    raise "apps were set up on different Rails bases" unless bases.one?
    rails = opts[:rails] ? resolve_rails(opts[:rails]) : bases.first
    gems = opts[:gems].transform_values { |spec| resolve_rails(spec, nil) }
    # Bundle everything before measuring; no bundle command runs during a run.
    gemfiles = opts[:apps].to_h { [_1, variant(opts[:corpus], _1, rails, bin, gems)] }
    locks = opts[:apps].to_h do |app|
      base_lock = File.join(app_dir(opts[:corpus], app), "Gemfile.census-#{bases.first.fetch("sha")[0, 12]}.lock")
      variant(opts[:corpus], app, bases.first, bin) unless File.exist?(base_lock)
      [app, lock_outside_rails(gemfiles[app] + ".lock", gems.keys) == lock_outside_rails(base_lock, gems.keys)]
    end
    locks.each { |app, same| warn "#{app}: dependencies outside Rails differ from the base lock" unless same }
    labels.product(opts[:modes], opts[:apps]).each do |label, mode, app|
      json = File.join(opts[:out], label, "#{app}-#{mode}.json")
      raise "fresh output required: #{json}" if File.exist?(json)
    end
    labels.each do |label|
      out = File.join(opts[:out], label)
      FileUtils.mkdir_p(out)
      meta_path = File.join(out, "meta.json")
      meta = File.exist?(meta_path) ? JSON.parse(File.read(meta_path)) : { "label" => label, "rails" => rails, "gems" => gems, "ruby" => ruby, "runs" => [] }
      raise "#{label} was run with #{meta["rails"]["sha"]} / #{meta["ruby"]}" unless meta["rails"]["sha"] == rails["sha"] && meta["ruby"] == ruby
      raise "#{label} was run with gems #{meta["gems"]}" unless meta.fetch("gems", {}).transform_values { _1["sha"] } == gems.transform_values { _1["sha"] }
      # Configurations that share a copy (APP-nops) share its database, so
      # they never run at the same time.
      copy_locks = opts[:apps].to_h { [app_dir(opts[:corpus], _1), Mutex.new] }
      opts[:modes].each do |mode|
        queue = Queue.new
        opts[:apps].each { queue << _1 }
        failed = Queue.new
        Array.new([opts[:jobs], opts[:apps].size].min) do
          Thread.new do
            while (app = (queue.pop(true) rescue nil))
              json = File.join(out, "#{app}-#{mode}.json")
              env = env_for(app, bin, rails, gemfiles[app]).merge("CENSUS_MODE" => mode, "CENSUS_ONLY" => opts[:only])
              begin
                copy_locks[app_dir(opts[:corpus], app)].synchronize do
                  sh(env, "bundle", "exec", "ruby", *FLAGS.fetch(mode), HARNESS, "profile", app, json,
                    chdir: app_dir(opts[:corpus], app), log: json.sub(/\.json\z/, ".log"))
                end
              rescue RuntimeError
                failed << app # one app's failure does not stop the others in this mode
              end
            end
          end
        end.each(&:join)
        failures = Array.new(failed.size) { failed.pop }
        raise "#{label} #{mode}: #{failures.sort.join(", ")} failed; see their .log files" if failures.any?
      end
      meta["runs"] << { "apps" => opts[:apps], "modes" => opts[:modes], "only" => opts[:only], "dependencies_outside_rails_match_base" => locks,
        "finished" => Time.now.utc.iso8601 }
      File.write(meta_path, JSON.pretty_generate(meta) + "\n")
      puts "#{label}: #{opts[:modes].size * opts[:apps].size} runs in #{out.delete_prefix(ROOT + "/")}"
    end
  end

  def ranked(opts)
    runs = CensusRank.load_runs(File.join(opts[:out], opts.fetch(:label)), opts[:mode])
    raise "no #{opts[:mode]} runs for #{opts[:label]} in #{opts[:out]}" if runs.empty?
    site = opts[:gem] && CensusRank.gem_site(opts[:gem])
    [runs, CensusRank.rows(runs, tiers: opts[:tiers], **(site ? { site: site } : {}))]
  end

  def rank(opts)
    runs, rows = ranked(opts)
    tsv = File.join(opts[:out], "rank-#{opts[:label]}-#{opts[:mode]}#{"-#{opts[:gem]}" if opts[:gem]}.tsv")
    File.write(tsv, CensusRank.tsv(rows))
    print opts[:tsv] ? CensusRank.tsv(rows) : CensusRank.text(runs, rows, opts[:mode], opts[:limit])
    warn "full ranking: #{tsv.delete_prefix(ROOT + "/")}"
  end

  def describe(out, label)
    meta = File.join(out, label.split(":").first, "meta.json")
    return "#{label}: (no meta.json)" unless File.exist?(meta)
    m = JSON.parse(File.read(meta))
    gems = m.fetch("gems", {}).map { |name, g| ", #{name} #{g["spec"]} #{g["sha"][0, 10]}" }.join
    "#{label}: Rails #{m["rails"]["spec"]} #{m["rails"]["sha"][0, 10]}#{gems}, #{m["ruby"]}"
  end

  def compare(opts, labels)
    base = opts.fetch(:base)
    raise "compare needs at least one LABEL or --aa L0" if labels.empty? && !opts[:aa].is_a?(String)
    puts([base, opts[:aa], *labels].compact.map { describe(opts[:out], _1) })
    if opts[:markdown]
      columns = (opts[:aa] ? [[opts[:aa], base]] : []) + labels.map { [base, _1] }
      print CensusCompare.markdown(opts[:out], columns, (opts[:aa] ? ["A/A"] : []) + labels, opts[:modes])
      return
    end
    if opts[:aa]
      puts "-- A/A control (#{base} - #{opts[:aa]}): the noise floor for every comparison below"
      print CensusCompare.report(opts[:out], opts[:aa], [base], detail: opts[:detail])
    end
    print CensusCompare.report(opts[:out], base, labels, detail: opts[:detail]) unless labels.empty?
  end

  # Runs a controls script (SQL/result snapshots, e.g. census_5_controls.rb)
  # under each label's Rails in one SQLite app's bundle; every output must
  # equal the first label's.
  def controls(opts, labels)
    raise "controls needs BASE and at least one LABEL" if labels.size < 2
    script = File.expand_path(opts.fetch(:script))
    app = opts[:app]
    bin = ruby_bin(opts[:ruby])
    dir = File.join(opts[:out], "controls")
    FileUtils.mkdir_p(dir)
    outputs = labels.to_h do |label|
      rails = JSON.parse(File.read(File.join(opts[:out], label, "meta.json"))).fetch("rails")
      gemfile = variant(opts[:corpus], app, rails, bin)
      [label, opts[:modes].to_h do |mode|
        out = capture(env_for(app, bin, rails, gemfile), "bundle", "exec", "ruby", *FLAGS.fetch(mode), script,
          chdir: app_dir(opts[:corpus], app))
        File.write(File.join(dir, "#{File.basename(script, ".rb")}-#{label}-#{mode}.txt"), out + "\n")
        [mode, out]
      end]
    end
    base = labels.first
    failed = false
    labels.drop(1).each do |label|
      opts[:modes].each do |mode|
        a = outputs[base][mode].lines
        b = outputs[label][mode].lines
        diff = a.zip(b).each_with_index.reject { |(x, y), _| x == y }
        diff << [[nil, nil], a.size] if a.size != b.size
        failed ||= diff.any?
        puts format("%-24s %-11s %s", label, mode, diff.empty? ? "identical to #{base} (#{a.size} lines)" : "DIFFERS from #{base} at #{diff.size} lines")
        diff.first(5).each { |(x, y), i| puts "  #{i + 1}: #{base}: #{x&.chomp}\n  #{i + 1}: #{label}: #{y&.chomp}" }
      end
    end
    exit 1 if failed
  end

  # -- Rails main watch (docs/upstream/rails-main-watch/README.md) ------------

  # The census's ten configurations; the PG census apps are not part of the watch.
  WATCH_APPS = %w[blog campfire writebook fizzy fizzy-mysql codetriage pingcrm redprints-cfp react-starter-kit lobsters].freeze
  WATCH_CONTROLS = %w[bench/upstream/census/watch_controls.rb bench/upstream/census_5_controls.rb
    bench/upstream/census_4_controls.rb].freeze

  def watch_repo
    dir = File.join(ROOT, ".corpus/rails-watch.git")
    system("git", "clone", "--quiet", "--bare", "https://github.com/rails/rails.git", dir, exception: true) unless File.exist?(dir)
    system("git", "-C", dir, "fetch", "--quiet", "origin", "+refs/heads/main:refs/heads/main", exception: true)
    CensusWatch::Repo.new(dir)
  end

  def watch_labels(sha) = ["w-#{sha[0, 12]}", "w-#{sha[0, 12]}2"]

  def watch_rails(sha) = { "spec" => "rails/rails@#{sha}", "source" => %(github: "rails/rails"), "ref" => sha, "sha" => sha }

  # The A/A pair at SHA, trimmed, run now unless both labels are complete
  # (an orb that lost them re-measures the baseline commit).
  def watch_pair(opts, sha)
    labels = watch_labels(sha)
    files = labels.product(opts[:modes], opts[:apps]).map { |l, m, a| File.join(opts[:out], l, "#{a}-#{m}.json") }
    run(opts.merge(label: labels.first, aa: true, rails: "rails/rails@#{sha}")) unless files.all? { File.exist?(_1) }
    meta = JSON.parse(File.read(File.join(opts[:out], labels.first, "meta.json")))
    { "rails" => sha, "ruby" => meta["ruby"], "apps" => opts[:apps], "modes" => opts[:modes],
      "runs" => labels.map do |l|
        opts[:modes].to_h { |m| [m, opts[:apps].to_h { |a| [a, CensusWatch.trim(JSON.parse(File.read(File.join(opts[:out], l, "#{a}-#{m}.json"))))] }] }
      end }
  end

  # Drops what this run measured, except head and the copies' own base: the
  # previous base's labels, bisect receipts, and the variant Gemfiles and Rails
  # checkouts of base and bisect commits (64 MB each).
  def watch_prune(opts, base, head)
    keep = [head, state(opts[:corpus], opts[:apps].first).dig("base", "sha")].map { _1[0, 12] }
    measured = [base[0, 12], *Dir[File.join(opts[:out], "watch-bisect", "*")].map { File.basename(_1) },
      *Dir[File.join(opts[:out], "watch-controls", "*.txt")].map { File.basename(_1)[0, 12] }].uniq - keep
    FileUtils.rm_rf(watch_labels(base).map { File.join(opts[:out], _1) }) unless base == head
    FileUtils.rm_rf(File.join(opts[:out], "watch-bisect"))
    FileUtils.rm_f(Dir[File.join(opts[:out], "watch-controls", "*.txt")].reject { keep.include?(File.basename(_1)[0, 12]) })
    gems = capture(File.join(ruby_bin(opts[:ruby]), "ruby"), "-e", "print Gem.dir")
    measured.each do |sha12|
      FileUtils.rm_f(Dir[File.join(ROOT, ".corpus", "#{opts[:corpus]}-*", "Gemfile.census-#{sha12}{,.lock}")])
      FileUtils.rm_rf(File.join(gems, "bundler/gems/rails-#{sha12}"))
    end
  end

  # One workload at SHA in its own process (bisect steps), trimmed and cached.
  def watch_measure(opts, sha, app, mode, workload)
    dir = File.join(opts[:out], "watch-bisect", sha[0, 12])
    json = File.join(dir, "#{app}-#{mode}-#{Digest::SHA256.hexdigest(workload)[0, 12]}.json")
    unless File.exist?(json)
      FileUtils.mkdir_p(dir)
      rails = watch_rails(sha)
      bin = ruby_bin(opts[:ruby])
      env = env_for(app, bin, rails, variant(opts[:corpus], app, rails, bin)).merge("CENSUS_MODE" => mode, "CENSUS_ONLY" => workload)
      sh(env, "bundle", "exec", "ruby", *FLAGS.fetch(mode), HARNESS, "profile", app, json,
        chdir: app_dir(opts[:corpus], app), log: json.sub(/\.json\z/, ".log"))
    end
    CensusWatch.trim(JSON.parse(File.read(json))).fetch(workload)
  end

  # Output of a controls script at SHA (interpreter, blog's bundle), cached per run number.
  def watch_control(opts, sha, script, n = 1)
    path = File.join(opts[:out], "watch-controls", "#{sha[0, 12]}-#{File.basename(script, ".rb")}-#{n}.txt")
    return File.read(path) if File.exist?(path)
    rails = watch_rails(sha)
    bin = ruby_bin(opts[:ruby])
    out = capture(env_for(opts[:app], bin, rails, variant(opts[:corpus], opts[:app], rails, bin)), "bundle", "exec", "ruby",
      File.join(ROOT, script), chdir: app_dir(opts[:corpus], opts[:app])) + "\n"
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, out)
    out
  end

  # First commit in COMMITS (oldest first; the last satisfies test) for which test holds.
  def watch_bisect(commits, test)
    lo, hi = -1, commits.size - 1
    while hi - lo > 1
      mid = (lo + hi) / 2
      test.(commits[mid]) ? hi = mid : lo = mid
    end
    commits[hi]
  end

  # The first-parent commit (merge) that flips test, then the commit inside it.
  def watch_attribute(repo, fps, test)
    merge = watch_bisect(fps, test)
    parents = repo.parents(merge)
    inner = parents.size == 2 ? repo.git("rev-list", "--reverse", "--first-parent", parents[1], "^#{parents[0]}").split : []
    commit = if inner.one? then inner.first
    elsif inner.size > 1 && test.(inner.last) then watch_bisect(inner, test)
    else merge
    end
    { merge:, commit:, by: "bisect" }
  end

  # A range of one commit, or one merge of a one-commit branch, needs no bisection.
  def watch_only(repo, fps)
    return nil unless fps.one?
    parents = repo.parents(fps.first)
    inner = parents.size == 2 ? repo.git("rev-list", "--first-parent", parents[1], "^#{parents[0]}").split : [fps.first]
    { merge: fps.first, commit: inner.first, by: "only commit in range" } if inner.one?
  end

  # Isolated value of METRIC (a lambda over the trimmed workload) at base and
  # head; test(c) is whether c is past the midpoint. nil when the move does not
  # reproduce in a one-workload process.
  def watch_metric_test(opts, row, base, head, metric)
    value = ->(sha) { metric.(watch_measure(opts, sha, row[:app], row[:mode], row[:workload])) }
    vb, vh = value.(base), value.(head)
    return nil if (vh - vb).abs < [1.0, row[:delta].abs / 2].max || (vh - vb).positive? != row[:delta].positive?
    ->(sha) { ((value.(sha) - vb) * (vh <=> vb)) > (vh - vb).abs / 2 }
  end

  def watch_sha_link(sha) = "[`#{sha[0, 10]}`](https://github.com/rails/rails/commit/#{sha})"

  def watch_attribution(repo, a)
    return "not reproduced in a one-workload process" if a.nil?
    return a if a.is_a?(String)
    pr = repo.pr(a[:merge])
    commit = a[:commit] == a[:merge] ? "" : " #{watch_sha_link(a[:commit])} “#{repo.subject(a[:commit])[0, 70]}”"
    "#{pr ? "[##{pr}](https://github.com/rails/rails/pull/#{pr})" : watch_sha_link(a[:merge])}#{commit} (#{a[:by]})"
  end

  def watch(opts)
    opts = opts.merge(apps: WATCH_APPS) unless opts[:apps_given]
    dir = opts[:watch_dir]
    data = File.join(dir, "data")
    FileUtils.mkdir_p(data)
    baseline_path = File.join(dir, "baseline.json")
    baseline = File.exist?(baseline_path) ? JSON.parse(File.read(baseline_path)) : {}
    repo = watch_repo
    head = repo.git("rev-parse", opts[:head] || "main").strip
    base = repo.git("rev-parse", opts[:base] || baseline["rails"] || raise("no baseline; pass --base SHA")).strip
    if base == head && baseline["rails"] == base
      puts "WATCH: rails/rails main unchanged at #{base[0, 10]}; nothing to measure"
      return
    end
    check_services(opts[:apps])
    b = watch_pair(opts, base)
    h = watch_pair(opts, head)
    floors_path = File.join(data, "floors.json")
    floors = File.exist?(floors_path) ? JSON.parse(File.read(floors_path)) : {}
    result = CensusWatch.compare(repo, b, h, floors)
    fps = repo.first_parents(base, head)

    # Behavior controls: two runs at each end; lines that differ within a pair are dropped.
    controls = WATCH_CONTROLS.to_h do |script|
      outs = [[base, 1], [base, 2], [head, 1], [head, 2]].map { |sha, n| watch_control(opts, sha, script, n) }
      [script, CensusWatch.control_diff(*outs)]
    end

    # Attribution: blame for lines added in the range; bisect over main's first
    # parents (then inside the merged branch) for everything else.
    budget = opts[:bisect]
    grown = CensusWatch.site_rows(result[:sites], grown: true)
    shrunk = CensusWatch.site_rows(result[:sites], grown: false)
    only = watch_only(repo, fps)
    attributed = {}
    (grown + shrunk).each do |row|
      if only
        attributed[row[:key]] = only
      elsif row[:new]
        file, line = row[:head_key].delete_prefix("RAILS/").split(/:(?=\d+\z)/)
        commit = repo.blame(head, file, Integer(line))
        attributed[row[:key]] = { merge: repo.landed_by(fps, commit) || commit, commit:, by: "blame" }
      elsif !row[:net]
        attributed[row[:key]] = "moved within its file"
      elsif budget.positive?
        budget -= 1
        r = row[:max]
        file = CensusWatch.file_of(row[:key])
        test = watch_metric_test(opts, r, base, head, ->(w) { w["sites"].sum { |k, v| k.start_with?(file + ":") ? v : 0 } })
        attributed[row[:key]] = test && watch_attribute(repo, fps, test)
      else
        attributed[row[:key]] = "not bisected (--bisect budget)"
      end
    end
    result[:workloads].sort_by { -_1[:delta].abs }.each do |r|
      sites = result[:sites].select { |s| s.values_at(:mode, :app, :workload) == r.values_at(:mode, :app, :workload) && s[:key].start_with?("RAILS/") }
      # The largest line that moved the same way and is already attributed.
      if (s = sites.select { (_1[:delta] > 0) == (r[:delta] > 0) && attributed[_1[:key]].is_a?(Hash) }.max_by { _1[:delta].abs })
        r[:attribution] = attributed[s[:key]].merge(by: "via #{s[:head_key] || s[:key]}")
      elsif only
        r[:attribution] = only
      elsif budget.positive?
        budget -= 1
        test = watch_metric_test(opts, r, base, head, ->(w) { w["traced"] })
        r[:attribution] = test && watch_attribute(repo, fps, test)
      else
        r[:attribution] = "not bisected (--bisect budget)"
      end
    end
    result[:sql].each do |r|
      digest = ->(sha) { watch_measure(opts, sha, r[:app], r[:mode], r[:workload]).dig("sql", "digest") }
      # Bisect only when a one-workload process reproduces both ends' digests.
      r[:attribution] = if digest.(head) != r[:head]["digest"] || digest.(base) != r[:base]["digest"] then nil
      elsif only then only
      elsif budget.positive?
        budget -= 1
        watch_attribute(repo, fps, ->(sha) { digest.(sha) != digest.(base) })
      else "not bisected (--bisect budget)"
      end
    end
    controls.each do |script, diff|
      keys = diff[:changed].map { |pair| pair.compact.first[/\A(.*?) => /, 1] }
      lines = ->(sha) { watch_control(opts, sha, script).lines.map(&:chomp) }
      base_lines = lines.(base)
      diff[:attribution] = if keys.empty? then nil
      elsif only then only
      else
        watch_attribute(repo, fps, ->(sha) { (lines.(sha) - base_lines).any? { |l| keys.include?(l[/\A(.*?) => /, 1]) } })
      end
    end

    # Records: the report, its trimmed receipts, floors and the new baseline.
    date = Time.now.utc.strftime("%Y-%m-%d")
    name = File.exist?(File.join(dir, "#{date}.md")) ? "#{date}-#{head[0, 10]}" : date
    path = File.join(dir, "#{name}.md")
    receipts = File.join(data, "#{name}.json.gz")
    CensusWatch.write_receipts(receipts, CensusWatch.receipts(b, h, result, attributed, controls))
    File.write(floors_path, JSON.pretty_generate(floors.merge(result[:floors]) { |_, x, y| [x, y].max }.sort.to_h) + "\n")
    report = watch_report(repo, b, h, fps, result, grown, shrunk, attributed, controls, receipts.delete_prefix(dir + "/"))
    File.write(path, report)
    File.write(baseline_path, JSON.pretty_generate("rails" => head, "ruby" => h["ruby"], "report" => File.basename(path),
      "recorded" => Time.now.utc.iso8601) + "\n")
    watch_prune(opts, base, head)
    # An SQL diff counts when a one-workload process reproduces it or both modes show it.
    sql_real = result[:sql].select { |r| r[:attribution].is_a?(Hash) || result[:sql].count { _1.values_at(:app, :workload) == r.values_at(:app, :workload) } > 1 }
    moved = result[:workloads].any? || grown.any? { _1[:net] } || sql_real.any? || controls.values.any? { _1[:changed].any? }
    puts report
    puts "WATCH: #{moved ? "MOVED" : "quiet"} #{base[0, 10]}..#{head[0, 10]} (#{path.delete_prefix(ROOT + "/")})"
  end

  def watch_report(repo, b, h, fps, result, grown, shrunk, attributed, controls, receipts)
    base, head = b["rails"], h["rails"]
    fmt = ->(v) { format("%+.1f", v).sub("-", "−") }
    head_link = ->(key) { file, line = key.delete_prefix("RAILS/").split(/:(?=\d+\z)/); "[`#{file.sub(%r{\A\w+/lib/}, "")}:#{line}`](https://github.com/rails/rails/blob/#{head}/#{file}#L#{line})" }
    base_link = ->(key) { file, line = key.delete_prefix("RAILS/").split(/:(?=\d+\z)/); "[`#{file.sub(%r{\A\w+/lib/}, "")}:#{line}`](https://github.com/rails/rails/blob/#{base}/#{file}#L#{line})" }
    real_grown = grown.select { _1[:net] }
    o = []
    o << "# Rails main watch, #{Time.now.utc.strftime("%Y-%m-%d")}" << ""
    o << "Range: [`#{base[0, 10]}...#{head[0, 10]}`](https://github.com/rails/rails/compare/#{base}...#{head}), " \
      "#{fps.size} first-parent commits on main (#{fps.count { repo.pr(_1) }} PRs). #{h["ruby"].split(" ").first(2).join(" ")}, " \
      "#{h["apps"].size} configurations, #{h["modes"].join(" and ")}, each end measured twice (A/A)."
    o << "" << "**#{[
      "#{result[:workloads].size} workloads moved beyond A/A",
      "#{real_grown.size} Rails lines grew (#{grown.size - real_grown.size} more moved within their file)",
      "#{shrunk.count { _1[:net] }} shrank (#{shrunk.count { !_1[:net] }} more moved)",
      "#{result[:sql].size} SQL diffs",
      "#{controls.values.sum { _1[:changed].size }} behavior-control diffs",
    ].join("; ")}.**"
    if result[:workloads].any?
      o << "" << "## Workloads moved beyond A/A" << ""
      o << "Grouped by attribution; every workload is in the receipts." << ""
      o << "| Attributed to | Workloads (interp / YJIT) | Apps | Median Δ | Largest |" << "| --- | ---: | ---: | ---: | --- |"
      result[:workloads].group_by { watch_attribution(repo, _1[:attribution]).sub(/ \([^()]*\)\z/, "") }
        .sort_by { |_, rows| -rows.size }.each do |label, rows|
        counts = %w[interpreter yjit].map { |m| rows.count { _1[:mode] == m } }.join(" / ")
        top = rows.max_by { _1[:delta].abs }
        o << "| #{label} | #{counts} | #{rows.map { _1[:app].sub(/-mysql\z/, "") }.uniq.size} | " \
          "#{fmt.(CensusWatch.median(rows.map { _1[:delta] }))} | #{fmt.(top[:delta])} #{top[:app]} #{top[:mode]} #{top[:workload]} (floor #{top[:floor]}) |"
      end
    end
    if grown.any?
      o << "" << "## Rails lines that grew" << ""
      o << "Per traced operation; *net file* is the line's file over the same workload, so a line whose allocation only " \
        "moved within its file shows a net of about zero." << ""
      o << "| Line at head | Apps | Workloads | Max Δ (workload) | Net file Δ | Attributed to |" << "| --- | ---: | ---: | --- | ---: | --- |"
      grown.first(15).each do |row|
        m = row[:max]
        line = row[:head_key] ? head_link.(row[:head_key]) : base_link.(row[:key])
        o << "| #{line}#{" (new)" if row[:new]} | #{row[:apps].size} | #{row[:rows].size} | #{fmt.(m[:delta])} (#{m[:app]} #{m[:mode]} #{m[:workload]}) | " \
          "#{fmt.(m[:file_delta])} | #{watch_attribution(repo, attributed[row[:key]])} |"
      end
      o << "" << "(#{grown.size - 15} more in the receipts.)" if grown.size > 15
    end
    if shrunk.any?
      o << "" << "## Rails lines that shrank" << ""
      shrunk.first(10).each do |row|
        m = row[:max]
        o << "* #{base_link.(row[:key].sub(":+", ":"))}: #{row[:apps].size} apps, #{row[:rows].size} workloads, up to #{fmt.(m[:delta])} " \
          "(#{m[:app]} #{m[:mode]} #{m[:workload]}, net file #{fmt.(m[:file_delta])}); #{watch_attribution(repo, attributed[row[:key]])}"
      end
    end
    o << "" << "## Behavior controls" << ""
    o << "SQL: #{result[:sql].size} workloads changed their masked SQL digest with both A/A pairs stable; " \
      "#{result[:sql_unstable].size} differ within an A/A pair and are not judged."
    result[:sql].each do |r|
      o << "* SQL #{r[:mode]} #{r[:app]} #{r[:workload]}: #{r[:base]["queries_per_op"]} → #{r[:head]["queries_per_op"]} queries/op, " \
        "#{watch_attribution(repo, r[:attribution] || "differs only in the full run")}"
    end
    controls.each do |script, d|
      o << "* `#{File.basename(script)}`: #{d[:changed].size} of #{d[:lines]} lines differ (#{d[:noisy]} unstable within a pair, ignored)" \
        "#{d[:changed].any? ? "; #{watch_attribution(repo, d[:attribution])}" : ""}"
      d[:changed].first(8).each { |x, y| o << "  * `#{x || "(absent)"}` → `#{(y || "(absent)").sub(/\A.*? => /, "")}`" }
    end
    o << "" << "## A/A floor" << ""
    o << "| Mode | Workloads | Base A/A ≤ −1 / ≥ +1 | Head A/A ≤ −1 / ≥ +1 |" << "| --- | ---: | ---: | ---: |"
    result[:aa].each { |mode, (n, b1, b2, h1, h2)| o << "| #{mode} | #{n} | #{b1} / #{b2} | #{h1} / #{h2} |" }
    o << "" << "A workload or line counts as moved only when all four base×head deltas clear the floor in the same direction: " \
      "the largest A/A difference of that workload in either pair or any earlier watch run (`data/floors.json`), and at least one object."
    if fps.any?
      o << "" << "<details><summary>Commits in range</summary>" << ""
      fps.reverse.each { |c| o << "* #{watch_sha_link(c)} #{repo.subject(c)[0, 100]}" }
      o << "" << "</details>"
    end
    o << "" << "Receipts: [`#{receipts}`](#{receipts}) (trimmed: every workload's census value, traced objects and SQL digest in " \
      "all four runs, every moved line, control diffs and attributions). Command: `script/census watch`."
    o.join("\n") + "\n"
  end

  OPEN_PRS = <<~GRAPHQL
    query($endCursor: String) {
      repository(owner: "rails", name: "rails") {
        pullRequests(states: OPEN, first: 50, after: $endCursor) {
          nodes { number title url isDraft author { login } files(first: 100) { nodes { path } } }
          pageInfo { hasNextPage endCursor }
        }
      }
    }
  GRAPHQL

  def open_prs(cache, refresh)
    if refresh || !File.exist?(cache)
      jq = ".data.repository.pullRequests.nodes[] | {number, title, url, draft: .isDraft, author: .author.login, files: [.files.nodes[].path]}"
      lines = capture("gh", "api", "graphql", "--paginate", "-f", "query=#{OPEN_PRS}", "--jq", jq)
      FileUtils.mkdir_p(File.dirname(cache))
      File.write(cache, JSON.pretty_generate("fetched" => Time.now.utc.iso8601, "prs" => lines.lines.map { JSON.parse(_1) }) + "\n")
    end
    data = JSON.parse(File.read(cache))
    warn "open rails/rails PRs fetched #{data["fetched"]} (#{data["prs"].size}); --refresh to refetch"
    data
  end

  # Old-side hunk ranges per file, fetched once per PR and kept in the cache.
  def hunks(pr)
    pr["hunks"] ||= capture("gh", "api", "--paginate", "repos/rails/rails/pulls/#{pr["number"]}/files", "--jq", ".[] | {filename, patch}")
      .lines.map { JSON.parse(_1) }
      .to_h { |f| [f["filename"], (f["patch"] || "").scan(/^@@ -(\d+)(?:,(\d+))?/).map { |a, b| [Integer(a), Integer(b || 1)] }] }
  end

  # Open PRs whose diff covers a top-ranked line (hunk ranges on the PR's own
  # base, so approximate), and how many more only touch the same file.
  def prs(opts)
    _, rows = ranked(opts)
    top = rows.first(opts[:top]).each_with_index.map { |r, i| [i + 1, r] }
    cache = File.join(opts[:out], "open-rails-prs.json")
    data = open_prs(cache, opts[:refresh])
    by_file = Hash.new { |h, k| h[k] = [] }
    data["prs"].each { |pr| pr["files"].each { by_file[_1] << pr } }
    on_line = {}
    on_file = {}
    top.each do |rank, r|
      file, line = r[:site].split(/:(?=\d+\z)/)
      prs = by_file[file].sort_by { _1["number"] }
      hit, rest = prs.partition { |pr| hunks(pr).fetch(file, []).any? { |start, len| Integer(line).between?(start, start + len - 1) } }
      hit.each { on_line[_1["number"]] = true }
      rest.each { on_file[_1["number"]] = true }
      next if prs.empty?
      puts format("%3d %-70s apps %d mean %6.2f", rank, r[:site][0, 70], r[:apps], r[:mean])
      hit.each { puts "      line: ##{_1["number"]} #{_1["title"][0, 80]} (#{_1["author"]}#{", draft" if _1["draft"]})" }
      puts "      file: #{rest.size} more (#{rest.first(8).map { "##{_1["number"]}" }.join(" ")}#{" ..." if rest.size > 8})" if rest.any?
    end
    File.write(cache, JSON.pretty_generate(data) + "\n")
    puts "#{on_line.size} open PRs change a top-#{top.size} #{opts[:label]} #{opts[:mode]} line; " \
      "#{(on_file.keys - on_line.keys).size} more only touch the same files"
  end

  def main(argv)
    command = argv.shift
    opts = { corpus: "census", out: File.join(ROOT, ".lowrail/private/census"), ruby: "4.0.7", apps: APPS.keys,
      modes: %w[interpreter yjit], mode: "interpreter", limit: 60, tiers: CensusRank::TIERS, top: 40, jobs: 1,
      app: "blog", overlays: OVERLAYS, bisect: 20, watch_dir: File.join(ROOT, "docs/upstream/rails-main-watch"), gems: {} }
    parser = OptionParser.new do |o|
      o.banner = File.read(__FILE__).lines.drop(3).take_while { _1.start_with?("#") }.map { _1.delete_prefix("# ").delete_prefix("#") }.join
      o.on("--rails SPEC") { opts[:rails] = _1 }
      o.on("--ruby R") { opts[:ruby] = _1 }
      o.on("--gem NAME[=SPEC]", "run: pin gem NAME to OWNER/REPO@REF; rank: rank NAME's lines") do |v|
        name, spec = v.split("=", 2)
        spec ? opts[:gems][name] = spec : opts[:gem] = name
      end
      o.on("--apps LIST", "comma-separated, or all (default)") { opts[:apps] = apps_option(_1); opts[:apps_given] = true }
      o.on("--app APP", "controls: SQLite app whose bundle runs the script (default blog)") { opts[:app] = _1 }
      o.on("--corpus NAME") { opts[:corpus] = _1 }
      o.on("--overlays DIR", "setup: dependency overlays (default fixtures/corpus/rails-main-census-4)") { opts[:overlays] = File.expand_path(_1) }
      o.on("--out DIR") { opts[:out] = File.expand_path(_1) }
      o.on("--label L") { opts[:label] = _1 }
      o.on("--aa [L0]", "run: also run L2, the A/A twin; compare: the A/A twin of --base") { opts[:aa] = _1 || true }
      o.on("--modes LIST", "interp,yjit,zjit") { |v| opts[:modes] = v.split(",").map { MODES.fetch(_1) } }
      o.on("--mode M") { opts[:mode] = MODES.fetch(_1) }
      o.on("--only WORKLOADS", "run: comma-separated workload names") { opts[:only] = _1 }
      o.on("--jobs N", Integer, "run: apps measured in parallel per mode (default 1)") { opts[:jobs] = _1 }
      o.on("--limit N", Integer) { opts[:limit] = _1 }
      o.on("--tiers LIST", "rank: app-count tier floors (default 7,5,3,2)") { |v| opts[:tiers] = v.split(",").map { Integer(_1) } }
      o.on("--tsv") { opts[:tsv] = true }
      o.on("--base L", "compare: base label; watch: Rails commit to compare against (default: the recorded baseline)") { opts[:base] = _1 }
      o.on("--detail") { opts[:detail] = true }
      o.on("--markdown") { opts[:markdown] = true }
      o.on("--script FILE") { opts[:script] = _1 }
      o.on("--top N", Integer) { opts[:top] = _1 }
      o.on("--refresh") { opts[:refresh] = true }
      o.on("--head SHA", "watch: Rails commit to measure (default: rails/rails main)") { opts[:head] = _1 }
      o.on("--bisect N", Integer, "watch: most bisections per run (default 20)") { opts[:bisect] = _1 }
      o.on("--watch-dir DIR", "watch: reports and receipts (default docs/upstream/rails-main-watch)") { opts[:watch_dir] = File.expand_path(_1) }
    end
    rest = parser.parse(argv)
    case command
    when "setup" then setup(opts)
    when "run" then run(opts)
    when "list" then list(opts)
    when "rank" then rank(opts)
    when "compare" then compare(opts, rest)
    when "controls" then controls(opts, rest)
    when "prs" then prs(opts)
    when "watch" then watch(opts)
    else abort parser.help
    end
  end
end

Census.main(ARGV.dup) if $PROGRAM_NAME == __FILE__

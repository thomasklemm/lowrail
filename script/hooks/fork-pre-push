#!/usr/bin/env bash
# Lowrail fork-pre-push, installed into an upstream checkout by Lowrail's script/install-fork-hooks.
# Refuses to push a commit that no remote has yet when it has an Amp trailer or isn't authored and committed by
# Thomas Klemm (DECISIONS, Commit identity). Commits already on a remote, such as other contributors', pass.
set -euo pipefail
ident="Thomas Klemm <github@tklemm.eu>"
refused=0
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha =~ ^0+$ ]] && continue
  exclude=(--not --remotes)
  git cat-file -e "$remote_sha^{commit}" 2>/dev/null && exclude+=("$remote_sha")
  for commit in $(git rev-list "$local_sha" "${exclude[@]}"); do
    what=$(git log -1 --format='%h %s' "$commit")
    if git log -1 --format=%B "$commit" |
       grep -qiE '^(Amp-Thread-ID:|Co-authored-by:[[:space:]]*Amp[[:space:]]*<|Co-authored-by:.*<amp@ampcode\.com>)'; then
      echo "pre-push: $what has an Amp trailer; rebuild it without one (Lowrail's script/commit --amend for HEAD)" >&2
      refused=1
    fi
    for who in author committer; do
      format=$([ $who = author ] && echo '%an <%ae>' || echo '%cn <%ce>')
      actual=$(git log -1 --format="$format" "$commit")
      if [ "$actual" != "$ident" ]; then
        echo "pre-push: $what has $who $actual, not $ident" >&2
        refused=1
      fi
    done
  done
done
exit "$refused"

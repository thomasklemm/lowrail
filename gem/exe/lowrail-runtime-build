#!/usr/bin/env ruby
# frozen_string_literal: true

# Private build protocol: one request on stdin, one result per selected pass
# on stdout. Builders read the booted app but never write build artifacts.
require "json"
request = JSON.parse($stdin.read)
output = $stdout.dup
$stdout.reopen($stderr) # App initializers/loggers must not corrupt the JSON.
ENV["LOWRAIL"] = "0"
ENV["RAILS_ENV"] ||= "test"
require_relative "../lib/lowrail/build_jit"
if request["verification_test"]
  require_relative "../lib/lowrail/test_certificate_build"
  Lowrail::TestCertificateBuild.run(request, output)
  exit
end
mode = Lowrail::BuildJit.prepare(request["certification_jit"])
require File.expand_path("config/environment", Dir.pwd)
Rails.application.eager_load!
Lowrail::BuildJit.check(mode)
require_relative "../lib/lowrail/prism_grammar"
results = request.fetch("builders").map do |builder|
  require_relative "../lib/lowrail/#{builder.fetch("file")}"
  Lowrail.const_get(builder.fetch("module"), false).build(denied: request.fetch("denied"))
rescue Lowrail::PrismGrammar::Unsupported => error
  {units: [], ledger: [{"pass" => builder.fetch("pass"), "method" => builder.fetch("module"), "outcome" => error.message}]}
end
Lowrail::BuildJit.check(mode)
output.puts(JSON.generate(results))

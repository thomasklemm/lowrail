#!/usr/bin/env ruby
# frozen_string_literal: true

# Objects allocated per request, job, mail and Action Cable action, by source
# line in your app, Rails, Ruby and gems (README-profile.md). Runs a command
# that serves requests (your test suite, a workloads file) twice with
# allocation counting on. It counts objects, not time, and never changes or
# lowers your app.
USAGE = <<~TEXT
  usage: lowrail-profile [options] -- COMMAND...     profile a command, such as bin/rails test
         lowrail-profile [options] --workloads [FILE] replay lowrail/workloads.rb (experimental)
         lowrail-profile report [DIR]                 report again from saved runs
         lowrail-profile compare BASE.json HEAD.json [--aa BASE2.json] [--min N] [--json]
                                                      exit 1 on a regression, 2 without valid evidence

  Options, all before "--" (everything after it is the command's, unchanged):
    --out DIR         where runs and reports go (default tmp/lowrail-profile): a new or empty
                      directory, or one lowrail-profile created
    --runs N          runs of the command (default 2; their spread is in compare's noise floor)
    --top N           rows per table (default 30)
    --seed N          SEED and --seed for every run (default 1234)
    --ledger FILE     a newer ledger index (contributions-index.json) than the bundled one
    --no-ledger       no ledger column
    --record [FILE]   also write the suite's requests as lowrail/workloads.rb (experimental)
    --workloads [FILE] send the file's requests through the app (experimental); they are real
    --allow-writes    let --workloads send writes, sign-ins and setup code, and run against a
                      production environment whose database is not on this machine
    --help, --version
TEXT
require "rbconfig"
require "fileutils"
require "digest"
require_relative "../lib/lowrail/profile_report"
require_relative "../lib/lowrail/workloads"

lib = File.expand_path("../lib", __dir__)
args = ARGV.dup
split = args.index("--")
command = split ? args[(split + 1)..] : nil
args = args[0...split] if split
if args.include?("--help") || args.include?("-h")
  puts USAGE
  exit
end
if args.include?("--version")
  require_relative "../lib/lowrail/profile_version"
  puts "lowrail-profile #{Lowrail::Profile::VERSION}"
  exit
end
opt = lambda do |name, default|
  i = args.index(name) or next default
  value = args[i + 1] or abort "lowrail-profile: #{name} needs a value"
  args.slice!(i, 2)
  value
end
out = File.expand_path(opt.("--out", "tmp/lowrail-profile"))
runs = Integer(opt.("--runs", "2"))
top = Integer(opt.("--top", "30"))
seed = opt.("--seed", "1234")
ledger = opt.("--ledger", File.expand_path("../data/contributions-index.json", __dir__))
ledger = nil if args.delete("--no-ledger")
abort "lowrail-profile: no ledger index #{ledger}" if ledger && !File.file?(ledger)
allow_writes = args.delete("--allow-writes")
# --workloads and --record take an optional FILE.
flag = lambda do |name|
  next unless (i = args.index(name))
  value = args[i + 1] if args[i + 1] && !args[i + 1].start_with?("-")
  args.slice!(i, value ? 2 : 1)
  value || :default
end
workloads = flag.("--workloads")
record = flag.("--record")
abort "lowrail-profile: --paths was replaced by --workloads FILE (lowrail/workloads.rb, README-profile.md)" if args.include?("--paths")

if args.first == "report"
  dir = File.expand_path(args[1] || out)
  report = Lowrail::ProfileReport.new(dir, ledger: ledger, top: top)
  report.write
  puts report.markdown
  exit
end

# compare BASE.json HEAD.json --aa BASE2.json [--min N] [--json]: exit 1 on a
# regression beyond the noise floor of the A/A pair BASE and BASE2, 2 when the
# reports are not valid evidence for one; without --aa, 0 or 2.
if args.first == "compare"
  require_relative "../lib/lowrail/profile_compare"
  min = Float(opt.("--min", "1"))
  aa = opt.("--aa", nil)
  json = args.delete("--json")
  abort "usage: lowrail-profile compare BASE.json HEAD.json [--aa BASE2.json] [--min N] [--json]" unless args.size == 3
  compare = Lowrail::ProfileCompare.new(args[1], args[2], aa: aa, min: min, top: top)
  puts json ? JSON.pretty_generate(compare.to_h) : compare.markdown
  exit compare.status
end

usage = "#{USAGE.lines.first(5).join}(lowrail-profile --help for options)"
abort "lowrail-profile: Windows is not supported (Linux and macOS are)" if Gem.win_platform?
if workloads
  abort "lowrail-profile: --workloads runs its own command; drop the one after --" if command
  abort usage unless args.empty?
  file = File.expand_path(workloads == :default ? Lowrail::Workloads::PATH : workloads)
  abort "lowrail-profile: no #{file}; write one (README-profile.md) or record one: lowrail-profile --record -- bin/rails test" unless File.exist?(file)
  command = ["bin/rails", "runner", File.join(lib, "lowrail/profile_workloads.rb"), file, File.join(out, "workloads.json")]
elsif command
  abort usage unless args.empty?
else
  command = args
end
abort usage if command.empty?
abort "lowrail-profile: --record records a command's requests; drop --workloads" if record && workloads
abort "lowrail-profile: --allow-writes is for --workloads" if allow_writes && !workloads
abort "lowrail-profile: --runs must be at least 1" if runs < 1

# Built once per Ruby build and per version of the counter's sources, outside
# the app and never during its boot. Another checkout's counter has another
# digest, so it is never picked up; lowrail/profile also refuses one whose API
# differs.
source = File.expand_path("../ext/lowrail_profile", __dir__)
inputs = Dir["#{source}/*"].sort.map { "#{File.basename(_1)}\0#{File.binread(_1)}" }
inputs << RbConfig::CONFIG.values_at("CC", "CFLAGS", "LDFLAGS", "DLEXT", "rubyhdrdir", "rubyarchhdrdir").join("\0")
variant = [RUBY_ENGINE, RUBY_VERSION, RUBY_REVISION, RUBY_PLATFORM].join("-")
cache = File.join(ENV.fetch("XDG_CACHE_HOME", File.expand_path("~/.cache")), "lowrail", "profile", variant,
  Digest::SHA256.hexdigest(inputs.join("\0"))[0, 16])
name = "lowrail_profile.#{RbConfig::CONFIG.fetch("DLEXT")}"
ext = File.join(cache, name)
unless File.exist?(ext)
  # Built aside and moved in whole, so a failed or concurrent build never leaves half an extension.
  tmp = "#{cache}.tmp-#{Process.pid}"
  FileUtils.rm_rf(tmp)
  FileUtils.mkdir_p(tmp)
  log = File.join(tmp, "build.log")
  # Built from a copy: mkmf escapes a srcdir with spaces in a way make's VPATH cannot follow.
  FileUtils.cp(Dir["#{source}/*"], tmp)
  ok = system(RbConfig.ruby, "extconf.rb", chdir: tmp, out: log, err: log) &&
    system(RbConfig::CONFIG.fetch("MAKE", "make"), chdir: tmp, out: [log, "a"], err: [log, "a"])
  unless ok && File.exist?(File.join(tmp, name))
    kept = "#{cache}.build.log"
    FileUtils.cp(log, kept) if File.exist?(log)
    FileUtils.rm_rf(tmp)
    abort "lowrail-profile: building the counter failed, see #{kept}"
  end
  begin
    File.rename(tmp, cache)
  rescue SystemCallError
    FileUtils.rm_rf(tmp)
    abort "lowrail-profile: could not install the counter in #{cache}" unless File.exist?(ext)
  end
end

# Clears only what it wrote before, in a directory it marked; refuses any
# other existing directory.
mark = File.join(out, ".lowrail-profile")
if File.exist?(out)
  unless File.directory?(out) && (File.file?(mark) || Dir.empty?(out))
    abort "lowrail-profile: #{out} exists and was not created by lowrail-profile; pick another --out or remove it yourself"
  end
  Dir.children(out).each do |entry|
    FileUtils.rm_rf(File.join(out, entry)) if entry.match?(/\Arun\d+\z/) || %w[command.txt capture.json report.md report.json workloads.json].include?(entry)
  end
end
FileUtils.mkdir_p(out)
File.write(mark, "Created by lowrail-profile, which clears its runs and reports here on each run.\n")
statuses = (1..runs).map do |n|
  dir = File.join(out, "run#{n}")
  FileUtils.mkdir_p(dir)
  # The repeat run also records the nearest app line of every allocation
  # (without allocating, so its counts stay comparable). Every internal flag
  # is set or cleared here, so none leaks in from the caller's environment;
  # lib goes through RUBYLIB, which, unlike RUBYOPT, takes paths with spaces,
  # and through RUBYOPT when it can, for a child that sets its own RUBYLIB.
  env = { "LOWRAIL_PROFILE" => dir, "LOWRAIL_PROFILE_EXT" => ext, "SEED" => seed, "LOWRAIL_PROFILE_ROOT" => Dir.pwd,
    "LOWRAIL_PROFILE_ATTRIBUTE" => ("1" if n == [runs, 2].min),
    "LOWRAIL_PROFILE_RECORD" => ("1" if record && n == 1),
    "LOWRAIL_PROFILE_ALLOW_WRITES" => ("1" if allow_writes),
    "SPEC_OPTS" => [ENV["SPEC_OPTS"], "--seed #{seed}"].compact.join(" "),
    "RUBYLIB" => [lib, ENV["RUBYLIB"]].reject { _1.nil? || _1.empty? }.join(File::PATH_SEPARATOR),
    "RUBYOPT" => [ENV["RUBYOPT"], ("-I#{lib}" unless lib.match?(/\s/)), "-rlowrail/profile"].compact.join(" ") }
  warn "lowrail-profile: run #{n} of #{runs}: #{command.join(" ")}"
  system(env, *command)
  # A shell's convention: the exit status, or 128 + the signal that ended it.
  status = $?.exitstatus || 128 + $?.termsig.to_i
  # A workloads run that stops (a refused write, a response outside expect:) measured nothing to repeat.
  if workloads && status != 0
    warn "lowrail-profile: the workloads run exited #{status}; nothing measured"
    exit status
  end
  status
end
# The first failed run's status is the command's; profiling never hides a failure.
failed = statuses.find { _1 != 0 }
File.write(File.join(out, "command.txt"), "#{command.join(" ")}\nseed #{seed}\nexit #{statuses.join(" ")}\n")
# What compare checks two captures against: the workloads (their manifest and
# what was measured, from the receipt) or the command's arguments, never the
# output directory; argv stays apart for diagnostics.
identity = workloads ? { "mode" => "workloads", "host" => ENV.fetch("LOWRAIL_PROFILE_HOST", "localhost") } : { "mode" => "command", "argv" => command }
File.write(File.join(out, "capture.json"), JSON.generate("format" => 1, "identity" => identity, "argv" => command, "seed" => seed,
  "runs" => runs, "exit" => statuses) + "\n")

begin
  report = Lowrail::ProfileReport.new(out, ledger: ledger, top: top)
  report.write
  puts report.markdown
rescue StandardError => error
  warn "lowrail-profile: no report: #{error.message}; the command exited #{statuses.join(", ")}"
  exit(failed || 1)
end
begin
  if record
    target = File.expand_path(record == :default ? Lowrail::Workloads::PATH : record)
    target = File.join(out, "workloads.rb") if record == :default && File.exist?(target)
    shapes = Dir["#{out}/run1/*.shapes.json"].flat_map { JSON.parse(File.read(_1)) }
    merged = shapes.group_by { _1.values_at("verb", "template", "json", "xhr", "format", "accept", "unfiltered") }
      .map { |_, list| list.first.merge("count" => list.sum { _1["count"] }) }
    if merged.empty?
      warn "lowrail-profile: --record saw no routed requests; nothing written"
    else
      FileUtils.mkdir_p(File.dirname(target))
      File.write(target, Lowrail::Workloads.render(Lowrail::Workloads.recorded(merged, 20), <<~TEXT))
        Workloads for lowrail-profile --workloads (README-profile.md).
        Recorded by `lowrail-profile --record -- #{command.join(" ")}`: the #{[merged.size, 20].min} most frequent
        request shapes of #{merged.sum { _1["count"] }} requests, most frequent first. Records are each model's first row.
        Only GETs that replay as recorded are enabled. Writes keep the params one test sent and are commented out until
        you make them repeatable (setup, alternate:); so is any request whose params were filtered or shortened.
        Recorded from real requests: values the app's filter_parameters hides are #{Lowrail::Workloads::FILTERED},
        but check the file for other secrets before you commit it.
      TEXT
      warn "lowrail-profile: wrote #{target} from real requests (filter_parameters applied); check it for secrets before committing it"
    end
  end
rescue StandardError => error
  warn "lowrail-profile: --record: #{error.message}"
  exit(failed || 1)
end
warn "lowrail-profile: report in #{File.join(out, "report.md")}"
warn "lowrail-profile: the command exited #{statuses.join(", ")}" unless statuses.all?(0)
exit(failed || 0)

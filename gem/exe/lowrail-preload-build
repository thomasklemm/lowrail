#!/usr/bin/env ruby
# frozen_string_literal: true

# Invoked after the ordinary build, in the same environment as its oracle.
ENV["LOWRAIL"] = "0"
require File.expand_path("config/environment", Dir.pwd)
Rails.application.eager_load!
require_relative "../lib/lowrail"
require_relative "../lib/lowrail/preload_build"
Lowrail::PreloadBuild.run(File.expand_path(ARGV.fetch(0)))

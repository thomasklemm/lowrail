--- a/callgrind/bbcc.c
+++ b/callgrind/bbcc.c
@@ -28,6 +28,32 @@
 #include "costs.h"
 
 #include "pub_tool_threadstate.h"
+#include "../coregrind/pub_core_threadstate.h"
+
+/* Private instruction sampler; deliberately limited to the requesting
+ * thread and normal client execution, never its signal-handler work. */
+extern Int VG_(tkill)(Int lwpid, Int signo);
+Bool lowrail_sampling, lowrail_pending, lowrail_paused;
+ThreadId lowrail_tid;
+ULong lowrail_budget, lowrail_lag, lowrail_rng, lowrail_work, lowrail_issued;
+
+static void lowrail_sample(UInt count, ThreadId tid) {
+    if (!lowrail_sampling || lowrail_paused || tid != lowrail_tid || CLG_(current_state).sig) return;
+    lowrail_work += count;
+    if (lowrail_pending) { lowrail_lag += count; return; }
+    if (lowrail_budget > count) { lowrail_budget -= count; return; }
+    lowrail_pending = True;
+    lowrail_issued++;
+    lowrail_lag = 0;
+    lowrail_rng ^= lowrail_rng << 13;
+    lowrail_rng ^= lowrail_rng >> 7;
+    lowrail_rng ^= lowrail_rng << 17;
+    lowrail_budget = 32768 + (lowrail_rng & 65535);
+    VG_(tkill)(VG_(gettid)(), VKI_SIGPROF);
+    /* Poll the queued client signal on the next dispatcher entry, not a
+     * million guest instructions later at the ordinary scheduling quantum. */
+    VG_(get_ThreadState)(tid)->arch.vex.host_EvC_COUNTER = 0;
+}
 

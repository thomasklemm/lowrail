From 08be5191dbb02d95f50dc8fea61114d78a2ef82d Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 15:04:19 +0000
Subject: [PATCH] Restore
 ActiveModel::SecurePassword::MAX_PASSWORD_LENGTH_ALLOWED

#56041 moved the constant to the new BCryptPassword class. Applications
and gems use it to cap password length, for example Spree's
maximum_password_length preference and open-build-service's User
validation, and raise NameError on main when that code loads.

Keep the public constant on SecurePassword, pointing at the BCrypt limit.
---
 activemodel/lib/active_model/secure_password.rb | 4 ++++
 activemodel/test/cases/secure_password_test.rb  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/activemodel/lib/active_model/secure_password.rb b/activemodel/lib/active_model/secure_password.rb
index 7206acc3403..de60c4e065c 100644
--- a/activemodel/lib/active_model/secure_password.rb
+++ b/activemodel/lib/active_model/secure_password.rb
@@ -8,6 +8,10 @@ module ActiveModel
   module SecurePassword
     extend ActiveSupport::Concern
 
+    # BCrypt, the default algorithm, ignores everything after the first 72
+    # bytes of a password.
+    MAX_PASSWORD_LENGTH_ALLOWED = BCryptPassword::MAX_PASSWORD_LENGTH_ALLOWED
+
     DEFAULT_RESET_TOKEN_EXPIRES_IN = 15.minutes
 
     class << self
diff --git a/activemodel/test/cases/secure_password_test.rb b/activemodel/test/cases/secure_password_test.rb
index c27bdb8ee36..154c26aacff 100644
--- a/activemodel/test/cases/secure_password_test.rb
+++ b/activemodel/test/cases/secure_password_test.rb
@@ -100,6 +100,10 @@ class SecurePasswordTest < ActiveModel::TestCase
     assert_equal ["can't be blank"], @user.errors[:password]
   end
 
+  test "MAX_PASSWORD_LENGTH_ALLOWED is the BCrypt limit of 72 bytes" do
+    assert_equal 72, ActiveModel::SecurePassword::MAX_PASSWORD_LENGTH_ALLOWED
+  end
+
   test "create a new user with validation and password length greater than 72 characters" do
     @user.password = "a" * 73
     @user.password_confirmation = "a" * 73
-- 

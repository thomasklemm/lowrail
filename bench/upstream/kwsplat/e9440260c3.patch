From e9440260c349415661c0c09accd4c50be48039bc Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 13:04:26 +0000
Subject: [PATCH] Allocate one hash for keyword splats after dynamic keywords

Since f01bf185f6 (GH-18344), `m(a: v, **h)` allocates two hashes: the
prism compiler builds the dynamic pairs with `newhash`, then copies that
fresh hash in `core#hash_merge_kwd`. The single keyword splat paths in
both compilers do the same with `newhash 0`, and prism's zsuper with
keywords builds `newhash 0` and copies it in `core#hash_merge_ptr`.

Build the pairs with `core#hash_new_for_merge` instead, which works like
`newhash` but leaves room in the hash's embedded table for a small
keyword splat, and merge the splat into it in place with
`core#hash_merge_fresh_kwd`. The pairs are still hashed before the splat
expression runs. The single keyword splat paths start from an empty
`core#hash_new_for_merge` the same way. Zsuper with named keywords and
no keyword rest builds its keywords with `newhash` directly; zsuper with
a keyword rest is unchanged.

    def m(**kw) = kw
    v = 2
    h = {}
    m(a: v, **h) # 2 hashes -> 1
---
 compile.c                    |  5 +++--
 defs/id.def                  |  2 ++
 prism_compile.c              | 38 ++++++++++++++++++++++++++++--------
 test/ruby/test_allocation.rb | 25 ++++++++++++++++++++++++
 vm.c                         | 24 +++++++++++++++++++++++
 5 files changed, 84 insertions(+), 10 deletions(-)

diff --git a/compile.c b/compile.c
index 2c55ee1541..7623408e82 100644
--- a/compile.c
+++ b/compile.c
@@ -6840,9 +6840,10 @@ compile_single_keyword_splat_mutable(rb_iseq_t *iseq, LINK_ANCHOR *const args, c
 {
     *flag_ptr |= VM_CALL_KW_SPLAT_MUT;
     ADD_INSN1(args, argn, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
-    ADD_INSN1(args, argn, newhash, INT2FIX(0));
+    ADD_INSN1(args, argn, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
+    ADD_SEND(args, argn, id_core_hash_new_for_merge, INT2FIX(0));
     compile_hash(iseq, args, kwnode, TRUE, FALSE);
-    ADD_SEND(args, argn, id_core_hash_merge_kwd, INT2FIX(2));
+    ADD_SEND(args, argn, id_core_hash_merge_fresh_kwd, INT2FIX(2));
 }
 
 #define SPLATARRAY_FALSE 0
diff --git a/defs/id.def b/defs/id.def
index 11d7cad1a1..5017a8ef6c 100644
--- a/defs/id.def
+++ b/defs/id.def
@@ -104,6 +104,8 @@ firstline, predefined = __LINE__+1, %[\
   core#hash_merge_bang_ptr
   core#hash_merge_kwd
   core#hash_merge_bang_kwd
+  core#hash_merge_fresh_kwd
+  core#hash_new_for_merge
   core#hash_coerce
   core#raise
   core#sprintf
diff --git a/prism_compile.c b/prism_compile.c
index 6731bde158..0924bdc6e3 100644
--- a/prism_compile.c
+++ b/prism_compile.c
@@ -1599,6 +1599,25 @@ pm_compile_hash_elements(rb_iseq_t *iseq, const pm_node_t *node, const pm_node_l
             break;
           }
           case PM_ASSOC_SPLAT_NODE: {
+            if (first_chunk && stack_length && shareability == 0) {
+                // `k: v, **kw`: hash the pairs before evaluating `kw`, in a
+                // hash with room to merge `kw` into it in place. The two VM
+                // core objects receive the two sends below.
+                // (Shareable constant values push the pairs to `ret` directly.)
+                PUSH_INSN1(ret, location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
+                PUSH_INSN1(ret, location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
+                PUSH_SEQ(ret, anchor);
+                PUSH_SEND(ret, location, id_core_hash_new_for_merge, INT2FIX(stack_length));
+                PM_COMPILE_NOT_POPPED(element);
+                PUSH_SEND(ret, location, id_core_hash_merge_fresh_kwd, INT2FIX(2));
+                INIT_ANCHOR(anchor);
+                stack_length = 0;
+                first_chunk = false;
+                owned_hash = true;
+                static_literal = false;
+                break;
+            }
+
             FLUSH_CHUNK;
 
             const pm_assoc_splat_node_t *assoc_splat = (const pm_assoc_splat_node_t *) element;
@@ -1731,9 +1750,10 @@ pm_setup_args_core(const pm_arguments_node_t *arguments_node, const pm_node_t *b
                     else if (*dup_rest & DUP_SINGLE_KW_SPLAT) {
                         *flags |= VM_CALL_KW_SPLAT_MUT;
                         PUSH_INSN1(ret, location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
-                        PUSH_INSN1(ret, location, newhash, INT2FIX(0));
+                        PUSH_INSN1(ret, location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
+                        PUSH_SEND(ret, location, id_core_hash_new_for_merge, INT2FIX(0));
                         pm_compile_hash_elements(iseq, argument, elements, 0, Qundef, true, ret, scope_node);
-                        PUSH_SEND(ret, location, id_core_hash_merge_kwd, INT2FIX(2));
+                        PUSH_SEND(ret, location, id_core_hash_merge_fresh_kwd, INT2FIX(2));
                     }
                     else {
                         pm_compile_hash_elements(iseq, argument, elements, 0, Qundef, true, ret, scope_node);
@@ -8198,17 +8218,13 @@ pm_compile_forwarding_super_node(rb_iseq_t *iseq, const pm_forwarding_super_node
         int local_size = local_body->local_table_size;
         argc++;
 
-        PUSH_INSN1(args, *location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
-
         if (local_body->param.flags.has_kwrest) {
+            PUSH_INSN1(args, *location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
             int idx = local_body->local_table_size - local_keyword->rest_start;
             PUSH_GETLOCAL(args, *location, idx, depth);
             RUBY_ASSERT(local_keyword->num > 0);
             PUSH_SEND(args, *location, rb_intern("dup"), INT2FIX(0));
         }
-        else {
-            PUSH_INSN1(args, *location, newhash, INT2FIX(0));
-        }
         int i = 0;
         for (; i < local_keyword->num; ++i) {
             ID id = local_keyword->table[i];
@@ -8222,7 +8238,13 @@ pm_compile_forwarding_super_node(rb_iseq_t *iseq, const pm_forwarding_super_node
             PUSH_GETLOCAL(args, *location, idx, depth);
         }
 
-        PUSH_SEND(args, *location, id_core_hash_merge_ptr, INT2FIX(i * 2 + 1));
+        if (local_body->param.flags.has_kwrest) {
+            PUSH_SEND(args, *location, id_core_hash_merge_ptr, INT2FIX(i * 2 + 1));
+        }
+        else {
+            // Without a keyword rest, `newhash` builds the keywords in one hash.
+            PUSH_INSN1(args, *location, newhash, INT2FIX(i * 2));
+        }
         flag |= VM_CALL_KW_SPLAT| VM_CALL_KW_SPLAT_MUT;
     }
     else if (local_body->param.flags.has_kwrest) {
diff --git a/test/ruby/test_allocation.rb b/test/ruby/test_allocation.rb
index ae55c5fc63..9cafa109a4 100644
--- a/test/ruby/test_allocation.rb
+++ b/test/ruby/test_allocation.rb
@@ -49,6 +49,8 @@ def self.num_allocations
           r2k_empty_array = r2k_empty_array = [Hash.ruby2_keywords_hash({})]
           r2k_empty_array1 = r2k_empty_array1 = [1, Hash.ruby2_keywords_hash({})]
           hash1 = hash1 = {a: 2}
+          hash3 = hash3 = {a: 2, c: 3, d: 4}
+          hash8 = hash8 = {a: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9}
           nill = nill = nil
           block = block = lambda{}
 
@@ -306,6 +308,15 @@ def self.keyword_splat(**kw#{block}); end
         check_allocations(0, 1, "keyword_splat(a: 2#{block})")
         check_allocations(0, 1, "keyword_splat(*empty_array, a: 2#{block})")
         check_allocations(0, 1, "keyword_splat(a:2, **empty_hash#{block})")
+        check_allocations(0, 1, "keyword_splat(a: nill, **empty_hash#{block})")
+        # Starts from a frozen literal template, so it merges through hash_merge_ptr (control)
+        check_allocations(0, 1, "keyword_splat(a: 2, b: nill, **hash1, c: nill#{block})")
+        # Dynamic pairs get a hash with room to merge the splat in place:
+        # results of 2, 4 and 9 entries (a new small hash holds 2, the
+        # embedded table at most 8)
+        check_allocations(0, 1, "keyword_splat(b: nill, **hash1#{block})")
+        check_allocations(0, 1, "keyword_splat(b: nill, **hash3#{block})")
+        check_allocations(0, 1, "keyword_splat(b: nill, **hash8#{block})")
         check_allocations(0, 1, "keyword_splat(**empty_hash, a: 2#{block})")
 
         check_allocations(0, 1, "keyword_splat(**nil#{block})")
@@ -334,6 +345,7 @@ def self.keyword_and_keyword_splat(a: 1, **kw#{block}); end
         check_allocations(0, 1, "keyword_and_keyword_splat(a: 2#{block})")
         check_allocations(0, 1, "keyword_and_keyword_splat(*empty_array, a: 2#{block})")
         check_allocations(0, 1, "keyword_and_keyword_splat(a:2, **empty_hash#{block})")
+        check_allocations(0, 1, "keyword_and_keyword_splat(a: nill, **empty_hash#{block})")
         check_allocations(0, 1, "keyword_and_keyword_splat(**empty_hash, a: 2#{block})")
 
         check_allocations(0, 1, "keyword_and_keyword_splat(**nil#{block})")
@@ -355,6 +367,16 @@ def self.keyword_and_keyword_splat(a: 1, **kw#{block}); end
       RUBY
     end
 
+    def test_zsuper_keyword_parameters
+      check_allocations(<<~RUBY)
+        extend(Module.new { def zsuper_kw(a: 1, b: 2#{block}) = nil })
+        def self.zsuper_kw(a: 1, b: 2#{block}); super; end
+
+        check_allocations(0, 1, "zsuper_kw(#{only_block})")
+        check_allocations(0, 1, "zsuper_kw(a: nill#{block})")
+      RUBY
+    end
+
     def test_required_positional_and_keyword_parameter
       check_allocations(<<~RUBY)
         def self.required_and_keyword(b, a: nil#{block}); end
@@ -906,6 +928,9 @@ def munge_checks(checks)
       end.join("\n")
     end
 
+    # zsuper is not available in procs
+    undef_method :test_zsuper_keyword_parameters
+
     # Generic argument forwarding not supported in proc definitions
     undef_method :test_argument_forwarding
     undef_method :test_nested_argument_forwarding
diff --git a/vm.c b/vm.c
index 33ae70af98..a8b95c842c 100644
--- a/vm.c
+++ b/vm.c
@@ -4530,6 +4530,28 @@ m_core_hash_merge_kwd(VALUE recv, VALUE hash, VALUE kw)
     return hash;
 }
 
+static VALUE
+m_core_hash_merge_fresh_kwd(VALUE recv, VALUE hash, VALUE kw)
+{
+    // `hash` is a fresh `core#hash_new_for_merge` that nothing else references,
+    // so merge into it. `kw` is nil for `**nil` or a nil value.
+    if (!NIL_P(kw)) {
+        REWIND_CFP(rb_hash_merge2(hash, rb_to_hash_type(kw), false));
+    }
+    return hash;
+}
+
+static VALUE
+m_core_hash_new_for_merge(int argc, VALUE *argv, VALUE recv)
+{
+    // Like `newhash`, but with room in the embedded table to merge a small
+    // keyword splat in place.
+    long capa = argc / 2 < RHASH_AR_TABLE_MAX_SIZE ? RHASH_AR_TABLE_MAX_SIZE : argc / 2;
+    VALUE hash = rb_hash_new_capa(capa);
+    REWIND_CFP(rb_hash_bulk_insert(argc, argv, hash));
+    return hash;
+}
+
 static VALUE
 m_core_hash_merge_bang_kwd(VALUE recv, VALUE hash, VALUE kw)
 {
@@ -4760,6 +4782,8 @@ Init_VM(void)
     rb_define_method_id(klass, id_core_hash_merge_bang_ptr, m_core_hash_merge_bang_ptr, -1);
     rb_define_method_id(klass, id_core_hash_merge_kwd, m_core_hash_merge_kwd, 2);
     rb_define_method_id(klass, id_core_hash_merge_bang_kwd, m_core_hash_merge_bang_kwd, 2);
+    rb_define_method_id(klass, id_core_hash_merge_fresh_kwd, m_core_hash_merge_fresh_kwd, 2);
+    rb_define_method_id(klass, id_core_hash_new_for_merge, m_core_hash_new_for_merge, -1);
     rb_define_method_id(klass, id_core_hash_coerce, m_core_hash_coerce, 1);
     rb_define_method_id(klass, id_core_raise, f_raise, -1);
     rb_define_method_id(klass, id_core_sprintf, f_sprintf, -1);

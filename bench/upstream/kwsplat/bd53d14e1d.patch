+                PUSH_SEND(ret, location, id_core_hash_merge_bang_kwd, INT2FIX(2));
+                INIT_ANCHOR(anchor);
+                stack_length = 0;
+                first_chunk = false;
+                owned_hash = true;
+                static_literal = false;
+                break;
+            }
+
             FLUSH_CHUNK;
 
             const pm_assoc_splat_node_t *assoc_splat = (const pm_assoc_splat_node_t *) element;
@@ -1731,9 +1750,10 @@ pm_setup_args_core(const pm_arguments_node_t *arguments_node, const pm_node_t *b

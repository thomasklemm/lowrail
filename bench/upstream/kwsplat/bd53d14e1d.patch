diff --git a/test/ruby/test_keyword.rb b/test/ruby/test_keyword.rb
index cfc3dc11da..cd46dc448b 100644
--- a/test/ruby/test_keyword.rb
+++ b/test/ruby/test_keyword.rb
@@ -189,6 +189,49 @@ def self.a(b: 1, **) [b, **] end
     assert_equal({b: 2, c: 3}, kw)
   end
 
+  def test_keyword_splat_after_dynamic_keywords
+    def self.kw(**kw) = kw
+    key = Struct.new(:id) do
+      def hash = id.hash
+      def eql?(other) = id == other.id
+    end
+    v = 1
+    small = {b: 2}
+    large = (1..9).to_h { [:"k#{_1}", _1] }
+
+    [small, large].each do |h|
+      assert_equal({a: 1, **h}, kw(a: v, **h))
+      assert_equal([:a, *h.keys, :c], kw(a: v, **h, c: v, **{}).keys)
+      assert_equal({a: 1, **h}, {a: v, **h})
+
+      src = h.dup
+      r = kw(a: v, **src)
+      src[:z] = 0
+      r[:y] = 0
+      assert_not_include(r, :z)
+      assert_not_include(src, :y)
+
+      d = Hash.new(0).compare_by_identity.merge!(h)
+      [kw(a: v, **d), {a: v, **d}].each do |x|
+        assert_nil(x.default)
+        assert_not_predicate(x, :compare_by_identity?)
+      end
+    end
+
+    r = kw(key.new(1) => v, **{key.new(1) => 2, key.new(2) => 3})
+    assert_equal({key.new(1) => 2, key.new(2) => 3}, r)
+    assert_equal(3, r[key.new(2)])
+    assert_equal({a: 1, b: 2, c: 1, d: 3}, kw(a: v, **small, c: v, **{d: 3}))
+
+    raising = Object.new
+    def raising.to_hash = raise("to_hash")
+    assert_raise_with_message(RuntimeError, "to_hash") { kw(a: v, **raising) }
+    not_hash = Object.new
+    def not_hash.to_hash = 1
+    assert_raise(TypeError) { kw(a: v, **not_hash) }
+    assert_raise(TypeError) { {a: v, **not_hash} }
+  end
+
   def test_keyword_splat_nil
     # cfunc call
     assert_equal(nil, p(**nil))
diff --git a/vm.c b/vm.c
index 33ae70af98..151c81d797 100644
--- a/vm.c
+++ b/vm.c
@@ -4530,22 +4530,27 @@ m_core_hash_merge_kwd(VALUE recv, VALUE hash, VALUE kw)
     return hash;
 }
 
+static VALUE
+m_core_hash_new_for_merge(int argc, VALUE *argv, VALUE recv)
+{
+    // Like `newhash`, but with room in the embedded table to merge a small
+    // keyword splat in place.
+    VM_ASSERT(argc % 2 == 0);
+    long capa = argc / 2 < RHASH_AR_TABLE_MAX_SIZE ? RHASH_AR_TABLE_MAX_SIZE : argc / 2;
+    VALUE hash = rb_hash_new_capa(capa);
+    REWIND_CFP(rb_hash_bulk_insert(argc, argv, hash));
+    return hash;
+}
+
 static VALUE
 m_core_hash_merge_bang_kwd(VALUE recv, VALUE hash, VALUE kw)
 {
-    // We own `hash` we should mutate it in place if possible.
-    if (NIL_P(kw)) {
-        if (NIL_P(hash)) {
-            hash = rb_hash_new();
-        }
-        else {
-            hash = rb_hash_resurrect(hash);
-        }
+    // We own `hash`, so we mutate it in place. `kw` is nil for `**nil` or
+    // a nil value, which leaves `hash` as is.
+    VM_ASSERT(RB_TYPE_P(hash, T_HASH));
+    if (!NIL_P(kw)) {
+        REWIND_CFP(rb_hash_merge2(hash, rb_to_hash_type(kw), false));
     }
-    else {
-        REWIND_CFP(hash = core_hash_merge_kwd(hash, kw, false));
-    }
-    VM_ASSERT(CLASS_OF(hash));
     return hash;
 }
 
@@ -4760,6 +4765,7 @@ Init_VM(void)
     rb_define_method_id(klass, id_core_hash_merge_bang_ptr, m_core_hash_merge_bang_ptr, -1);
     rb_define_method_id(klass, id_core_hash_merge_kwd, m_core_hash_merge_kwd, 2);
     rb_define_method_id(klass, id_core_hash_merge_bang_kwd, m_core_hash_merge_bang_kwd, 2);
+    rb_define_method_id(klass, id_core_hash_new_for_merge, m_core_hash_new_for_merge, -1);
     rb_define_method_id(klass, id_core_hash_coerce, m_core_hash_coerce, 1);
     rb_define_method_id(klass, id_core_raise, f_raise, -1);
     rb_define_method_id(klass, id_core_sprintf, f_sprintf, -1);

+                PUSH_INSN1(ret, location, putspecialobject, INT2FIX(VM_SPECIAL_OBJECT_VMCORE));
+                PUSH_SEQ(ret, anchor);
+                PUSH_SEND(ret, location, id_core_hash_new_for_merge, INT2FIX(stack_length));

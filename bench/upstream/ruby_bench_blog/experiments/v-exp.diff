diff --git a/benchmarks/blog/benchmark.rb b/benchmarks/blog/benchmark.rb
index d9a8717..882380d 100644
--- a/benchmarks/blog/benchmark.rb
+++ b/benchmarks/blog/benchmark.rb
@@ -139,7 +139,16 @@ run_benchmark(10) do
   # Roll back every write at the end of the iteration, as Rails tests do,
   # so each iteration starts from the same databases.
   pinned = []
-  pools.each { |pool| pool.pin_connection!(false); pinned << pool }
+  began = []
+  pools.each do |pool|
+    pool.pin_connection!(false); pinned << pool
+    # Rails 8.2 (rails/rails 9e8fe3955b) no longer opens the transaction in pin_connection!.
+    connection = pool.lease_connection
+    unless connection.transaction_open?
+      connection.begin_transaction(joinable: false, _lazy: false)
+      began << pool
+    end
+  end
   browser.cookie = nil
   visits.each_with_index do |(kind, id, *args, count, comments), index|
     $now = START_TIME + index
@@ -198,7 +207,11 @@ run_benchmark(10) do
       "got #{SolidCable::Message.count} and #{SolidQueue::Job.count}"
   end
 ensure
-  clean = pinned.map(&:unpin_connection!).all?
+  clean = began.map do |pool|
+    connection = pool.lease_connection
+    connection.transaction_open?.tap { connection.rollback_transaction if _1 }
+  end.all?
+  clean = pinned.map { |pool| pool.unpin_connection!.then { began.include?(pool) || _1 } }.all? && clean
   $now = nil
   raise "A request ended the iteration's transaction" unless clean || $!
 end

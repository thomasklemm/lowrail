From 8d29f4b6f02bcba1cf1ae446db4dc7839d3c1ae2 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 14:43:57 +0000
Subject: [PATCH] Cast plucked columns unknown to the schema from the result

pluck took each column's type from its Arel attribute first. For a
column of a joined subquery, a CTE or another table the schema doesn't
know, that type is the placeholder default type, which casts nothing,
so the values came back raw instead of with the type the database
reports for the result.

Use the result's column type in that case. Columns with any other type
keep it, and SQL expressions are looked up as before.
---
 activerecord/CHANGELOG.md                     | 15 ++++++++++++
 .../active_record/relation/calculations.rb    |  9 ++++++-
 activerecord/test/cases/calculations_test.rb  | 24 +++++++++++++++++++
 3 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/activerecord/CHANGELOG.md b/activerecord/CHANGELOG.md
index 4ad8bfd285..e142465efe 100644
--- a/activerecord/CHANGELOG.md
+++ b/activerecord/CHANGELOG.md
@@ -1,3 +1,18 @@
+*   Fix `pluck` and `pick` returning uncast values for a column unknown to the schema.
+
+    Plucking a column of a joined subquery, a CTE or another table the schema
+    doesn't know now casts it with the column type the database reports for
+    the result, when the adapter reports result column types (PostgreSQL and
+    SQLite), instead of returning the raw value.
+
+    ```ruby
+    Topic.with(read: Topic.select(:id, :last_read)).joins("JOIN read ON read.id = topics.id").pluck("read.last_read")
+    # => ["2004-04-15"] before
+    # => [Thu, 15 Apr 2004] now
+    ```
+
+    *Thomas Klemm*
+
 *   Retry `ActiveRecord::SerializationFailure` on queries that opted into retries.
 
     A serialization failure rolls back whatever the statement was part of, so a
diff --git a/activerecord/lib/active_record/relation/calculations.rb b/activerecord/lib/active_record/relation/calculations.rb
index 91900066ea..79d00f4181 100644
--- a/activerecord/lib/active_record/relation/calculations.rb
+++ b/activerecord/lib/active_record/relation/calculations.rb
@@ -632,12 +632,19 @@ def type_cast_pluck_values(result, columns)
         else
           join_dependencies = nil
           columns.map.with_index do |column, i|
-            column.try(:type_caster) ||
+            type = column.try(:type_caster)
+            # Prefer the result type only for the default placeholder, preserving explicit types.
+            if type.equal?(Type.default_value)
+              result.column_types[i] || type
+            elsif type
+              type
+            else
               model.attribute_types.fetch(name = result.columns[i]) do
                 join_dependencies ||= build_join_dependencies
                 lookup_cast_type_from_join_dependencies(name, join_dependencies) ||
                   result.column_types[i] || Type.default_value
               end
+            end
           end
         end
         result.cast_values(cast_types)
diff --git a/activerecord/test/cases/calculations_test.rb b/activerecord/test/cases/calculations_test.rb
index e24cb7f88e..68d36e8729 100644
--- a/activerecord/test/cases/calculations_test.rb
+++ b/activerecord/test/cases/calculations_test.rb
@@ -1049,6 +1049,30 @@ def test_pluck_type_cast_with_conflict_column_names
     assert_equal expected, actual
   end
 
+  def test_pluck_type_cast_of_columns_unknown_to_the_schema_from_the_result
+    topics = Topic
+      .with(read: Topic.select(:id, :last_read, "topics.approved AS written_on"))
+      .joins("JOIN read ON read.id = topics.id")
+      .where(id: topics(:first).id)
+
+    assert_equal [[topics(:first).title, Date.new(2004, 4, 15), false]], topics.pluck(:title, "read.last_read", "read.written_on")
+    assert_equal Date.new(2004, 4, 15), topics.pick("read.last_read")
+  end if current_adapter?(:SQLite3Adapter, :PostgreSQLAdapter)
+
+  def test_pluck_keeps_an_explicit_value_type
+    topic = Class.new(Topic) { attribute :last_read, ActiveModel::Type::Value.new }
+
+    assert_equal ["2004-04-15"], topic.where.not(last_read: nil).pluck(:last_read)
+  end if current_adapter?(:SQLite3Adapter, :PostgreSQLAdapter)
+
+  def test_pluck_of_a_column_unknown_to_the_schema_without_result_column_types
+    result = ActiveRecord::Result.new(["last_read"], [["2004-04-15"]])
+
+    Topic.lease_connection.stub(:select_all, result) do
+      assert_equal ["2004-04-15"], Topic.joins("JOIN read ON read.id = topics.id").pluck("read.last_read")
+    end
+  end
+
   def test_pluck_type_cast_with_joins_without_table_name_qualified_column
     assert_pluck_type_cast_without_table_name_qualified_column(AuthorAddress.joins(author: :books))
   end

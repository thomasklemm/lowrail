From 2e9fc7c4b482553cd6dea6fb0415b4b39059e11e Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 12:14:29 +0000
Subject: [PATCH] Cast grouped keys of columns unknown to the schema from the
 result

A grouped calculation took each key's type from the group column first.
For a column of a joined subquery, a CTE or another table the schema
doesn't know, that type is the placeholder default type, which casts
nothing, so the keys came back as Strings instead of with the type the
database reports for the result.

Use the result's column type in that case. Columns of known tables,
including joined models that share column names with the root model,
keep their schema type.
---
 activerecord/CHANGELOG.md                     | 16 +++++++++
 .../active_record/relation/calculations.rb    | 13 +++++---
 activerecord/test/cases/calculations_test.rb  | 33 +++++++++++++++++++
 3 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/activerecord/CHANGELOG.md b/activerecord/CHANGELOG.md
index 4ad8bfd285..b1000b8b8c 100644
--- a/activerecord/CHANGELOG.md
+++ b/activerecord/CHANGELOG.md
@@ -1,3 +1,19 @@
+*   Fix grouped calculations returning uncast keys for a column unknown to the schema.
+
+    Grouping by a column of a joined subquery, a CTE or another table the
+    schema doesn't know now casts the keys with the column types the database
+    reports for the result, so on PostgreSQL and SQLite they are no longer
+    Strings for dates, times, ranges and other non-string types. On PostgreSQL
+    this is the behavior before Rails 7.0.5.
+
+    ```ruby
+    Booking.joins("JOIN (SELECT tsrange(...) AS range) ranges ON TRUE").group("ranges.range").count
+    # => { "[\"2020-01-01 00:00:00\",\"2020-01-02 00:00:00\")" => 1 } before
+    # => { 2020-01-01 00:00:00 UTC...2020-01-02 00:00:00 UTC => 1 } now (PostgreSQL)
+    ```
+
+    *Thomas Klemm*
+
 *   Retry `ActiveRecord::SerializationFailure` on queries that opted into retries.
 
     A serialization failure rolls back whatever the statement was part of, so a
diff --git a/activerecord/lib/active_record/relation/calculations.rb b/activerecord/lib/active_record/relation/calculations.rb
index 91900066ea..7e9a1190c7 100644
--- a/activerecord/lib/active_record/relation/calculations.rb
+++ b/activerecord/lib/active_record/relation/calculations.rb
@@ -584,10 +584,15 @@ def execute_grouped_calculation(operation, column_name, distinct) # :nodoc:
             end
 
             key_types = group_columns.each_with_object({}) do |(aliaz, col_name), types|
-              types[aliaz] = col_name.try(:type_caster) ||
-                type_for(col_name) do
-                  calculated_data.column_types.fetch(aliaz, Type.default_value)
-                end
+              type = col_name.try(:type_caster)
+              # A column unknown to the schema has the placeholder Type.default_value (hence equal?); use the database type.
+              types[aliaz] = if type.equal?(Type.default_value)
+                calculated_data.column_types.fetch(aliaz, type)
+              elsif type
+                type
+              else
+                type_for(col_name) { calculated_data.column_types.fetch(aliaz, Type.default_value) }
+              end
             end
 
             hash_rows = calculated_data.cast_values(key_types).map! do |row|
diff --git a/activerecord/test/cases/calculations_test.rb b/activerecord/test/cases/calculations_test.rb
index e24cb7f88e..2fabdcfbc4 100644
--- a/activerecord/test/cases/calculations_test.rb
+++ b/activerecord/test/cases/calculations_test.rb
@@ -825,6 +825,39 @@ def test_should_count_field_in_joined_table_with_group_by_when_tables_share_colu
     assert_equal({ "active" => 2, "trial" => 2, "suspended" => 1 }, counts)
   end
 
+  def test_should_cast_group_by_keys_of_a_column_unknown_to_the_schema_from_the_result
+    counts = Account
+      .joins("JOIN (SELECT tsrange(timestamp '2020-01-01', timestamp '2020-01-02') AS status) periods ON TRUE")
+      .group("periods.status")
+      .count
+
+    assert_equal({ Time.utc(2020, 1, 1)...Time.utc(2020, 1, 2) => Account.count }, counts)
+
+    counts = Account
+      .joins("JOIN (SELECT tsrange(timestamp '2020-01-01', timestamp '2020-01-02') AS status) periods ON TRUE")
+      .group("periods.status", :firm_id)
+      .count
+
+    assert_equal 1, counts[[Time.utc(2020, 1, 1)...Time.utc(2020, 1, 2), 1]]
+  end if current_adapter?(:PostgreSQLAdapter)
+
+  def test_should_cast_group_by_keys_of_a_typed_column_selected_by_a_cte_from_the_result
+    counts = Topic
+      .with(read: Topic.select(:id, :last_read))
+      .joins("JOIN read ON read.id = topics.id")
+      .where.not(last_read: nil)
+      .group("read.last_read")
+      .count
+
+    assert_equal [Date.new(2004, 4, 15)], counts.keys
+  end if current_adapter?(:SQLite3Adapter, :PostgreSQLAdapter)
+
+  def test_should_keep_an_explicit_value_type_for_group_by_keys
+    topic = Class.new(Topic) { attribute :last_read, ActiveModel::Type::Value.new }
+
+    assert_equal ["2004-04-15"], topic.where.not(last_read: nil).group(:last_read).count.keys
+  end if current_adapter?(:SQLite3Adapter, :PostgreSQLAdapter)
+
   def test_should_count_field_of_root_table_with_conflicting_group_by_column
     expected = { 1 => 2, 2 => 1, 4 => 5, 5 => 3, 7 => 1 }
     assert_equal expected, Post.joins(:comments).group(:post_id).count

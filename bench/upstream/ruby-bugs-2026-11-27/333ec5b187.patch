From 333ec5b1877a20ed187db753aedff666e2fa690f Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Fri, 27 Nov 2026 20:40:40 +0000
Subject: [PATCH] Skip an unused module refinement from the include's
 superclass

When a refinement of a module M is not active, a call to a method that
M itself does not define has to continue the search after M in the
receiver's ancestors. resolve_refined_method continued from
RCLASS_SUPER(me->owner), the superclass of the module M itself, which is
usually empty, instead of from the iclass that includes M. Lookups that
resolve refinements this way (send, public_send, Method objects,
respond_to? and calls from C via rb_funcall) then raised NoMethodError,
while a direct call found the method.

For example, an unused refinement of Kernel#== made `obj != 1` raise,
because BasicObject#!= calls #== with rb_funcall.

Continue from the superclass of the class where the refined entry was
found, as search_refined_method in vm_insnhelper.c already does for
direct calls.
---
 test/ruby/test_refinement.rb | 21 +++++++++++++++++++++
 vm_method.c                  |  3 ++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/test/ruby/test_refinement.rb b/test/ruby/test_refinement.rb
index 3f733989e9..163d4a4f40 100644
--- a/test/ruby/test_refinement.rb
+++ b/test/ruby/test_refinement.rb
@@ -4398,6 +4398,27 @@ def foo
     INPUT
   end
 
+  def test_unused_refinement_for_module_method_in_superclass
+    assert_separately([], <<-"end;")
+      class C
+        def foo = :C
+      end
+      module M
+      end
+      class D < C
+        include M
+      end
+      Module.new { refine(M) { def foo = :M } }
+      d = D.new
+      assert_equal(:C, d.send(:foo))
+      assert_equal(:C, d.method(:foo).call)
+      assert_respond_to(d, :foo)
+
+      Module.new { refine(Kernel) { def ==(other) = true } }
+      assert_equal(true, Object.new != 1)
+    end;
+  end
+
   def test_refining_module_repeatedly
     bug14070 = '[ruby-core:83617] [Bug #14070]'
     assert_in_out_err([], <<-INPUT, ["ok"], [], bug14070, timeout: 30)
diff --git a/vm_method.c b/vm_method.c
index 8377cc45aa..85ffc7b65f 100644
--- a/vm_method.c
+++ b/vm_method.c
@@ -2314,6 +2314,7 @@ resolve_refined_method(VALUE refinements, const rb_method_entry_t *me, VALUE *de
         VALUE refinement;
         const rb_method_entry_t *tmp_me;
         VALUE super;
+        VALUE defined_class = defined_class_ptr ? *defined_class_ptr : 0;
 
         refinement = find_refinement(refinements, me->owner);
         if (!NIL_P(refinement)) {
@@ -2338,7 +2339,7 @@ resolve_refined_method(VALUE refinements, const rb_method_entry_t *me, VALUE *de
             return tmp_me;
         }
 
-        super = RCLASS_SUPER(me->owner);
+        super = RCLASS_SUPER(defined_class ? defined_class : me->owner);
         if (!super) {
             return 0;
         }
-- 

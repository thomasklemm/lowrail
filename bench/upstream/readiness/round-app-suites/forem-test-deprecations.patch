diff --git a/config/environments/test.rb b/config/environments/test.rb
index 0df799dd0..74dad0d40 100644
--- a/config/environments/test.rb
+++ b/config/environments/test.rb
@@ -60,7 +60,11 @@
   config.active_support.test_order = :random
 
   # Raise exceptions for deprecation warnings.
-  config.active_support.deprecation = :raise
+  # Lowrail app-suites round: raise as Forem does, but only log Devise 4.9's route mapper deprecation.
+  config.active_support.deprecation = lambda do |message, callstack, deprecator|
+    behavior = message.match?(/received a hash argument .* removed in Rails 8\.2/) ? :stderr : :raise
+    ActiveSupport::Deprecation::DEFAULT_BEHAVIORS.fetch(behavior).call(message, callstack, deprecator)
+  end
 
   # Raise exceptions for disallowed deprecations.
   config.active_support.disallowed_deprecation = :raise

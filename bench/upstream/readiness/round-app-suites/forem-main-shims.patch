diff --git a/config/initializers/00_lowrail_jsonapi_has_one.rb b/config/initializers/00_lowrail_jsonapi_has_one.rb
new file mode 100644
index 000000000..bcd75d424
--- /dev/null
+++ b/config/initializers/00_lowrail_jsonapi_has_one.rb
@@ -0,0 +1,19 @@
+# Lowrail app-suites round, main checkout only: jsonapi-serializer 2.2.0 overrides
+# HasOne.define_accessors with the two-argument signature that Rails main changed (FO2).
+# Same effect as on 8-1: `#{name}_id` is defined on the model.
+ActiveSupport.on_load(:active_record) do
+  require "extensions/has_one"
+
+  ActiveRecord::Associations::Builder::HasOne.class_eval do
+    def self.define_accessors(model, reflection, mixin)
+      super
+      name = reflection.name
+      model.class_eval <<-CODE, __FILE__, __LINE__ + 1
+        def #{name}_id
+          return read_attribute(__method__) if has_attribute?(__method__)
+          association(:#{name}).reader.try(:id)
+        end
+      CODE
+    end
+  end
+end

+    RAILS_COMPONENTS = %w[rails railties activesupport activemodel activerecord actionpack actionview
+      actionmailer activejob actioncable activestorage actionmailbox actiontext].freeze
+
     def install_gems
+      use_eco_rails if ENV['ECO_RAILS']
+      return install_eco_project if ENV['ECO_RAILS'] && defined?(AcceptanceTests)
       CommandRunner.run!('bundle install --local') do |runner|
         runner.retries = 5
       end
@@ -65,6 +70,32 @@ module Tests
 
     private
 
+    # Lowrail readiness: test projects take every Rails gem from the suite's checkout (ECO_RAILS).
+    def use_eco_rails
+      path = ENV.fetch('ECO_RAILS')
+      gemfile = fs.find_in_project('Gemfile')
+      lines = File.read(gemfile).lines.map do |line|
+        name = line[/^\s*gem\s+['"]([\w-]+)['"]/, 1]
+        RAILS_COMPONENTS.include?(name) ? %(gem '#{name}', path: #{path.inspect}\n) : line
+      end
+      # Every test project depends on shoulda-matchers, and so on activesupport, also a plain Ruby one.
+      if lines.none? { |l| l.start_with?("gem 'activesupport'") }
+        lines << %(gem 'activesupport', path: #{path.inspect}\n)
+      end
+      File.write(gemfile, lines.join)
+    end
+
+    # Acceptance projects run with their own Gemfile (`bundle exec` with BUNDLE_GEMFILE), so bundle that one,
+    # outside the suite's bundle; `rails new` adds gems (debug, brakeman, ...) the suite's bundle lacks.
+    def install_eco_project
+      gemfile = fs.find_in_project('Gemfile').to_s
+      CommandRunner.run!('bundle install', env: { 'BUNDLE_GEMFILE' => gemfile }) do |runner|
+        runner.directory = fs.project_directory
+        runner.retries = 5
+        runner.around_command { |run| Bundler.with_original_env(&run) }
+      end
+    end
+
     def already_updating?
       @already_updating
     end

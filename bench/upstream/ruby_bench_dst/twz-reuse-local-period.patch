commit ba1f3642141a85d94a926487ab359b455292013e
Author: Thomas Klemm <github@tklemm.eu>
Date:   Thu Nov 5 21:03:54 2026 +0000

    Reuse the only local period when wrapping a TimeWithZone
    
    wrap_with_time_zone and change kept the current period only when it was
    among the periods for the new local time, and otherwise passed nil, so
    the constructor looked the same local time up in TZInfo again. That
    happens whenever the result is in another period than the receiver: on
    the other side of a DST change (70.days.ago, beginning_of_day on the day
    clocks change) or in another zone (change(zone:)).
    
    If the current period doesn't apply, the result is a plain UTC Time and
    its local time has exactly one period, pass that one on. The constructor
    uses such a Time unchanged and would look the same object up in the same
    zone, so it would find an equal, equally new period. Other values keep
    the old path, because there the constructor converts the time and can
    read a different wall clock than TZInfo did: a DateTime (also inside a
    TimeWithZone) is read by its Julian day, a fractional offset is
    truncated, and a local Time in a leap-second zone counts leap seconds (a
    UTC Time does too, but the constructor looks up that same object).
    Gaps, overlaps and zones without transitions keep the old path too; the
    latter so that results keep sharing the zone's memoized period.

diff --git a/activesupport/lib/active_support/time_with_zone.rb b/activesupport/lib/active_support/time_with_zone.rb
index cf5ab63eae..b30d11f75d 100644
--- a/activesupport/lib/active_support/time_with_zone.rb
+++ b/activesupport/lib/active_support/time_with_zone.rb
@@ -452,7 +452,7 @@ def change(options)
       new_zone ||= time_zone
       periods = new_zone.periods_for_local(new_time)
 
-      self.class.new(nil, new_zone, new_time, periods.include?(period) ? period : nil)
+      self.class.new(nil, new_zone, new_time, periods.include?(period) ? period : single_period(periods, new_time))
     end
 
     # Uses Date to provide precise Time calculations for years, months, and days
@@ -658,10 +658,17 @@ def duration_of_variable_length?(obj)
         ActiveSupport::Duration === obj && obj.variable?
       end
 
+      # The constructor would look this UTC Time up unchanged; zones without transitions keep their shared period.
+      def single_period(periods, time)
+        if periods.one? && time.instance_of?(::Time) && time.utc? && periods.first.instance_of?(::TZInfo::TransitionsTimezonePeriod)
+          periods.first
+        end
+      end
+
       def wrap_with_time_zone(time)
         if time.acts_like?(:time)
           periods = time_zone.periods_for_local(time)
-          self.class.new(nil, time_zone, time, periods.include?(period) ? period : nil)
+          self.class.new(nil, time_zone, time, periods.include?(period) ? period : single_period(periods, time))
         elsif time.is_a?(Range)
           wrap_with_time_zone(time.begin)..wrap_with_time_zone(time.end)
         else
diff --git a/activesupport/test/core_ext/time_with_zone_test.rb b/activesupport/test/core_ext/time_with_zone_test.rb
index af2e5b68eb..babd79bb97 100644
--- a/activesupport/test/core_ext/time_with_zone_test.rb
+++ b/activesupport/test/core_ext/time_with_zone_test.rb
@@ -794,6 +794,31 @@ def test_change_at_dst_boundary
     assert_equal twz, twz.change(min: 0)
   end
 
+  def test_change_offset_of_julian_datetime_across_dst_boundary
+    julian = DateTime.new(2026, 10, 20, 12, 0, 0, 0, Date::JULIAN)
+    twz = ActiveSupport::TimeWithZone.new(nil, ActiveSupport::TimeZone["America/New_York"], julian)
+    changed = twz.change(offset: "+01:00")
+    assert_equal 7200, changed.utc_offset
+    assert_equal "CEST", changed.zone
+    assert_predicate changed, :dst?
+    assert_equal Time.utc(2026, 10, 20, 10), changed.utc
+  end
+
+  def test_change_into_dst_gap_with_fractional_offset
+    twz = ActiveSupport::TimeWithZone.new(Time.utc(2026, 7, 1, 10), ActiveSupport::TimeZone["Amsterdam"])
+    changed = twz.change(month: 3, day: 29, hour: 2, offset: 3600.5)
+    assert_equal 7200, changed.utc_offset
+    assert_equal "CEST", changed.zone
+    assert_predicate changed, :dst?
+    assert_equal Time.utc(2026, 3, 29, 1, 0, 0.5), changed.utc
+  end
+
+  def test_change_zone_to_utc_keeps_the_shared_period
+    twz = ActiveSupport::TimeWithZone.new(Time.utc(2026, 7, 1, 10), ActiveSupport::TimeZone["Amsterdam"])
+    utc = ActiveSupport::TimeZone["UTC"]
+    assert_same utc.period_for_utc(Time.utc(2000)), twz.change(zone: utc).period
+  end
+
   def test_round_at_dst_boundary
     twz = ActiveSupport::TimeWithZone.new(Time.at(1319936400).getutc, ActiveSupport::TimeZone["Madrid"])
     assert_equal twz, twz.round

diff --git a/benchmarks/shipit/Gemfile.main-a b/benchmarks/shipit/Gemfile.main-a
new file mode 100644
index 0000000..8ac54eb
--- /dev/null
+++ b/benchmarks/shipit/Gemfile.main-a
@@ -0,0 +1,19 @@
+source "https://rubygems.org"
+
+# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
+gem "rails", path: "/home/user/workspace/r3/rails-wt/main"
+gem "sprockets-rails"
+# Use sqlite3 as the database for Active Record
+gem "sqlite3", ">= 2.1"
+# Use the Puma web server [https://github.com/puma/puma]
+gem "puma", ">= 5.0"
+
+# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
+gem "tzinfo-data", platforms: %i[ windows jruby ]
+
+gem "shipit-engine", path: "vendor/shipit-engine"
+
+# thread_safe (a dependency of shipit-engine via virtus) requires mutex_m on Ruby implementations other than CRuby,
+# and does not declare it as a dependency. mutex_m is no longer a default gem since Ruby 3.4.
+gem "mutex_m"
+gem "prism"

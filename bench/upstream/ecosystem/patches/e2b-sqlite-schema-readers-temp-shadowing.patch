From 472c680d15e6525152432db4549b23a69058aaaf Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 15:41:07 +0000
Subject: [PATCH] Let a temporary SQLite table or view hide a permanent one in
 the schema readers

The batched schema readers listed every row of sqlite_master and
sqlite_temp_master. When a temporary table had the name of a permanent
one, both rows matched, and the pragmas resolved both names to the
temporary table, so columns and indexes came back twice and the primary
key became composite. List a permanent table or view only when no
temporary table or view has its name, as SQLite does when it resolves a
name. Temporary indexes and triggers take no part in that, so they hide
nothing.
---
 .../sqlite3/schema_statements.rb              |  6 ++-
 .../adapters/sqlite3/sqlite3_adapter_test.rb  | 52 +++++++++++++++++--
 2 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/activerecord/lib/active_record/connection_adapters/sqlite3/schema_statements.rb b/activerecord/lib/active_record/connection_adapters/sqlite3/schema_statements.rb
index 64b1bad838..04e603f0f3 100644
--- a/activerecord/lib/active_record/connection_adapters/sqlite3/schema_statements.rb
+++ b/activerecord/lib/active_record/connection_adapters/sqlite3/schema_statements.rb
@@ -73,9 +73,11 @@ def schema_creation # :nodoc
           # sqlite_temp_master the temporary ones.
           MASTER_CTE = <<~SQL
             WITH master AS (
-              SELECT name, type, sql FROM sqlite_master
-              UNION ALL
               SELECT name, type, sql FROM sqlite_temp_master
+              UNION ALL
+              SELECT name, type, sql FROM sqlite_master
+              WHERE type NOT IN ('table', 'view')
+                OR name NOT IN (SELECT name FROM sqlite_temp_master WHERE type IN ('table', 'view'))
             )
           SQL
 
diff --git a/activerecord/test/cases/adapters/sqlite3/sqlite3_adapter_test.rb b/activerecord/test/cases/adapters/sqlite3/sqlite3_adapter_test.rb
index 3dac5cca5f..8b405bc030 100644
--- a/activerecord/test/cases/adapters/sqlite3/sqlite3_adapter_test.rb
+++ b/activerecord/test/cases/adapters/sqlite3/sqlite3_adapter_test.rb
@@ -525,9 +525,11 @@ def test_insert_logged
           tables_query = ["SELECT name FROM pragma_table_list WHERE schema <> 'temp' AND name NOT IN ('sqlite_sequence', 'sqlite_schema') AND type IN ('table','view')", "SCHEMA", []]
           structure_query = [<<~SQL.squish, "SCHEMA", []]
             WITH master AS (
-              SELECT name, type, sql FROM sqlite_master
-              UNION ALL
               SELECT name, type, sql FROM sqlite_temp_master
+              UNION ALL
+              SELECT name, type, sql FROM sqlite_master
+              WHERE type NOT IN ('table', 'view')
+                OR name NOT IN (SELECT name FROM sqlite_temp_master WHERE type IN ('table', 'view'))
             )
             SELECT m.name AS table_name, CASE WHEN m.type = 'table' THEN m.sql END AS create_table_sql,
                    t."name", t."type", t."notnull", t."dflt_value", t."pk", t."hidden"
@@ -712,9 +714,11 @@ def test_indexes_logs
         with_example_table do
           index_list_query = [<<~SQL.squish, "SCHEMA", []]
             WITH master AS (
-              SELECT name, type, sql FROM sqlite_master
-              UNION ALL
               SELECT name, type, sql FROM sqlite_temp_master
+              UNION ALL
+              SELECT name, type, sql FROM sqlite_master
+              WHERE type NOT IN ('table', 'view')
+                OR name NOT IN (SELECT name FROM sqlite_temp_master WHERE type IN ('table', 'view'))
             )
             SELECT m.name AS table_name, i.name, i."unique"
             FROM master m
@@ -892,6 +896,46 @@ def test_no_primary_key
         end
       end
 
+      def test_schema_readers_read_a_temporary_table_that_hides_a_permanent_one
+        with_example_table "id integer PRIMARY KEY, number integer", "shadowed" do
+          @conn.execute 'CREATE TEMP TABLE shadowed (temp_id integer PRIMARY KEY, "temp_name" text COLLATE "NOCASE")'
+          @conn.execute "CREATE INDEX temp.index_shadowed_on_temp_name ON shadowed (temp_name)"
+
+          assert_equal %w[ temp_id temp_name ], @conn.columns("shadowed").map(&:name)
+          assert_equal "NOCASE", @conn.columns("shadowed").last.collation
+          assert_equal "temp_id", @conn.primary_key("shadowed")
+          assert_equal ["index_shadowed_on_temp_name"], @conn.indexes("shadowed").map(&:name)
+        ensure
+          @conn.execute "DROP TABLE IF EXISTS temp.shadowed"
+        end
+      end
+
+      def test_schema_readers_read_a_temporary_view_that_hides_a_permanent_table
+        with_example_table "id integer PRIMARY KEY, number integer", "shadowed" do
+          @conn.execute "CREATE TEMP VIEW shadowed AS SELECT 1 AS view_column"
+
+          assert_equal %w[ view_column ], @conn.columns("shadowed").map(&:name)
+        ensure
+          @conn.execute "DROP VIEW IF EXISTS temp.shadowed"
+        end
+      end
+
+      def test_schema_readers_are_not_hidden_by_temporary_indexes_triggers_or_tables_of_other_names
+        with_example_table "id integer PRIMARY KEY, number integer", "shadowed" do
+          @conn.add_index "shadowed", :number
+          @conn.execute "CREATE TEMP TABLE index_shadowed_on_number (other integer)"
+          @conn.execute "CREATE INDEX temp.shadowed ON index_shadowed_on_number (other)"
+          @conn.execute "CREATE TEMP TRIGGER shadowed AFTER INSERT ON main.shadowed BEGIN SELECT 1; END"
+
+          assert_equal %w[ id number ], @conn.columns("shadowed").map(&:name)
+          assert_equal "id", @conn.primary_key("shadowed")
+          assert_equal [%w[ number ]], @conn.indexes("shadowed").map(&:columns)
+        ensure
+          @conn.execute "DROP TABLE IF EXISTS temp.index_shadowed_on_number"
+          @conn.execute "DROP TRIGGER IF EXISTS temp.shadowed"
+        end
+      end
+
       class Barcode < ActiveRecord::Base
       end
 

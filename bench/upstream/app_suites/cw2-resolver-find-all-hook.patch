From e910df6df3a92139f3edc9e10ce8262a7a3c1412 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 20:59:11 +0000
Subject: [PATCH] Call a custom resolver's _find_all again

Resolver#find_all called the private _find_all, which called
find_templates, until 9987431315 made find_all call find_templates
directly. Custom resolvers that override _find_all instead of
find_templates are no longer called: a Resolver subclass that only
defines _find_all raises NotImplementedError from find_templates.

Restore the hook in Resolver: find_all calls _find_all again, and its
default calls find_templates. Resolver#find still goes through
find_all, so overriding either keeps working. FileSystemResolver keeps
its own find and find_all.
---
 .../lib/action_view/template/resolver.rb      |  6 +++-
 .../actionpack/controller/view_paths_test.rb  | 32 +++++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/actionview/lib/action_view/template/resolver.rb b/actionview/lib/action_view/template/resolver.rb
index 4ee54c0aae..909517ca47 100644
--- a/actionview/lib/action_view/template/resolver.rb
+++ b/actionview/lib/action_view/template/resolver.rb
@@ -66,7 +66,7 @@ def clear_cache
     end
 
     def find_all(name, prefix = nil, partial = false, details = {}, key = nil, locals = [])
-      find_templates(name, prefix, partial, details, locals)
+      _find_all(name, prefix, partial, details, key, locals)
     end
 
     def find(name, prefix = nil, partial = false, details = {}, key = nil, locals = [])
@@ -84,6 +84,10 @@ def all_template_paths # :nodoc:
     end
 
   private
+    def _find_all(name, prefix, partial, details, key, locals)
+      find_templates(name, prefix, partial, details, locals)
+    end
+
     delegate :caching?, to: :class
 
     # Extension point for custom resolvers: implement this method, or
diff --git a/actionview/test/actionpack/controller/view_paths_test.rb b/actionview/test/actionpack/controller/view_paths_test.rb
index 4e2446f724..74cec2b708 100644
--- a/actionview/test/actionpack/controller/view_paths_test.rb
+++ b/actionview/test/actionpack/controller/view_paths_test.rb
@@ -47,6 +47,14 @@ def expand(array)
     array.map { |x| File.expand_path(x.to_s) }
   end
 
+  def assert_renders_through_custom_resolver(resolver, body)
+    TestController.view_paths = ActionView::PathSet.new([resolver])
+
+    get :hello_world
+    assert_equal body, @response.body
+    assert_equal [body], TestController.view_paths.find_all("hello_world", ["test"], false, {}, nil, []).map(&:source)
+  end
+
   def assert_paths(*paths)
     controller = paths.first.is_a?(Class) ? paths.shift : @controller
     assert_equal expand(paths), controller.view_paths.map(&:to_s)
@@ -186,6 +194,30 @@ def find_all(*args)
     assert_equal "Decorated body", @response.body
   end
 
+  def test_custom_resolver_overriding_find_all_hook
+    resolver_class = Class.new(ActionView::Resolver) do
+      private
+        def _find_all(name, prefix, partial, details, key, locals)
+          [::ActionView::Template.new("From _find_all", "custom", ::ActionView::Template::Handlers::Raw.new,
+            virtual_path: "#{prefix}/#{name}", format: :html, locals: locals)]
+        end
+    end
+
+    assert_renders_through_custom_resolver resolver_class.new, "From _find_all"
+  end
+
+  def test_custom_resolver_implementing_find_templates
+    resolver_class = Class.new(ActionView::Resolver) do
+      private
+        def find_templates(name, prefix, partial, details, locals = [])
+          [::ActionView::Template.new("From find_templates", "custom", ::ActionView::Template::Handlers::Raw.new,
+            virtual_path: "#{prefix}/#{name}", format: :html, locals: locals)]
+        end
+    end
+
+    assert_renders_through_custom_resolver resolver_class.new, "From find_templates"
+  end
+
   def test_inheritance
     original_load_paths = ActionController::Base.view_paths
 

From ebbb6c49beccc4abad7766033d4d72cebcd41004 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Thu, 5 Nov 2026 12:59:29 +0000
Subject: [PATCH] Accept a column name in build_bind_attribute again,
 deprecated

Since query predicate expressions were added, PredicateBuilder#build_bind_attribute
takes an Arel attribute, and callers that pass a column name, as on 8.1, raise
NoMethodError. Build the bind as 8.1 did, from the name and the table's type for
it, and warn.
---
 activerecord/CHANGELOG.md                     |  6 +++
 .../relation/predicate_builder.rb             | 11 +++++
 .../cases/relation/predicate_builder_test.rb  | 46 +++++++++++++++++++
 3 files changed, 63 insertions(+)

diff --git a/activerecord/CHANGELOG.md b/activerecord/CHANGELOG.md
index 4ad8bfd285..00a7bebb59 100644
--- a/activerecord/CHANGELOG.md
+++ b/activerecord/CHANGELOG.md
@@ -1,3 +1,9 @@
+*   Deprecate passing a column name to `ActiveRecord::PredicateBuilder#build_bind_attribute`.
+
+    Pass the column's Arel attribute instead, such as `arel_table[:login]`. Rails 8.1 needs the column name.
+
+    *Thomas Klemm*
+
 *   Retry `ActiveRecord::SerializationFailure` on queries that opted into retries.
 
     A serialization failure rolls back whatever the statement was part of, so a
diff --git a/activerecord/lib/active_record/relation/predicate_builder.rb b/activerecord/lib/active_record/relation/predicate_builder.rb
index ec7c878395..a54bcebef8 100644
--- a/activerecord/lib/active_record/relation/predicate_builder.rb
+++ b/activerecord/lib/active_record/relation/predicate_builder.rb
@@ -126,6 +126,17 @@ def predicate_value(attribute, value)
     end
 
     def build_bind_attribute(attribute, value)
+      # Checked first so the common Arel attribute path pays one extra is_a?.
+      if !attribute.is_a?(Arel::Attributes::Attribute) && (attribute.is_a?(String) || attribute.is_a?(Symbol))
+        ActiveRecord.deprecator.warn(<<~MSG.squish)
+          Passing a column name to `ActiveRecord::PredicateBuilder#build_bind_attribute`
+          is deprecated and will be removed in Rails 9.0. Pass the column's Arel
+          attribute instead, such as `arel_table[#{attribute.to_sym.inspect}]`;
+          Rails 8.1 needs the column name.
+        MSG
+        return Relation::QueryAttribute.new(attribute, value, table.arel_table.type_for_attribute(attribute))
+      end
+
       bind = Relation::QueryAttribute.new(attribute.name, value, attribute.type_caster)
       attribute.is_a?(ComparisonAttribute) ? ComparisonValue.new(bind) : bind
     end
diff --git a/activerecord/test/cases/relation/predicate_builder_test.rb b/activerecord/test/cases/relation/predicate_builder_test.rb
index 82d7b2569f..e69a1b47dc 100644
--- a/activerecord/test/cases/relation/predicate_builder_test.rb
+++ b/activerecord/test/cases/relation/predicate_builder_test.rb
@@ -244,6 +244,52 @@ def test_build_from_hash_with_dot_notation_matches_nested_hash
       assert_equal hash_predicates.map(&:to_sql), dot_predicates.map(&:to_sql)
     end
 
+    def test_build_bind_attribute_with_a_column_name_is_deprecated
+      topic = Topic.create!(title: "Rails")
+
+      [:id, "id"].each do |column_name|
+        bind = assert_deprecated(/Pass the column's Arel attribute/, ActiveRecord.deprecator) do
+          Topic.predicate_builder.build_bind_attribute(column_name, topic.id.to_s)
+        end
+
+        assert_equal column_name, bind.name
+        assert_same Topic.type_for_attribute("id"), bind.type
+        assert_equal topic.id, bind.value_for_database
+        assert_equal [topic], Topic.where(Topic.arel_table[:id].eq(bind)).to_a
+      end
+    end
+
+    def test_build_bind_attribute_with_a_column_name_on_a_table_without_a_model
+      arel_table = Arel::Table.new(name: "topics", type_caster: ActiveRecord::TypeCaster::Connection.new(Topic, "topics"))
+      builder = PredicateBuilder.new(TableMetadata.new(nil, arel_table))
+      bind = assert_deprecated(/Pass the column's Arel attribute/, ActiveRecord.deprecator) do
+        builder.build_bind_attribute("id", "1")
+      end
+
+      assert_equal 1, bind.value_for_database
+    end
+
+    def test_build_bind_attribute_with_an_attribute_alias_keeps_the_alias_name
+      bind = assert_deprecated(/Pass the column's Arel attribute/, ActiveRecord.deprecator) do
+        Topic.predicate_builder.build_bind_attribute("heading", "Rails")
+      end
+
+      expected = Relation::QueryAttribute.new("heading", "Rails", Topic.arel_table.type_for_attribute("heading"))
+      assert_equal expected, bind
+    end
+
+    def test_build_bind_attribute_with_a_column_name_of_a_comparison_type_is_a_plain_bind
+      type = LowerString.new
+      bind = assert_deprecated(/Pass the column's Arel attribute/, ActiveRecord.deprecator) do
+        topic_model_with_title_type(type).predicate_builder.build_bind_attribute("title", "Rails")
+      end
+
+      assert_instance_of Relation::QueryAttribute, bind
+      assert_equal "title", bind.name
+      assert_same type, bind.type
+      assert_equal "Rails", bind.value_for_database
+    end
+
     def test_does_not_mutate
       defaults = { topics: { title: "rails" }, "topics.approved" => true }
       Topic.where(defaults).to_sql

From 1e3539559d0a23c1a6b72b22b040828af8bab329 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 20:45:13 +0000
Subject: [PATCH] Don't allocate a keyword Hash in Object#try without keywords

2709a9f16d replaced ruby2_keywords in Object#try and #try! with a named
**kwargs parameter. A named keyword splat builds a new Hash on every
call, also when no keywords are passed, so each try(:name) allocates
one object more than in Rails 8.1.

Forward the keywords with an anonymous ** instead, which Ruby 3.4 and
later don't allocate for when no keywords are passed. The block form is
again chosen when there are no positional arguments, as in 8.1.
---
 .../lib/active_support/core_ext/object/try.rb | 12 ++++++------
 .../test/core_ext/object/try_test.rb          | 19 +++++++++++++++++++
 2 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/activesupport/lib/active_support/core_ext/object/try.rb b/activesupport/lib/active_support/core_ext/object/try.rb
index b56b0d10c4..084e72dc40 100644
--- a/activesupport/lib/active_support/core_ext/object/try.rb
+++ b/activesupport/lib/active_support/core_ext/object/try.rb
@@ -4,27 +4,27 @@
 
 module ActiveSupport
   module Tryable # :nodoc:
-    def try(*args, **kwargs, &block)
-      if args.empty? && kwargs.empty? && block_given?
+    def try(*args, **, &block)
+      if args.empty? && block_given?
         if block.arity == 0
           instance_eval(&block)
         else
           yield self
         end
       elsif respond_to?(args.first)
-        public_send(*args, **kwargs, &block)
+        public_send(*args, **, &block)
       end
     end
 
-    def try!(*args, **kwargs, &block)
-      if args.empty? && kwargs.empty? && block_given?
+    def try!(*args, **, &block)
+      if args.empty? && block_given?
         if block.arity == 0
           instance_eval(&block)
         else
           yield self
         end
       else
-        public_send(*args, **kwargs, &block)
+        public_send(*args, **, &block)
       end
     end
   end
diff --git a/activesupport/test/core_ext/object/try_test.rb b/activesupport/test/core_ext/object/try_test.rb
index 135acdd4be..235af2b8a4 100644
--- a/activesupport/test/core_ext/object/try_test.rb
+++ b/activesupport/test/core_ext/object/try_test.rb
@@ -36,6 +36,14 @@ def test_valid_method
     assert_equal 5, @string.try(:size)
   end
 
+  if RUBY_VERSION >= "3.4"
+    def test_try_without_keywords_allocates_only_the_argument_array
+      object = Class.new { def ping = :pong }.new
+      assert_equal 1, allocations { object.try(:ping) }
+      assert_equal 1, allocations { object.try!(:ping) }
+    end
+  end
+
   def test_argument_forwarding
     assert_equal "Hey", @string.try(:sub, "llo", "y")
   end
@@ -157,4 +165,15 @@ def private_method
       Decorator.new(klass.new).try!(:private_method)
     end
   end
+
+  private
+    # The second round runs on warm call sites.
+    def allocations
+      counts = 2.times.map do
+        before = GC.stat(:total_allocated_objects)
+        yield
+        GC.stat(:total_allocated_objects) - before
+      end
+      counts.last
+    end
 end
-- 
2.39.5


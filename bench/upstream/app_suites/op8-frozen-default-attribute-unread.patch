From 9b2a64d040bbf2e655fbd03f6000ac9110148f4b Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Thu, 5 Nov 2026 15:57:54 +0000
Subject: [PATCH] Keep models with mutable defaults off the frozen defaults

Since a model's default attributes are frozen when every one is
freezable, freezing casts each default once and every new record dups
that cast value. Mutable defaults break:

* a serialized default whose coder does not round-trip the column
  default reads as changed in a record that never touched it, so it is
  saved: a NOT NULL jsonb column with default '{}' and a coder that
  loads it as [] is inserted as NULL;
* a default with nested objects is shared, so a change made through one
  new record shows up in the next.

Types now say whether a default can be frozen. A type that includes
Helpers::Mutable (JSON, PostgreSQL arrays, hstore, points) can freeze
only a NULL default, a serialized type never can, since its coder may
load NULL as a container, and encrypted and normalized types defer to
the type they wrap. A type without the hook, such as one that doesn't
inherit Type::Value, can freeze, as on main. A model with a default that
can't be frozen keeps the writable defaults it had before, so its
defaults are not cast at schema load and each record casts its own.
Other custom mutable types and decorators override or forward the hook;
otherwise they still freeze, as on main.
---
 activemodel/lib/active_model/attribute.rb     |  2 +-
 .../active_model/attributes/normalization.rb  |  4 +
 .../lib/active_model/type/helpers/mutable.rb  |  4 +
 activemodel/lib/active_model/type/value.rb    |  4 +
 activemodel/test/cases/attribute_test.rb      | 19 ++++
 .../encryption/encrypted_attribute_type.rb    |  4 +
 .../lib/active_record/type/serialized.rb      |  5 ++
 .../test/cases/serialized_attribute_test.rb   | 89 +++++++++++++++++++
 8 files changed, 130 insertions(+), 1 deletion(-)

diff --git a/activemodel/lib/active_model/attribute.rb b/activemodel/lib/active_model/attribute.rb
index e358a34021..4916d546e2 100644
--- a/activemodel/lib/active_model/attribute.rb
+++ b/activemodel/lib/active_model/attribute.rb
@@ -40,7 +40,7 @@ def initialize(name, value_before_type_cast, type, original_attribute = nil, val
     end
 
     def freezable?
-      true
+      !type.respond_to?(:freezable_default?) || type.freezable_default?(value_before_type_cast)
     end
 
     def freeze
diff --git a/activemodel/lib/active_model/attributes/normalization.rb b/activemodel/lib/active_model/attributes/normalization.rb
index 66ec959881..5bc8e52254 100644
--- a/activemodel/lib/active_model/attributes/normalization.rb
+++ b/activemodel/lib/active_model/attributes/normalization.rb
@@ -185,6 +185,10 @@ def serialize_cast_value(value)
             ActiveModel::Type::SerializeCastValue.serialize(cast_type, value)
           end
 
+          def freezable_default?(value)
+            !cast_type.respond_to?(:freezable_default?) || cast_type.freezable_default?(value)
+          end
+
           def ==(other)
             self.class == other.class &&
               normalize_nil? == other.normalize_nil? &&
diff --git a/activemodel/lib/active_model/type/helpers/mutable.rb b/activemodel/lib/active_model/type/helpers/mutable.rb
index ea7320651d..2a210ee319 100644
--- a/activemodel/lib/active_model/type/helpers/mutable.rb
+++ b/activemodel/lib/active_model/type/helpers/mutable.rb
@@ -18,6 +18,10 @@ def changed_in_place?(raw_old_value, new_value)
         def mutable? # :nodoc:
           true
         end
+
+        def freezable_default?(value)
+          value.nil?
+        end
       end
     end
   end
diff --git a/activemodel/lib/active_model/type/value.rb b/activemodel/lib/active_model/type/value.rb
index a1bd3be271..9f8a449d2d 100644
--- a/activemodel/lib/active_model/type/value.rb
+++ b/activemodel/lib/active_model/type/value.rb
@@ -142,6 +142,10 @@ def mutable? # :nodoc:
         true
       end
 
+      def freezable_default?(value) # :nodoc:
+        true
+      end
+
       def as_json(*)
         raise NoMethodError
       end
diff --git a/activemodel/test/cases/attribute_test.rb b/activemodel/test/cases/attribute_test.rb
index ff7e6aa291..a2eeb1fad1 100644
--- a/activemodel/test/cases/attribute_test.rb
+++ b/activemodel/test/cases/attribute_test.rb
@@ -339,6 +339,25 @@ def initialize_dup(*)
       end
     end
 
+    test "an attribute with a Type::Value type is freezable" do
+      assert_predicate Attribute.from_database(:foo, "b", Type::Value.new), :freezable?
+    end
+
+    test "an attribute with a type that doesn't inherit Type::Value is freezable" do
+      type = Object.new
+      def type.deserialize(value) = value
+
+      assert_predicate Attribute.from_database(:foo, "b", type), :freezable?
+    end
+
+    test "an attribute with a mutable type is freezable only with a nil default" do
+      type = Class.new(Type::Value) { include Type::Helpers::Mutable }.new
+
+      assert_predicate Attribute.from_database(:foo, nil, type), :freezable?
+      assert_not_predicate Attribute.from_database(:foo, "b", type), :freezable?
+      assert_not_predicate Attribute.from_database(:foo, "b", DelegateClass(Type::Value).new(type)), :freezable?
+    end
+
     test "with_type preserves mutations" do
       attribute = Attribute.from_database(:foo, +"", Type::Value.new)
       attribute.value << "1"
diff --git a/activerecord/lib/active_record/encryption/encrypted_attribute_type.rb b/activerecord/lib/active_record/encryption/encrypted_attribute_type.rb
index 7ea54d1e12..2130e4c896 100644
--- a/activerecord/lib/active_record/encryption/encrypted_attribute_type.rb
+++ b/activerecord/lib/active_record/encryption/encrypted_attribute_type.rb
@@ -48,6 +48,10 @@ def encrypted?(value)
         with_context { encryptor.encrypted? value }
       end
 
+      def freezable_default?(value) # :nodoc:
+        !cast_type.respond_to?(:freezable_default?) || cast_type.freezable_default?(value)
+      end
+
       def changed_in_place?(raw_old_value, new_value)
         old_value = raw_old_value.nil? ? nil : deserialize(raw_old_value)
         old_value != new_value
diff --git a/activerecord/lib/active_record/type/serialized.rb b/activerecord/lib/active_record/type/serialized.rb
index a0fcc21288..9e7e003f56 100644
--- a/activerecord/lib/active_record/type/serialized.rb
+++ b/activerecord/lib/active_record/type/serialized.rb
@@ -70,6 +70,11 @@ def serialized? # :nodoc:
         true
       end
 
+      def freezable_default?(value)
+        # The coder may load even a nil default as a container.
+        false
+      end
+
       private
         # Prevent Ruby 4.0 "delegator does not forward private method" warning.
         # Kernel#inspect calls instance_variables_to_inspect which, without this,
diff --git a/activerecord/test/cases/serialized_attribute_test.rb b/activerecord/test/cases/serialized_attribute_test.rb
index c386d0ab46..a4b3f69a79 100644
--- a/activerecord/test/cases/serialized_attribute_test.rb
+++ b/activerecord/test/cases/serialized_attribute_test.rb
@@ -75,6 +75,95 @@ def test_serialized_attribute_with_default
     assert_equal({ key: "value" }, t.content)
   end
 
+  def test_serialized_column_default_is_unchanged_on_a_new_record_until_read
+    coder = Class.new do
+      def self.load(value) = value.blank? ? [] : JSON.parse(value)
+      def self.dump(value) = JSON.dump(value)
+    end
+    klass = Class.new(ActiveRecord::Base) do
+      self.table_name = "admin_users"
+      serialize :preferences, coder: coder
+    end
+
+    user = klass.new
+    assert_not_predicate user, :changed?
+    user.save!(validate: false)
+    assert_equal "", user.reload.preferences_before_type_cast
+
+    user = klass.new
+    assert_equal [], user.preferences
+    assert_predicate user, :changed?
+  end
+
+  def test_freezing_eligibility_of_column_defaults
+    main_ractor_connection(ActiveRecord::Base.lease_connection).create_table(:serialized_defaults, force: true) do |t|
+      t.string :settings, default: '{"theme":{"mode":"light"}}'
+      t.json :data
+      t.string :options
+    end
+    plain = Class.new(ActiveRecord::Base) do
+      self.table_name = "serialized_defaults"
+      serialize :settings, coder: JSON
+    end
+    normalized = Class.new(plain) { normalizes :settings, with: ->(settings) { settings } }
+
+    [plain, normalized].each do |klass|
+      klass.new.settings["theme"]["mode"] = "dark"
+      assert_equal "light", klass.new.settings["theme"]["mode"]
+      assert_not_predicate klass.new, :changed?
+    end
+
+    with_null_json = Class.new(ActiveRecord::Base) { self.table_name = "serialized_defaults" }
+    with_json_default = Class.new(with_null_json) { attribute :settings, :json }
+    with_null_serialized = Class.new(with_null_json) { serialize :options, coder: JSON }
+    assert_predicate with_null_json._default_attributes, :frozen?
+    assert_not_predicate with_json_default._default_attributes, :frozen?
+    assert_not_predicate with_null_serialized._default_attributes, :frozen?
+    assert_not_predicate Class.new(with_null_serialized) { encrypts :options }._default_attributes, :frozen?
+    assert_predicate Class.new(with_null_json) { encrypts :settings, :options }._default_attributes, :frozen?
+    assert_predicate Class.new(with_null_json) { normalizes :data, with: ->(data) { data } }._default_attributes, :frozen?
+
+    json = ActiveRecord::Type::Json.new
+    [
+      ActiveRecord::Encryption::EncryptedAttributeType.new(scheme: ActiveRecord::Encryption::Scheme.new, cast_type: json),
+      ActiveModel::Attributes::Normalization::NormalizedValueType.new(cast_type: json, normalizer: ->(value) { value }, normalize_nil: false),
+    ].each do |type|
+      assert type.freezable_default?(nil)
+      assert_not type.freezable_default?("{}")
+    end
+
+    duck_type = Object.new
+    def duck_type.deserialize(value) = value
+    assert_predicate Class.new(with_null_json) { attribute :options, duck_type; encrypts :options }._default_attributes, :frozen?
+    assert_predicate Class.new(with_null_json) { attribute :options, duck_type; normalizes :options, with: ->(options) { options } }._default_attributes, :frozen?
+
+    nested_coder = Class.new do
+      def self.load(value) = value.nil? ? { "theme" => { "mode" => "light" } } : JSON.parse(value)
+      def self.dump(value) = JSON.dump(value)
+    end
+    with_nested_null = Class.new(with_null_json) { serialize :options, coder: nested_coder }
+    with_nested_null.new.options["theme"]["mode"] = "dark"
+    assert_equal "light", with_nested_null.new.options["theme"]["mode"]
+  ensure
+    main_ractor_connection(ActiveRecord::Base.lease_connection).drop_table(:serialized_defaults, if_exists: true)
+  end
+
+  def test_schema_load_and_new_leave_a_serialized_default_unloaded
+    coder = Class.new do
+      singleton_class.attr_accessor :calls
+      self.calls = 0
+      def self.load(value) = (self.calls += 1; value)
+      def self.dump(value) = (self.calls += 1; value)
+    end
+    klass = Class.new(ActiveRecord::Base) do
+      self.table_name = "admin_users"
+      serialize :preferences, coder: coder
+    end
+
+    klass.new
+    assert_equal 0, coder.calls
+  end
+
   def test_serialized_attribute_on_custom_attribute_with_default
     klass = Class.new(ActiveRecord::Base) do
       self.table_name = Topic.table_name

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 09:40:50 +0000
Subject: [PATCH] Check URL components for unsafe characters with an anchored
 match

`UriEncoder#escape` returns a component as is when nothing in it needs
escaping. It found that out by searching the component for an unsafe
character, which tries the negated character class at every position.
Matching the whole component against the safe characters, as
`xml_name_escape` does with `SAFE_XML_TAG_NAME_REGEXP`, gives the same
answer for every valid string in an ASCII-compatible encoding and
raises the same errors otherwise.

It is faster for components up to a few hundred thousand characters.
Longer ones take two to three times as long, so a tight
`Regexp.timeout` is reached sooner for them.

The tests check that components made only of safe characters come back
as the same object, that every ASCII character and two non-ASCII ones
give the same result through the early return as through escaping, and
that a component whose last line is safe still has its earlier lines
escaped.
---
 .../action_dispatch/journey/router/utils.rb   | 14 +++++---
 actionpack/test/journey/router/utils_test.rb  | 33 +++++++++++++++++++
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/actionpack/lib/action_dispatch/journey/router/utils.rb b/actionpack/lib/action_dispatch/journey/router/utils.rb
index 061eefd7ac..250cfb17e9 100644
--- a/actionpack/lib/action_dispatch/journey/router/utils.rb
+++ b/actionpack/lib/action_dispatch/journey/router/utils.rb
@@ -64,21 +64,25 @@ class UriEncoder # :nodoc:
           SEGMENT  = /[^#{UNRESERVED}#{SUB_DELIMS}:@]/
           PATH     = /[^#{UNRESERVED}#{SUB_DELIMS}:@\/]/
 
+          SAFE_FRAGMENT = /\A[#{UNRESERVED}#{SUB_DELIMS}:@\/?]*\z/
+          SAFE_SEGMENT  = /\A[#{UNRESERVED}#{SUB_DELIMS}:@]*\z/
+          SAFE_PATH     = /\A[#{UNRESERVED}#{SUB_DELIMS}:@\/]*\z/
+
           def escape_fragment(fragment)
-            escape(fragment, FRAGMENT)
+            escape(fragment, FRAGMENT, SAFE_FRAGMENT)
           end
 
           def escape_path(path)
-            escape(path, PATH)
+            escape(path, PATH, SAFE_PATH)
           end
 
           def escape_segment(segment)
-            escape(segment, SEGMENT)
+            escape(segment, SEGMENT, SAFE_SEGMENT)
           end
 
           private
-            def escape(component, pattern)
-              return component unless component.match?(pattern)
+            def escape(component, pattern, safe_pattern)
+              return component if component.match?(safe_pattern)
 
               component.gsub(pattern) { |unsafe| percent_encode(unsafe) }.force_encoding(US_ASCII)
             end
diff --git a/actionpack/test/journey/router/utils_test.rb b/actionpack/test/journey/router/utils_test.rb
index 6f20489b5e..c9ef47cc56 100644
--- a/actionpack/test/journey/router/utils_test.rb
+++ b/actionpack/test/journey/router/utils_test.rb
@@ -18,6 +18,39 @@ def test_fragment_escape
           assert_equal "a/b%20c+d%25?e", Utils.escape_fragment("a/b c+d%?e")
         end
 
+        def test_escape_gives_the_same_result_whether_or_not_the_component_needs_escaping
+          ((0..127).map(&:chr) + ["\u00E9", "\u00A0"]).each do |char|
+            assert_equal Utils.escape_path("#{char}%"), "#{Utils.escape_path(char)}%25"
+            assert_equal Utils.escape_segment("#{char}%"), "#{Utils.escape_segment(char)}%25"
+            assert_equal Utils.escape_fragment("#{char}%"), "#{Utils.escape_fragment(char)}%25"
+          end
+        end
+
+        def test_escape_returns_components_without_unsafe_characters_unchanged
+          safe = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~!$&'()*+,;=:@"
+          { escape_segment: safe, escape_path: "#{safe}/", escape_fragment: "#{safe}/?" }.each do |method, chars|
+            [chars.dup.force_encoding(Encoding::UTF_8).freeze, +"", ActiveSupport::SafeBuffer.new(chars)].each do |component|
+              assert_same component, Utils.public_send(method, component)
+            end
+          end
+        end
+
+        def test_escape_encodes_unsafe_characters_as_us_ascii
+          escaped = Utils.escape_segment("café 1")
+          assert_equal "caf%C3%A9%201", escaped
+          assert_equal Encoding::US_ASCII, escaped.encoding
+        end
+
+        def test_escape_encodes_unsafe_characters_on_any_line
+          assert_equal "a%20b%0Ac", Utils.escape_segment("a b\nc")
+          assert_equal "a%20b%0Ac", Utils.escape_path("a b\nc")
+          assert_equal "a%20b%0Ac", Utils.escape_fragment("a b\nc")
+        end
+
+        def test_escape_raises_on_invalid_byte_sequences
+          assert_raises(ArgumentError) { Utils.escape_segment((+"abc\xFF").force_encoding(Encoding::UTF_8)) }
+        end
+
         def test_CGI_unescapeURIComponent
           assert_equal "a/b c+d", CGI.unescapeURIComponent("a%2Fb%20c+d")
         end

From d5252fae22510aad2a3993f05fba8fad1589337c Mon Sep 17 00:00:00 2001
From: Thomas Klemm <github@tklemm.eu>
Date: Wed, 4 Nov 2026 13:32:32 +0000
Subject: [PATCH] Keep the UTC offset in Time#change for times with a zone
 object

Time#change built the new time with Time.new(..., zone) and then moved
it to the second occurrence of a repeated hour when that matched the
original offset. For a TZInfo::Timezone with TZInfo's default
ambiguity settings, Time.new raises TZInfo::AmbiguousTime for a local
time in the repeated hour, so change(nsec:), change(hour:) and Active
Model's datetime cast, when precision truncation is needed, raised
there. Where the zone picks the other occurrence, as
ActiveSupport::TimeZone does for Europe/Dublin (whose winter time
counts as DST), the original offset was missed and change returned a
time one hour later.

It now tries the original UTC offset first and keeps it when the zone
gives that offset for the new local time, which is the occurrence
change already meant to pick, and builds the time from the zone as
before otherwise. When neither occurrence of the new local time has
the original offset, the zone picks as before, so a TZInfo zone still
raises there; a time in a skipped hour still raises as before.
---
 activemodel/test/cases/type/date_time_test.rb |  8 +++
 activesupport/CHANGELOG.md                    | 14 +++++
 .../core_ext/time/calculations.rb             | 23 +++-----
 activesupport/test/core_ext/time_ext_test.rb  | 53 +++++++++++++++++++
 4 files changed, 83 insertions(+), 15 deletions(-)

diff --git a/activemodel/test/cases/type/date_time_test.rb b/activemodel/test/cases/type/date_time_test.rb
index e1f513cdca..db9b26f651 100644
--- a/activemodel/test/cases/type/date_time_test.rb
+++ b/activemodel/test/cases/type/date_time_test.rb
@@ -37,6 +37,14 @@ def test_hash_with_wrong_keys
         assert_equal "Provided hash #{{ a: 1 }} doesn't contain necessary keys: [1, 2, 3]", error.message
       end
 
+      test "casting with precision keeps the offset of a time with a zone object in a repeated hour" do
+        type = Type::DateTime.new(precision: 3)
+        zone = TZInfo::Timezone.get("Europe/Berlin")
+        time = ::Time.utc(2026, 10, 25, 1, 30, 0, 123456.789r).getlocal(zone) # 2026-10-25 02:30:00.123456789 +0100
+
+        assert_equal ::Time.utc(2026, 10, 25, 1, 30, 0, 123000), type.cast(time)
+      end
+
       test "serialize_cast_value is equivalent to serialize after cast" do
         type = Type::DateTime.new(precision: 1)
         value = type.cast("1999-12-31 12:34:56.789 -1000")
diff --git a/activesupport/CHANGELOG.md b/activesupport/CHANGELOG.md
index edf224874d..a33c327781 100644
--- a/activesupport/CHANGELOG.md
+++ b/activesupport/CHANGELOG.md
@@ -1,3 +1,17 @@
+*   Fix `Time#change` in the hour repeated when clocks are set back, for times
+    with a zone object.
+
+    With a `TZInfo::Timezone` zone and TZInfo's default ambiguity settings, or
+    with an `ActiveSupport::TimeZone` when both occurrences have the same DST
+    flag, it raised `TZInfo::AmbiguousTime`, also from Active Model's datetime
+    cast when precision truncation is needed. Where the zone picks the other
+    occurrence of the hour, as `ActiveSupport::TimeZone` does for Europe/Dublin,
+    whose winter time counts as DST, it moved the time by an hour. It now keeps
+    the time's UTC offset when the new local time can have it. When neither
+    occurrence has the original offset, the zone picks as before.
+
+    *Thomas Klemm*
+
 *   `ActiveSupport::MessagePack` no longer deserializes an unsafe
     `ActiveSupport::SafeBuffer` as `html_safe`.
 
diff --git a/activesupport/lib/active_support/core_ext/time/calculations.rb b/activesupport/lib/active_support/core_ext/time/calculations.rb
index 885573ac10..291ec3861b 100644
--- a/activesupport/lib/active_support/core_ext/time/calculations.rb
+++ b/activesupport/lib/active_support/core_ext/time/calculations.rb
@@ -172,22 +172,15 @@ def change(options)
     elsif utc?
       ::Time.utc(new_year, new_month, new_day, new_hour, new_min, new_sec)
     elsif zone.respond_to?(:utc_to_local)
-      new_time = ::Time.new(new_year, new_month, new_day, new_hour, new_min, new_sec, zone)
-
-      # When there are two occurrences of a nominal time due to DST ending,
-      # `Time.new` chooses the first chronological occurrence (the one with a
-      # larger UTC offset). However, for `change`, we want to choose the
-      # occurrence that matches this time's UTC offset.
-      #
-      # If the new time's UTC offset is larger than this time's UTC offset, the
-      # new time might be a first chronological occurrence. So we add the offset
-      # difference to fast-forward the new time, and check if the result has the
-      # desired UTC offset (i.e. is the second chronological occurrence).
-      offset_difference = new_time.utc_offset - utc_offset
-      if offset_difference > 0 && (new_time_2 = new_time + offset_difference).utc_offset == utc_offset
-        new_time_2
-      else
+      # Read the new local time at this time's UTC offset. If the zone gives
+      # that instant the same offset, it is the new local time, and when a
+      # local time occurs twice because clocks were set back, it is the
+      # occurrence that matches this time.
+      new_time = (::Time.utc(new_year, new_month, new_day, new_hour, new_min, new_sec) - utc_offset).getlocal(zone)
+      if new_time.utc_offset == utc_offset
         new_time
+      else
+        ::Time.new(new_year, new_month, new_day, new_hour, new_min, new_sec, zone)
       end
     elsif zone
       ::Time.local(new_sec, new_min, new_hour, new_day, new_month, new_year, nil, nil, isdst, nil)
diff --git a/activesupport/test/core_ext/time_ext_test.rb b/activesupport/test/core_ext/time_ext_test.rb
index 6854cd305d..82a9d55d0e 100644
--- a/activesupport/test/core_ext/time_ext_test.rb
+++ b/activesupport/test/core_ext/time_ext_test.rb
@@ -519,6 +519,59 @@ def test_change_preserves_offset_for_zoned_times_around_end_of_dst
     end
   end
 
+  def test_change_preserves_offset_for_zoned_times_around_end_of_negative_dst
+    with_tz_default "Europe/Dublin" do
+      # Irish Standard Time (+0100) ended just before 2026-10-25 2:00:00 AM,
+      # and clocks were rolled back 1 hour. In tzdata, Ireland's winter time
+      # (GMT, +0000) counts as DST and Irish Standard Time as standard time.
+      one_am_1 = Time.utc(2026, 10, 25, 00, 00, 00).getlocal(Time.zone) # 2026-10-25 01:00:00 +0100
+      one_am_2 = Time.utc(2026, 10, 25, 01, 00, 00).getlocal(Time.zone) # 2026-10-25 01:00:00 +0000
+
+      assert_equal one_am_1, one_am_1.change(min: 0)
+      assert_equal one_am_1 + 1, one_am_1.change(sec: 1)
+      assert_equal one_am_2, one_am_2.change(min: 0)
+      assert_equal one_am_2 + 1, one_am_2.change(sec: 1)
+    end
+  end
+
+  def test_change_preserves_offset_for_times_with_a_tzinfo_zone_around_end_of_dst
+    zone = TZInfo::Timezone.get("Europe/Berlin")
+    # DST ended just before 2026-10-25 3:00:00 AM in Europe/Berlin, and clocks
+    # were rolled back 1 hour.
+    midnight   = Time.utc(2026, 10, 24, 22, 00, 00).getlocal(zone) # 2026-10-25 00:00:00 +0200
+    two_am_1   = Time.utc(2026, 10, 25, 00, 00, 00).getlocal(zone) # 2026-10-25 02:00:00 +0200
+    two_am_2   = Time.utc(2026, 10, 25, 01, 00, 00).getlocal(zone) # 2026-10-25 02:00:00 +0100
+    three_am   = Time.utc(2026, 10, 25, 02, 00, 00).getlocal(zone) # 2026-10-25 03:00:00 +0100
+
+    assert_equal two_am_1, midnight.change(hour: 2)
+    assert_equal two_am_1 + 1, two_am_1.change(sec: 1)
+    assert_equal two_am_2 + 1, two_am_2.change(sec: 1)
+    assert_equal two_am_2, three_am.change(hour: 2)
+  end
+
+  def test_change_preserves_offset_for_zoned_times_in_an_hour_repeated_without_a_dst_change
+    with_tz_default "Moscow" do
+      # On 2014-10-26 Moscow moved from +0400 to +0300, both standard time, so
+      # 1:00 AM to 2:00 AM occurred twice.
+      one_thirty_1 = Time.utc(2014, 10, 25, 21, 30, 00).getlocal(Time.zone) # 2014-10-26 01:30:00 +0400
+      one_thirty_2 = Time.utc(2014, 10, 25, 22, 30, 00).getlocal(Time.zone) # 2014-10-26 01:30:00 +0300
+
+      assert_equal one_thirty_1, one_thirty_1.change(sec: 0)
+      assert_equal one_thirty_2, one_thirty_2.change(sec: 0)
+    end
+  end
+
+  def test_change_nsec_preserves_offset_and_fraction_for_times_with_a_tzinfo_zone_around_end_of_dst
+    zone = TZInfo::Timezone.get("Europe/Berlin")
+    time = Time.utc(2026, 10, 25, 01, 30, 00, 123456.789r).getlocal(zone) # 2026-10-25 02:30:00.123456789 +0100
+
+    changed = time.change(nsec: 123456000)
+
+    assert_equal 123456000, changed.nsec
+    assert_equal Time.utc(2026, 10, 25, 01, 30, 00, 123456), changed
+    assert_same zone, changed.zone
+  end
+
   def test_change_preserves_fractional_seconds_on_zoned_time
     with_tz_default "US/Eastern" do
       time = Time.new(2005, 10, 30, 00, 00, 0.99r, Time.zone) + 0

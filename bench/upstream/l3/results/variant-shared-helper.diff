@@ -489,6 +499,18 @@ def materialize
         end
       end
 
+      #: () { (ActiveModel::Attribute) -> untyped } -> Hash[String, untyped]
+      def transform_attributes
+        materialize
+        hash = {}
+        indexes.each_key do |name|
+          if attribute = lookup(index_for_name(name))
+            hash[name] = yield attribute
+          end
+        end
+        hash
+      end
